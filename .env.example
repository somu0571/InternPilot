# =================================================================
# InternPilot - Environment Variables Template
# Copy this file to .env and replace placeholder values with your own.
# =================================================================

# -----------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------
# Port number for Express HTTP server (Default: 8080)
PORT=8080

# Environment mode: 'development' or 'production' (Default: development)
NODE_ENV=development

# -----------------------------------------------------------------
# 2. Database Configuration (REQUIRED)
# -----------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas or local MongoDB instance)
# Note: Application fails to start if this URI is missing or invalid.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-url>/internpilot?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 3. Security & Session Secrets
# -----------------------------------------------------------------
# Secret key used for encrypting Express session cookies
SESSION_SECRET=your_super_secret_session_key_here

# Secret passphrase required to register an account with the 'Admin' role
ADMIN_SECRET=SUPER_SECRET_ADMIN_KEY_123

# -----------------------------------------------------------------
# 4. Email Service (Nodemailer / OTP Verification)
# -----------------------------------------------------------------
# Email provider service (Default: gmail)
EMAIL_SERVICE=gmail

# SMTP sender email address (e.g., your Google Workspace or Gmail address)
EMAIL_USER=your_email@gmail.com

# Gmail App Password (16-character token from Google Account > Security > App Passwords)
EMAIL_PASS=your_gmail_16_character_app_password

# -----------------------------------------------------------------
# 5. Google OAuth 2.0 (Optional - for Google Login)
# -----------------------------------------------------------------
# Obtain credentials from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# -----------------------------------------------------------------
# 6. Cloudinary (Optional - for Avatar & Resume Uploads)
# -----------------------------------------------------------------
# Obtain credentials from Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 7. Google Gemini AI (Optional - for AI Chat Assistant)
# -----------------------------------------------------------------
# Obtain API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
