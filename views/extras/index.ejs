    <style>
        /* Continuous background glow shift for AI gradient text */
        @keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .animate-gradient-text {
            background-size: 200% auto;
            animation: gradientShift 5s ease infinite;
        }

        /* Ambient background glow behind hero */
        .hero-glow {
            position: absolute;
            top: -10%;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 900px;
            height: 450px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, rgba(168, 85, 247, 0.10) 45%, transparent 70%);
            filter: blur(70px);
            pointer-events: none;
            z-index: 0;
        }

        /* Shimmer effect for skeleton loading state */
        @keyframes shimmer {
            0% {
                background-position: -200% 0;
            }

            100% {
                background-position: 200% 0;
            }
        }

        .skeleton-pulse {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 37%, #f1f5f9 63%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }

        /* Hero Graphic Floating Animation */
        @keyframes heroFloat {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
        .hero-graphic-float {
            animation: heroFloat 6s ease-in-out infinite;
        }
    </style>

