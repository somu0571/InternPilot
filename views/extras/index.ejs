    <!-- Scripts for Animations & Interactivity -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Initialize Animate On Scroll
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 600,
                    once: true,
                    easing: 'ease-out-cubic'
                });
            }

            // 2. Dynamic Landing Stats Fetch & Counter Animation
            const fetchLandingStats = async () => {
                const candidateCounter = document.getElementById('stat-candidates');
                const companyCounter = document.getElementById('stat-companies');
                const internshipCounter = document.getElementById('stat-internships');

                const candidateSkeleton = document.getElementById('skeleton-candidates');
                const companySkeleton = document.getElementById('skeleton-companies');
                const internshipSkeleton = document.getElementById('skeleton-internships');

                try {
                    const response = await fetch('/api/v1/analytics/landing-stats');
                    if (!response.ok) throw new Error('Failed to fetch landing stats');
                    const data = await response.json();

                    // Assign target values
                    if (candidateCounter) candidateCounter.setAttribute('data-target', data.candidates ?? 0);
                    if (companyCounter) companyCounter.setAttribute('data-target', data.companies ?? 0);
                    if (internshipCounter) internshipCounter.setAttribute('data-target', data.internships ?? 0);

                } catch (err) {
                    console.error('Error fetching landing stats:', err);
                    // Fallback to 0 if API request fails
                    if (candidateCounter) candidateCounter.setAttribute('data-target', '0');
                    if (companyCounter) companyCounter.setAttribute('data-target', '0');
                    if (internshipCounter) internshipCounter.setAttribute('data-target', '0');
                } finally {
                    // Hide skeleton placeholders and show metric counters smoothly
                    [candidateSkeleton, companySkeleton, internshipSkeleton].forEach(sk => sk && sk.classList.add('hidden'));
                    [candidateCounter, companyCounter, internshipCounter].forEach(cnt => cnt && cnt.classList.remove('hidden'));

                    // Initialize counter intersection observer
                    setupCounterObserver();
                }
            };

            let animationTriggered = false;
            const animateAllCounters = () => {
                if (animationTriggered) return;
                animationTriggered = true;

                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                const counters = document.querySelectorAll('.counter');

                counters.forEach(counter => {
                    const target = parseInt(counter.getAttribute('data-target') || '0', 10);
                    if (prefersReducedMotion || target === 0) {
                        counter.innerText = target.toLocaleString() + '+';
                        return;
                    }

                    let current = 0;
                    const duration = 1500; // Total animation duration in ms
                    const stepTime = 25;   // Frame step time in ms
                    const steps = duration / stepTime;
                    const increment = Math.max(1, Math.ceil(target / steps));

                    const timer = setInterval(() => {
                        current += increment;
                        if (current >= target) {
                            counter.innerText = target.toLocaleString() + '+';
                            clearInterval(timer);
                        } else {
                            counter.innerText = current.toLocaleString() + '+';
                        }
                    }, stepTime);
                });
            };

            const setupCounterObserver = () => {
                const statsSection = document.getElementById('stats-section');
                if (!statsSection) {
                    animateAllCounters();
                    return;
                }

                if ('IntersectionObserver' in window) {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                animateAllCounters();
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.2 });
                    observer.observe(statsSection);
                } else {
                    animateAllCounters();
                }
            };

            fetchLandingStats();

        });
    </script>
