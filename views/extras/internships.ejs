    <script>
        function openModal() {
            document.getElementById('postingModal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('postingModal').classList.add('hidden');
        }

        function openEditModal(button) {
            try {
                const item = JSON.parse(button.getAttribute('data-item'));
                document.getElementById('editForm').action = '/internships/' + item._id + '/edit';
                document.getElementById('edit_title').value = item.title || '';
                document.getElementById('edit_company').value = item.companyName || item.company || '';
                document.getElementById('edit_sector').value = item.sector || '';

                let locStr = '';
                if (typeof item.location === 'object' && item.location !== null) {
                    locStr = (item.location.district || '') + (item.location.state ? ', ' + item.location.state : '');
                } else {
                    locStr = item.location || '';
                }
                document.getElementById('edit_location').value = locStr;

                document.getElementById('edit_vacancies').value = item.vacancies || 1;
                document.getElementById('edit_stipend').value = item.monthlyStipend || 5000;
                document.getElementById('edit_duration').value = item.duration || '12 Months';
                document.getElementById('edit_minQualifications').value = item.minQualifications || item.minQualification || '';
                document.getElementById('edit_skills').value = Array.isArray(item.requiredSkills) ? item.requiredSkills.join(', ') : '';

                if (item.applicationDeadline) {
                    const dateObj = new Date(item.applicationDeadline);
                    if (!isNaN(dateObj.getTime())) {
                        document.getElementById('edit_deadline').value = dateObj.toISOString().split('T')[0];
                    } else {
                        document.getElementById('edit_deadline').value = '';
                    }
                } else {
                    document.getElementById('edit_deadline').value = '';
                }

                const questionBuilder = document.querySelector('#editForm [data-application-question-builder]');
                if (questionBuilder && typeof questionBuilder.__setApplicationQuestions === 'function') {
                    questionBuilder.__setApplicationQuestions(item.applicationQuestions || []);
                }

                document.getElementById('editModal').classList.remove('hidden');
            } catch (err) {
                console.error('Error parsing item data:', err);
            }
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Bookmark Toggle Logic
        document.addEventListener('DOMContentLoaded', () => {
            const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
            bookmarkBtns.forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const icon = btn.querySelector('i');
                    const internshipId = btn.getAttribute('data-id');
                    
                    // Optimistic UI update for sleek feel
                    const isCurrentlySaved = icon.classList.contains('ph-fill');
                    if (isCurrentlySaved) {
                        icon.classList.remove('ph-fill', 'text-indigo-600');
                        icon.classList.add('ph-bold');
                    } else {
                        icon.classList.remove('ph-bold');
                        icon.classList.add('ph-fill', 'text-indigo-600');
                    }
                    
                    try {
                        const response = await fetch(`/candidate/saved-internships/${internshipId}/toggle`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await response.json();
                        if (!data.success) {
                            // Revert on failure
                            if (isCurrentlySaved) {
                                icon.classList.remove('ph-bold');
                                icon.classList.add('ph-fill', 'text-indigo-600');
                            } else {
                                icon.classList.remove('ph-fill', 'text-indigo-600');
                                icon.classList.add('ph-bold');
                            }
                            alert('Failed to save internship. Please try again.');
                        }
                    } catch (err) {
                        console.error(err);
                        // Revert on error
                        if (isCurrentlySaved) {
                            icon.classList.remove('ph-bold');
                            icon.classList.add('ph-fill', 'text-indigo-600');
                        } else {
                            icon.classList.remove('ph-fill', 'text-indigo-600');
                            icon.classList.add('ph-bold');
                        }
                    }
                });
            });
        });
    </script>

    <!-- Compare Action Bar -->
    <div id="compareBar" class="fixed bottom-0 left-0 right-0 bg-white border-t border-indigo-100 shadow-[0_-4px_20px_-5px_rgba(0,0,0,0.1)] p-4 flex justify-between items-center z-50 transform translate-y-full transition-transform duration-300">
        <div class="flex items-center gap-4 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 justify-between">
            <div class="text-sm font-semibold text-slate-700">
                <span id="compareCount" class="bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full mr-1.5">0</span> 
                <span class="hidden sm:inline">internships selected (Max 3)</span>
                <span class="sm:hidden">selected</span>
            </div>
            <div class="flex gap-3">
                <button id="clearCompareBtn" class="text-slate-500 text-sm hover:text-slate-800 transition-colors cursor-pointer font-medium px-2 py-2">Clear</button>
                <button id="compareSubmitBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg text-sm font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer shadow-sm">
                    Compare
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const checkboxes = document.querySelectorAll('.compare-checkbox');
            const compareBar = document.getElementById('compareBar');
            const compareCount = document.getElementById('compareCount');
            const clearCompareBtn = document.getElementById('clearCompareBtn');
            const compareSubmitBtn = document.getElementById('compareSubmitBtn');
            
            let selectedIds = new Set();

            function updateUI() {
                compareCount.textContent = selectedIds.size;
                
                if (selectedIds.size > 0) {
                    compareBar.classList.remove('translate-y-full');
                } else {
                    compareBar.classList.add('translate-y-full');
                }

                if (selectedIds.size >= 2) {
                    compareSubmitBtn.disabled = false;
                } else {
                    compareSubmitBtn.disabled = true;
                }
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', (e) => {
                    if (e.target.checked) {
                        if (selectedIds.size >= 3) {
                            alert("You can only compare up to 3 internships at a time.");
                            e.target.checked = false;
                            return;
                        }
                        selectedIds.add(e.target.value);
                    } else {
                        selectedIds.delete(e.target.value);
                    }
                    updateUI();
                });
            });

            clearCompareBtn.addEventListener('click', () => {
                selectedIds.clear();
                checkboxes.forEach(cb => cb.checked = false);
                updateUI();
            });

            compareSubmitBtn.addEventListener('click', () => {
                if (selectedIds.size >= 2 && selectedIds.size <= 3) {
                    const ids = Array.from(selectedIds).join(',');
                    window.location.href = `/internships/compare?ids=${ids}`;
                }
            });
        });
    </script>
