<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto space-y-6 pb-12">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/internships" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1">
                    <i class="ph-bold ph-arrow-left"></i> Browse Listings
                </a>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs font-medium text-slate-500">Application Management</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                My Applications
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Track your active internship applications, interview progress, and manage your submissions.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/internships"
                class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl shadow-sm transition-all hover:shadow-indigo-200">
                <i class="ph-bold ph-magnifying-glass"></i>
                Find More Internships
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <% 
        const totalApps = Array.isArray(applications) ? applications.length : 0;
        const activeApps = Array.isArray(applications) ? applications.filter(a => ['Submitted', 'submitted', 'pending', 'Under Review', 'under_review', 'Shortlisted', 'shortlisted', 'Interview', 'interview'].includes(a.status)).length : 0;
        const withdrawnApps = Array.isArray(applications) ? applications.filter(a => ['Withdrawn', 'withdrawn'].includes(a.status)).length : 0;
    %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Total Submissions</span>
            <div class="text-2xl font-bold text-slate-900 mt-1"><%= totalApps %></div>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
            <span class="text-[11px] font-semibold text-emerald-600 uppercase tracking-wider block">Active / Under Review</span>
            <div class="text-2xl font-bold text-emerald-700 mt-1"><%= activeApps %></div>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider block">Withdrawn</span>
            <div class="text-2xl font-bold text-slate-600 mt-1"><%= withdrawnApps %></div>
        </div>
    </div>

    <!-- Empty State -->
    <% if (!applications || applications.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-xs">
            <div class="w-16 h-16 mx-auto mb-4 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center">
                <i class="ph-bold ph-paper-plane-tilt text-3xl"></i>
            </div>
            <h2 class="text-lg font-bold text-slate-800">No applications submitted yet</h2>
            <p class="text-xs text-slate-500 mt-1 mb-6 max-w-sm mx-auto">
                Explore curated opportunities under the PM Internship Scheme and submit your profile.
            </p>
            <a href="/internships"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition-colors shadow-sm">
                <i class="ph-bold ph-compass"></i> Explore Opportunities &rarr;
            </a>
        </div>
    <% } else { %>

        <!-- Applications List -->
        <div class="space-y-4">
            <% applications.forEach(app => { %>
                <% 
                    const isWithdrawn = ['Withdrawn', 'withdrawn'].includes(app.status);
                    const isRejected = ['Rejected', 'rejected'].includes(app.status);
                    const isHired = ['Hired', 'hired', 'Accepted', 'accepted'].includes(app.status);
                    const isOfferDeclined = ['Offer Declined', 'offer declined'].includes(app.status);
                    const canWithdraw = !isWithdrawn && !isRejected && !isHired && !isOfferDeclined;
                    const internshipTitle = (app.internship && app.internship.title) ? app.internship.title : 'Internship Posting';
                    const companyName = (app.internship && (app.internship.companyName || app.internship.company)) ? (app.internship.companyName || app.internship.company) : 'Company';
                    const statusUpdatedAt = app.statusUpdatedAt || app.appliedAt;
                    const relativeStatusUpdatedAt = typeof formatRelativeTime === 'function' ? formatRelativeTime(statusUpdatedAt) : '';
                    const localizedStatusUpdatedAt = typeof formatLocalizedDateTime === 'function' ? formatLocalizedDateTime(statusUpdatedAt) : '';
                %>

                <div class="bg-white border <%= isWithdrawn ? 'border-slate-200 bg-slate-50/60 opacity-90' : 'border-slate-200 hover:border-indigo-200' %> rounded-2xl p-5 sm:p-6 shadow-xs hover:shadow-sm transition-all flex flex-col md:flex-row md:items-center justify-between gap-6"
                    id="app-card-<%= app._id %>">

                    <!-- Left: Role & Company Details -->
                    <div class="space-y-2.5 max-w-xl">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full">
                                <%= (app.internship && app.internship.sector) ? app.internship.sector : 'General' %>
                            </span>
                            <span class="text-xs text-slate-300">&bull;</span>
                            <span class="text-xs text-slate-500 font-medium">
                                Applied <%= new Date(app.appliedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </span>

                            <% if (isWithdrawn && app.withdrawnAt) { %>
                                <span class="text-xs text-slate-300">&bull;</span>
                                <span class="text-xs text-rose-600 font-medium">
                                    Withdrawn <%= new Date(app.withdrawnAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </span>
                            <% } %>
                        </div>

                        <div>
                            <h2 class="text-lg font-bold text-slate-900 leading-snug <%= isWithdrawn ? 'line-through text-slate-500' : '' %>">
                                <%= internshipTitle %>
                            </h2>
                            <p class="text-xs font-semibold text-slate-600 flex items-center gap-1.5 mt-0.5">
                                <i class="ph-bold ph-buildings text-slate-400"></i>
                                <%= companyName %>
                            </p>
                        </div>

                        <% if (app.internship) { %>
                            <div class="flex items-center gap-4 text-xs text-slate-500 pt-1 flex-wrap">
                                <span class="flex items-center gap-1">
                                    <i class="ph-bold ph-map-pin text-rose-500"></i>
                                    <%= typeof app.internship.location === 'object' && app.internship.location !== null
                                        ? ((app.internship.location.district ? app.internship.location.district + ', ' : '') + (app.internship.location.state || ''))
                                        : (app.internship.location || 'Remote') %>
                                </span>
                                <span>&bull;</span>
                                <span class="flex items-center gap-1 text-emerald-600 font-semibold">
                                    <i class="ph-bold ph-currency-inr"></i>
                                    ₹<%= app.internship.monthlyStipend ? Number(app.internship.monthlyStipend).toLocaleString('en-IN') : '5,000' %>/mo
                                </span>
                            </div>
                        <% } %>

                        <% if (isWithdrawn && app.withdrawalReason) { %>
                            <div class="mt-2 text-xs bg-slate-100 border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg inline-block">
                                <span class="font-medium text-slate-700">Reason for withdrawal:</span> "<%= app.withdrawalReason %>"
                            </div>
                        <% } %>
                    </div>

                    <!-- Right: Status Badge & Actions -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between md:justify-end gap-4 pt-4 md:pt-0 border-t md:border-0 border-slate-100">

                        <!-- Status Badge Area -->
                        <div class="text-left sm:text-right">
                            <span class="block text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
                                Current Status
                            </span>

                            <% if (isWithdrawn) { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 bg-slate-100 border border-slate-300 px-3 py-1.5 rounded-lg shadow-2xs">
                                    <i class="ph-bold ph-arrow-u-up-left text-slate-500"></i>
                                    Withdrawn
                                </span>
                            <% } else if (app.status === 'Submitted' || app.status === 'submitted' || app.status === 'pending') { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                    Submitted
                                </span>
                            <% } else if (app.status === 'Under Review' || app.status === 'under_review') { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                                    Under Review
                                </span>
                            <% } else if (app.status === 'Shortlisted' || app.status === 'shortlisted') { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    Shortlisted
                                </span>
                            <% } else if (app.status === 'Interview' || app.status === 'interview') { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-indigo-800 bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                                    Interview
                                </span>
                            <% } else if (app.status === 'Hired' || app.status === 'hired') { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-800 bg-emerald-100 border border-emerald-300 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                                    Hired
                                </span>
                            <% } else if (isRejected) { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-rose-800 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                    Rejected
                                </span>
                            <% } else if (isOfferDeclined) { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-rose-800 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-lg">
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                    Offer Declined
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-lg">
                                    <%= app.status %>
                                </span>
                            <% } %>

                            <% if (relativeStatusUpdatedAt && localizedStatusUpdatedAt) { %>
                                <time datetime="<%= new Date(statusUpdatedAt).toISOString() %>"
                                    title="Last status update: <%= localizedStatusUpdatedAt %>"
                                    aria-label="Last status update: <%= localizedStatusUpdatedAt %>"
                                    class="mt-2 flex items-center sm:justify-end gap-1 text-[11px] font-medium text-slate-500">
                                    <i class="ph-bold ph-clock text-slate-400"></i>
                                    Updated <%= relativeStatusUpdatedAt %>
                                </time>
                            <% } %>
                        </div>

                        <!-- Action Button Area: Status-Dependent Rendering -->
                        <div class="flex items-center gap-2">
                            <% if (canWithdraw) { %>
                                <!-- Withdraw Button: Triggers Confirmation Modal -->
                                <button type="button"
                                    onclick="openWithdrawModal('<%= app._id %>', '<%= internshipTitle.replace(/'/g, '\\\'') %>', '<%= companyName.replace(/'/g, '\\\'') %>')"
                                    class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 hover:border-rose-300 rounded-xl transition-all shadow-2xs cursor-pointer"
                                    title="Withdraw this active application">
                                    <i class="ph-bold ph-x-circle text-sm"></i>
                                    Withdraw Application
                                </button>
                            <% } else if (isWithdrawn) { %>
                                <span class="text-xs text-slate-400 italic px-2">
                                    Application inactive
                                </span>
                            <% } else if (isRejected) { %>
                                <span class="text-xs text-slate-400 italic px-2">
                                    Position finalized
                                </span>
                            <% } else if (isOfferDeclined) { %>
                                <span class="text-xs text-slate-400 italic px-2">
                                    Offer declined
                                </span>
                            <% } %>

                            <% if (app.internship && app.internship._id) { %>
                                <a href="/internships/<%= app.internship._id %>"
                                    class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
                                    title="View listing details">
                                    <i class="ph-bold ph-arrow-square-out text-base"></i>
                                </a>
                            <% } %>
                        </div>

                    </div>

                </div>
            <% }) %>
        </div>
    <% } %>

</div>

<!-- TAILWIND CSS CONFIRMATION MODAL -->
<div id="withdrawConfirmationModal"
    class="fixed inset-0 z-50 hidden transition-opacity duration-200 ease-out"
    role="dialog"
    aria-modal="true"
    aria-labelledby="withdrawModalTitle">

    <!-- Backdrop overlay -->
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity"
        onclick="closeWithdrawModal()"></div>

    <!-- Modal Dialog Window -->
    <div class="fixed inset-0 z-10 flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
        <div class="relative bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 transform transition-all">

            <!-- Close icon button -->
            <button type="button"
                onclick="closeWithdrawModal()"
                class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1 rounded-lg transition-colors">
                <i class="ph-bold ph-x text-lg"></i>
            </button>

            <!-- Modal Header / Icon -->
            <div class="flex items-center gap-3.5 mb-4">
                <div class="w-12 h-12 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shrink-0">
                    <i class="ph-bold ph-warning-circle text-2xl"></i>
                </div>
                <div>
                    <h2 id="withdrawModalTitle" class="text-lg font-bold text-slate-900">
                        Withdraw Application?
                    </h2>
                    <p class="text-xs text-slate-500">
                        This action will mark your application as withdrawn.
                    </p>
                </div>
            </div>

            <!-- Context Info -->
            <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs space-y-1 mb-4">
                <div class="font-semibold text-slate-800" id="modalRoleName">Internship Title</div>
                <div class="text-slate-500 flex items-center gap-1">
                    <i class="ph-bold ph-buildings"></i> <span id="modalOrgName">Company Name</span>
                </div>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Are you sure you want to withdraw your application? The hiring team will be notified, and your profile will be removed from their active candidate pool. <strong>This action cannot be undone.</strong>
            </p>

            <!-- Form -->
            <form id="withdrawApplicationForm" method="POST" action="">
                <!-- Reason Selection -->
                <div class="mb-5 space-y-1.5">
                    <label for="withdrawalReasonSelect" class="block text-xs font-semibold text-slate-700">
                        Reason for Withdrawal <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <select id="withdrawalReasonSelect" name="reason"
                        class="w-full text-xs border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-rose-500 bg-white text-slate-700">
                        <option value="Accepted another offer">Accepted another offer</option>
                        <option value="Schedule or timing conflict">Schedule or timing conflict</option>
                        <option value="Location/commute constraints">Location or commute constraints</option>
                        <option value="Applied by mistake">Applied by mistake</option>
                        <option value="Other">Other personal reasons</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
                    <button type="button"
                        onclick="closeWithdrawModal()"
                        class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition-colors">
                        Keep Application
                    </button>
                    <button type="submit"
                        id="confirmWithdrawSubmitBtn"
                        class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-xl transition-all shadow-sm shadow-rose-200 flex items-center gap-1.5">
                        <i class="ph-bold ph-trash text-sm"></i>
                        Confirm Withdrawal
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- CLIENT JAVASCRIPT LOGIC FOR CONFIRMATION MODAL -->
<script>
    const withdrawModal = document.getElementById('withdrawConfirmationModal');
    const withdrawForm = document.getElementById('withdrawApplicationForm');
    const modalRoleName = document.getElementById('modalRoleName');
    const modalOrgName = document.getElementById('modalOrgName');

    /**
     * Opens the modal dialog and populates dynamic application data
     */
    function openWithdrawModal(applicationId, roleTitle, companyName) {
        if (!withdrawModal || !withdrawForm) return;

        // Set action route for the form
        withdrawForm.action = `/candidate/applications/${applicationId}/withdraw`;

        // Update text labels in modal context preview
        if (modalRoleName) modalRoleName.textContent = roleTitle || 'Internship';
        if (modalOrgName) modalOrgName.textContent = companyName || 'Company';

        // Show modal
        withdrawModal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    /**
     * Closes the confirmation modal
     */
    function closeWithdrawModal() {
        if (!withdrawModal) return;
        withdrawModal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // Dismiss on Escape key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && withdrawModal && !withdrawModal.classList.contains('hidden')) {
            closeWithdrawModal();
        }
    });
</script>
