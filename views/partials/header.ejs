<% const navPrefixes={ home: ['/'], opportunities: ['/internships'], candidateProfile:
    ['/candidate/profile', '/candidate/resume-builder' ], applications:
    ['/candidate/applications', '/candidate/my-applications' ], certificates: ['/candidate/certificates'],
    savedInternships: ['/candidate/saved-internships'], savedSearches: ['/candidate/saved-searches'], recommendations:
    ['/recommendations'], interview: ['/interview'], problems: ['/problems'], notifications: ['/notifications'],
    companyNotifications: ['/company/notifications'], companyDashboard: [ '/company/dashboard' , '/company/internships'
    , '/company/applications' ], companyProfile: ['/company/profile'], manageTeam: ['/company/team'], activityHistory:
    ['/company/activity'], adminDashboard: ['/admin'] }; const activePath=typeof currentPath==='string' ? currentPath
    : '/' ; const normalizePath=value=> {
    const path =
    String(value || '/').split(/[?#]/, 1)[0] || '/';

    const withLeadingSlash =
    path.startsWith('/')
    ? path
    : `/${path}`;

    return withLeadingSlash === '/'
    ? '/'
    : withLeadingSlash.replace(/\/+$/, '');
    };

    const fallbackNavigation = Object.fromEntries(
    Object.entries(navPrefixes).map(([name, prefixes]) => [
    name,
    prefixes.some(prefix => {
    const normalizedPath =
    normalizePath(activePath);

    const normalizedPrefix =
    normalizePath(prefix);

    return normalizedPrefix === '/'
    ? normalizedPath === '/'
    : normalizedPath === normalizedPrefix ||
    normalizedPath.startsWith(
    `${normalizedPrefix}/`
    );
    })
    ])
    );

    const navigationState =
    typeof navigation !== 'undefined' && navigation
    ? navigation
    : fallbackNavigation;

    const isActive = name =>
    Boolean(navigationState[name]);

    const ariaCurrent = active =>
    active
    ? 'aria-current="page"'
    : '';

    const desktopLinkClass = active => [
    'nav-link inline-flex items-center border-b-2',
    'px-2.5 py-1.5 text-xs whitespace-nowrap',
    'transition-colors',
    'focus-visible:outline-none',
    'focus-visible:ring-2',
    'focus-visible:ring-indigo-600',
    'focus-visible:ring-offset-2',
    active
    ? 'border-indigo-700 bg-indigo-50 text-indigo-900 font-bold'
    : 'border-transparent text-slate-600 font-semibold hover:border-indigo-300 hover:text-indigo-700'
    ].join(' ');

    const mobileLinkClass = active => [
    'nav-link block rounded-lg border-l-4',
    'px-3 py-2.5 text-sm transition-colors',
    'focus-visible:outline-none',
    'focus-visible:ring-2',
    'focus-visible:ring-indigo-600',
    'focus-visible:ring-offset-2',
    active
    ? 'border-indigo-700 bg-indigo-50 text-indigo-900 font-bold'
    : 'border-transparent text-slate-600 font-semibold hover:bg-slate-100 hover:text-indigo-700'
    ].join(' ');

    const navPrefixAttribute = name =>
    navPrefixes[name].join('|');
    %>


    <!-- ===================================================== -->
    <!-- TOP TRICOLOR BORDER                                   -->
    <!-- ===================================================== -->

    <div class="h-1.5 w-full bg-gradient-to-r from-orange-500 via-white to-emerald-600"></div>


    <!-- ===================================================== -->
    <!-- HEADER                                                -->
    <!-- ===================================================== -->

    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white shadow-sm">

        <!--
        IMPORTANT:
        No max-w-7xl here.
        Header now uses the complete available width.
    -->

        <div class="w-full px-5 sm:px-7 lg:px-8 xl:px-10">

            <div class="flex h-20 w-full items-center justify-between gap-3 xl:gap-5">


                <!-- ================================================= -->
                <!-- LEFT: GOVERNMENT EMBLEM + INTERNPILOT              -->
                <!-- ================================================= -->

                <div class="flex shrink-0 items-center gap-3">

                    <!-- Government Emblem -->

                    <div class="flex shrink-0 items-center">

                        <img src="/images/emblem.jpg" alt="State Emblem of India"
                            class="h-10 w-auto object-contain mix-blend-multiply sm:h-12">

                    </div>


                    <!-- Divider -->

                    <div class="hidden h-10 w-px bg-slate-200 sm:block">
                    </div>


                    <!-- Brand -->

                    <div class="flex flex-col">

                        <a href="/"
                            class="text-xl font-bold tracking-tight text-slate-900 transition-colors hover:text-indigo-700">

                            InternPilot

                        </a>


                        <div class="hidden items-center gap-1.5 sm:flex">

                            <span
                                class="rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-700">

                                PMIS

                            </span>


                            <p class="whitespace-nowrap text-[11px] font-medium text-slate-500">

                                Prime Minister's Internship Scheme Portal

                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- RIGHT SIDE                                         -->
                <!-- ================================================= -->

                <div class="flex min-w-0 flex-1 items-center justify-end gap-1 sm:gap-2 xl:gap-3">


                    <!-- ================================================= -->
                    <!-- DESKTOP NAVIGATION                                -->
                    <!-- ================================================= -->

                    <nav aria-label="Primary navigation"
                        class="hidden min-w-0 items-center justify-end gap-0.5 xl:flex">


                        <!-- HOME -->

                        <a href="/" data-nav-link data-nav-variant="desktop"
                            data-nav-prefixes="<%= navPrefixAttribute('home') %>"
                            class="<%= desktopLinkClass(isActive('home')) %>" <%- ariaCurrent(isActive('home')) %>>

                            Home

                        </a>


                        <!-- OPPORTUNITIES -->

                        <a href="/internships" data-nav-link data-nav-variant="desktop"
                            data-nav-prefixes="<%= navPrefixAttribute('opportunities') %>"
                            class="<%= desktopLinkClass(isActive('opportunities')) %>" <%-
                            ariaCurrent(isActive('opportunities')) %>>

                            Opportunities

                        </a>


                        <% if (currentUser) { %>


                            <!-- ================================================= -->
                            <!-- CANDIDATE NAVIGATION                               -->
                            <!-- ================================================= -->

                            <% if (currentUser.role==='candidate' ) { %>


                                <!-- Candidate Profile -->

                                <a href="/candidate/profile" data-nav-link data-nav-variant="desktop"
                                    data-nav-prefixes="<%= navPrefixAttribute('candidateProfile') %>"
                                    class="<%= desktopLinkClass(isActive('candidateProfile')) %>" <%-
                                    ariaCurrent(isActive('candidateProfile')) %>>

                                    Candidate Profile

                                </a>


                                <!-- My Applications -->

                                <a href="/candidate/applications" data-nav-link data-nav-variant="desktop"
                                    data-nav-prefixes="<%= navPrefixAttribute('applications') %>"
                                    class="<%= desktopLinkClass(isActive('applications')) %>" <%-
                                    ariaCurrent(isActive('applications')) %>>

                                    My Applications

                                </a>


                                <!-- Certificates -->

                                <a href="/candidate/certificates" data-nav-link data-nav-variant="desktop"
                                    data-nav-prefixes="<%= navPrefixAttribute('certificates') %>"
                                    class="<%= desktopLinkClass(isActive('certificates')) %>" <%-
                                    ariaCurrent(isActive('certificates')) %>>

                                    Certificates

                                </a>


                                <!-- Recommendations -->

                                <a href="/recommendations/<%= currentUser._id %>" data-nav-link
                                    data-nav-variant="desktop"
                                    data-nav-prefixes="<%= navPrefixAttribute('recommendations') %>"
                                    class="<%= desktopLinkClass(isActive('recommendations')) %>" <%-
                                    ariaCurrent(isActive('recommendations')) %>>

                                    Recommendations

                                </a>


                                <!-- ================================================= -->
                                <!-- PREPARE DROPDOWN                                 -->
                                <!-- ================================================= -->

                                <div class="ip-dropdown relative inline-block">

                                    <button type="button" class="ip-dropdown__trigger flex items-center gap-1 rounded-lg px-2.5 py-2 text-sm font-semibold whitespace-nowrap transition-colors cursor-pointer
                                    <%= isActive('interview') || isActive('problems')
                                        ? 'bg-indigo-100 text-indigo-700'
                                        : 'text-slate-600 hover:bg-slate-50 hover:text-indigo-600' %>"
                                        aria-expanded="false" aria-haspopup="true">

                                        Prepare

                                        <i class="ph-bold ph-caret-down text-xs transition-transform"
                                            aria-hidden="true">
                                        </i>

                                    </button>


                                    <div class="ip-dropdown__panel absolute left-0 top-full z-50 hidden w-48 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg pt-1"
                                        role="menu">


                                        <!-- Mock Interviews -->

                                        <a href="/interview" role="menuitem" data-nav-link data-nav-variant="desktop"
                                            data-nav-prefixes="<%= navPrefixAttribute('interview') %>"
                                            class="block px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600 <%= isActive('interview') ? 'bg-indigo-50 font-bold text-indigo-700' : '' %>"
                                            <%- ariaCurrent(isActive('interview')) %>>

                                            Mock Interviews

                                        </a>


                                        <!-- Problem Generator -->

                                        <a href="/problems" role="menuitem" data-nav-link data-nav-variant="desktop"
                                            data-nav-prefixes="<%= navPrefixAttribute('problems') %>"
                                            class="block border-t border-slate-100 px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600 <%= isActive('problems') ? 'bg-indigo-50 font-bold text-indigo-700' : '' %>"
                                            <%- ariaCurrent(isActive('problems')) %>>

                                            Problem Generator

                                        </a>

                                    </div>

                                </div>


                                <!-- ================================================= -->
                                <!-- COMPANY / RECRUITER                              -->
                                <!-- ================================================= -->

                                <% } else if ( ['company', 'recruiter' , 'hiring_manager' ] .includes(currentUser.role)
                                    ) { %>


                                    <!-- Company Dashboard -->

                                    <a href="/company/dashboard" data-nav-link data-nav-variant="desktop"
                                        data-nav-prefixes="<%= navPrefixAttribute('companyDashboard') %>"
                                        class="<%= desktopLinkClass(isActive('companyDashboard')) %>" <%-
                                        ariaCurrent(isActive('companyDashboard')) %>>

                                        Company Dashboard

                                    </a>


                                    <% if ( ['company', 'recruiter' ] .includes(currentUser.role) ) { %>


                                        <!-- Manage Dropdown -->

                                        <div class="ip-dropdown relative inline-block">

                                            <button type="button" class="ip-dropdown__trigger flex items-center gap-1 rounded-lg px-2.5 py-2 text-sm font-semibold whitespace-nowrap transition-colors cursor-pointer
                                        <%= isActive('companyProfile') ||
                                           isActive('manageTeam') ||
                                           isActive('activityHistory')
                                            ? 'bg-indigo-100 text-indigo-700'
                                            : 'text-slate-600 hover:bg-slate-50 hover:text-indigo-600' %>"
                                                aria-expanded="false" aria-haspopup="true">

                                                Manage

                                                <i class="ph-bold ph-caret-down text-xs transition-transform"
                                                    aria-hidden="true">
                                                </i>

                                            </button>


                                            <div class="ip-dropdown__panel absolute left-0 top-full z-50 hidden w-48 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg pt-1"
                                                role="menu">


                                                <!-- Company Profile -->

                                                <a href="/company/profile" role="menuitem" data-nav-link
                                                    data-nav-variant="desktop"
                                                    data-nav-prefixes="<%= navPrefixAttribute('companyProfile') %>"
                                                    class="block px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600 <%= isActive('companyProfile') ? 'bg-indigo-50 font-bold text-indigo-700' : '' %>"
                                                    <%- ariaCurrent(isActive('companyProfile')) %>>

                                                    Company Profile

                                                </a>


                                                <% if (currentUser.role==='company' ) { %>


                                                    <!-- Manage Team -->

                                                    <a href="/company/team" role="menuitem" data-nav-link
                                                        data-nav-variant="desktop"
                                                        data-nav-prefixes="<%= navPrefixAttribute('manageTeam') %>"
                                                        class="block border-t border-slate-100 px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600 <%= isActive('manageTeam') ? 'bg-indigo-50 font-bold text-indigo-700' : '' %>"
                                                        <%- ariaCurrent(isActive('manageTeam')) %>>

                                                        Manage Team

                                                    </a>


                                                    <!-- Activity History -->

                                                    <a href="/company/activity" role="menuitem" data-nav-link
                                                        data-nav-variant="desktop"
                                                        data-nav-prefixes="<%= navPrefixAttribute('activityHistory') %>"
                                                        class="block border-t border-slate-100 px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600 <%= isActive('activityHistory') ? 'bg-indigo-50 font-bold text-indigo-700' : '' %>"
                                                        <%- ariaCurrent(isActive('activityHistory')) %>>

                                                        Activity History

                                                    </a>

                                                    <% } %>

                                            </div>

                                        </div>

                                        <% } %>


                                            <!-- ================================================= -->
                                            <!-- ADMIN -->
                                            <!-- ================================================= -->

                                            <% } else if (currentUser.role==='admin' ) { %>


                                                <a href="/admin/dashboard" data-nav-link data-nav-variant="desktop"
                                                    data-nav-prefixes="<%= navPrefixAttribute('adminDashboard') %>"
                                                    class="<%= desktopLinkClass(isActive('adminDashboard')) %>" <%-
                                                    ariaCurrent(isActive('adminDashboard')) %>>

                                                    Admin Dashboard

                                                </a>


                                                <% } %>

                                                    <% } %>

                    </nav>


                    <!-- ================================================= -->
                    <!-- DESKTOP DIVIDER                                   -->
                    <!-- ================================================= -->

                    <div class="hidden h-8 w-px bg-slate-200 xl:block">
                    </div>


                    <!-- ================================================= -->
                    <!-- MOBILE MENU BUTTON                                -->
                    <!-- ================================================= -->

                    <button id="mobileNavToggle" type="button"
                        class="inline-flex shrink-0 items-center justify-center rounded-lg p-2 text-slate-700 transition-colors hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 xl:hidden"
                        aria-controls="mobileNavigation" aria-expanded="false">

                        <i id="mobileNavIcon" class="ph-bold ph-list text-xl" aria-hidden="true">
                        </i>

                        <span id="mobileNavToggleLabel" class="sr-only">

                            Open navigation menu

                        </span>

                    </button>


                    <!-- ================================================= -->
                    <!-- ACTION ICONS                                      -->
                    <!-- ================================================= -->

                    <% const hasActionIcons=currentUser && ( ['candidate', 'company' , 'recruiter' ]
                        .includes(currentUser.role) || typeof messageUnreadCount !=='undefined' ); %>


                        <% if (hasActionIcons) { %>


                            <div class="flex shrink-0 items-center gap-0.5 sm:gap-1">


                                <% if ( currentUser && ['candidate', 'company' , 'recruiter' ]
                                    .includes(currentUser.role) ) { %>


                                    <% if (currentUser.role==='candidate' ) { %>


                                        <!-- Saved Internships -->

                                        <a href="/candidate/saved-internships" aria-label="Saved Internships"
                                            data-nav-link data-nav-variant="icon"
                                            data-nav-prefixes="<%= navPrefixAttribute('savedInternships') %>"
                                            class="relative inline-flex items-center justify-center rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 <%= isActive('savedInternships') ? 'bg-indigo-100 font-bold text-indigo-900 ring-1 ring-indigo-700' : '' %>"
                                            <%- ariaCurrent(isActive('savedInternships')) %>
                                            title="Saved Internships">

                                            <i class="ph-bold ph-bookmark-simple text-lg" aria-hidden="true">
                                            </i>


                                            <% if ( currentUser.savedInternships && currentUser.savedInternships.length>
                                                0
                                                ) { %>

                                                <span
                                                    class="absolute -right-0.5 -top-0.5 h-4 min-w-4 rounded-full bg-indigo-600 px-1 text-center text-[9px] font-bold leading-4 text-white">

                                                    <%= currentUser.savedInternships.length> 99
                                                        ? '99+'
                                                        : currentUser.savedInternships.length %>

                                                </span>

                                                <% } %>

                                        </a>


                                        <!-- Saved Searches -->

                                        <a href="/candidate/saved-searches" aria-label="Saved Searches" data-nav-link
                                            data-nav-variant="icon"
                                            data-nav-prefixes="<%= navPrefixAttribute('savedSearches') %>"
                                            class="relative inline-flex items-center justify-center rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 <%= isActive('savedSearches') ? 'bg-indigo-100 font-bold text-indigo-900 ring-1 ring-indigo-700' : '' %>"
                                            <%- ariaCurrent(isActive('savedSearches')) %>
                                            title="Saved Searches">

                                            <i class="ph-bold ph-funnel-simple text-lg" aria-hidden="true">
                                            </i>

                                        </a>


                                        <% } %>


                                            <!-- Notifications -->

                                            <% const notifLink=currentUser.role==='candidate' ? '/notifications'
                                                : '/company/notifications' ; const
                                                notificationSection=currentUser.role==='candidate' ? 'notifications'
                                                : 'companyNotifications' ; %>


                                                <a href="<%= notifLink %>" aria-label="Notifications" data-nav-link
                                                    data-nav-variant="icon"
                                                    data-nav-prefixes="<%= navPrefixAttribute(notificationSection) %>"
                                                    class="relative inline-flex items-center justify-center rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 <%= isActive(notificationSection) ? 'bg-indigo-100 font-bold text-indigo-900 ring-1 ring-indigo-700' : '' %>"
                                                    <%- ariaCurrent(isActive(notificationSection)) %>
                                                    title="Notifications">

                                                    <i class="ph-bold ph-bell text-lg" aria-hidden="true">
                                                    </i>


                                                    <% if (notificationUnreadCount> 0) { %>

                                                        <span
                                                            class="absolute -right-0.5 -top-0.5 h-4 min-w-4 rounded-full bg-rose-600 px-1 text-center text-[9px] font-bold leading-4 text-white">

                                                            <%= notificationUnreadCount> 99
                                                                ? '99+'
                                                                : notificationUnreadCount %>

                                                        </span>

                                                        <% } %>

                                                </a>


                                                <% } %>


                                                    <!-- Messages -->

                                                    <% if (typeof messageUnreadCount !=='undefined' ) { %>

                                                        <%- include('messages-nav', { variant: 'icon' }) %>

                                                            <% } %>

                            </div>


                            <!-- Divider -->

                            <div class="hidden h-8 w-px bg-slate-200 sm:block">
                            </div>


                            <% } %>


                                <!-- ================================================= -->
                                <!-- PROFILE                                           -->
                                <!-- ================================================= -->

                                <div class="flex shrink-0 items-center">


                                    <% if (!currentUser) { %>


                                        <!-- Login -->

                                        <a href="/auth/login"
                                            class="rounded-lg px-2.5 py-2 text-xs font-semibold text-slate-700 transition-colors hover:text-indigo-700 sm:px-3">

                                            Log In

                                        </a>


                                        <!-- Sign Up -->

                                        <a href="/auth/register"
                                            class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 sm:px-4">

                                            Sign Up

                                        </a>


                                        <% } else { %>


                                            <!-- Profile Dropdown -->

                                            <div class="ip-dropdown relative hidden sm:block">

                                                <button type="button"
                                                    class="ip-dropdown__trigger flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 transition-colors hover:bg-slate-200 cursor-pointer"
                                                    title="<%= currentUser.name %>" aria-expanded="false"
                                                    aria-haspopup="true">


                                                    <% if (currentUser.avatar) { %>


                                                        <img src="<%= currentUser.avatar %>"
                                                            alt="<%= currentUser.name %>"
                                                            class="h-6 w-6 shrink-0 rounded-full border border-slate-300 object-cover">


                                                        <% } else { %>


                                                            <div
                                                                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-[10px] font-bold text-white">

                                                                <%= currentUser.name ?
                                                                    currentUser.name.charAt(0).toUpperCase() : 'U' %>

                                                            </div>


                                                            <% } %>


                                                                <span
                                                                    class="max-w-[140px] truncate text-xs font-semibold text-slate-700 sm:max-w-[160px] lg:max-w-[180px]"
                                                                    title="<%= currentUser.name %>">

                                                                    <%= currentUser.name %>

                                                                </span>


                                                                <i
                                                                    class="ph-bold ph-caret-down shrink-0 text-[10px] text-slate-500 transition-transform">
                                                                </i>

                                                </button>


                                                <!-- Profile Panel -->

                                                <div class="ip-dropdown__panel absolute right-0 top-full z-50 hidden w-48 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg pt-1"
                                                    role="menu">


                                                    <!-- User Info -->

                                                    <div class="border-b border-slate-100 bg-slate-50/50 px-4 py-2.5">

                                                        <p class="truncate text-xs font-bold text-slate-800"
                                                            title="<%= currentUser.name %>">

                                                            <%= currentUser.name %>

                                                        </p>


                                                        <p class="truncate text-[11px] capitalize text-slate-500">

                                                            <%= currentUser.role %>

                                                        </p>

                                                    </div>


                                                    <!-- Logout -->

                                                    <a href="/auth/logout" role="menuitem"
                                                        class="flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50">

                                                        <i class="ph-bold ph-sign-out">
                                                        </i>

                                                        Log Out

                                                    </a>


                                                    <!-- Signed-in Devices -->

                                                    <a href="/account/sessions" role="menuitem"
                                                        class="flex items-center gap-2 border-t border-slate-100 px-4 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-indigo-600">

                                                        <i class="ph-bold ph-devices">
                                                        </i>

                                                        Signed-in devices

                                                    </a>

                                                </div>

                                            </div>


                                            <% } %>

                                </div>


                                <!-- ================================================= -->
                                <!-- AZADI LOGO                                        -->
                                <!-- ================================================= -->

                                <div class="hidden shrink-0 items-center justify-center pl-1 2xl:flex">

                                    <img src="/images/azadi-logo.jpg" alt="Azadi Ka Amrit Mahotsav"
                                        class="h-10 w-auto object-contain mix-blend-multiply contrast-125">

                                </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- MOBILE NAVIGATION                                    -->
            <!-- ===================================================== -->

            <div id="mobileNavigation" class="hidden border-t border-slate-200 py-3 xl:hidden">

                <nav aria-label="Mobile navigation" class="grid gap-1">


                    <!-- Home -->

                    <a href="/" data-nav-link data-nav-variant="mobile"
                        data-nav-prefixes="<%= navPrefixAttribute('home') %>"
                        class="<%= mobileLinkClass(isActive('home')) %>" <%- ariaCurrent(isActive('home')) %>>

                        Home

                    </a>


                    <!-- Opportunities -->

                    <a href="/internships" data-nav-link data-nav-variant="mobile"
                        data-nav-prefixes="<%= navPrefixAttribute('opportunities') %>"
                        class="<%= mobileLinkClass(isActive('opportunities')) %>" <%-
                        ariaCurrent(isActive('opportunities')) %>>

                        Opportunities

                    </a>


                    <% if (currentUser) { %>


                        <% if (currentUser.role==='candidate' ) { %>


                            <!-- Candidate Profile -->

                            <a href="/candidate/profile" data-nav-link data-nav-variant="mobile"
                                data-nav-prefixes="<%= navPrefixAttribute('candidateProfile') %>"
                                class="<%= mobileLinkClass(isActive('candidateProfile')) %>" <%-
                                ariaCurrent(isActive('candidateProfile')) %>>

                                Candidate Profile

                            </a>


                            <!-- My Applications -->

                            <a href="/candidate/applications" data-nav-link data-nav-variant="mobile"
                                data-nav-prefixes="<%= navPrefixAttribute('applications') %>"
                                class="<%= mobileLinkClass(isActive('applications')) %>" <%-
                                ariaCurrent(isActive('applications')) %>>

                                My Applications

                            </a>


                            <!-- Certificates -->

                            <a href="/candidate/certificates" data-nav-link data-nav-variant="mobile"
                                data-nav-prefixes="<%= navPrefixAttribute('certificates') %>"
                                class="<%= mobileLinkClass(isActive('certificates')) %>" <%-
                                ariaCurrent(isActive('certificates')) %>>

                                Certificates

                            </a>


                            <!-- Saved Searches -->

                            <a href="/candidate/saved-searches" data-nav-link data-nav-variant="mobile"
                                data-nav-prefixes="<%= navPrefixAttribute('savedSearches') %>"
                                class="<%= mobileLinkClass(isActive('savedSearches')) %>" <%-
                                ariaCurrent(isActive('savedSearches')) %>>

                                Saved Searches

