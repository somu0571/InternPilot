    <!-- ===================================================== -->
    <!-- NAVIGATION JAVASCRIPT                                 -->
    <!-- ===================================================== -->

    <script>

        (() => {

            const toggle =
                document.getElementById('mobileNavToggle');

            const menu =
                document.getElementById('mobileNavigation');

            const icon =
                document.getElementById('mobileNavIcon');

            const toggleLabel =
                document.getElementById('mobileNavToggleLabel');


            /* =====================================================
               ACTIVE CLASS MAP
            ===================================================== */

            const activeClassMap = {

                desktop: {

                    active: [
                        'border-indigo-700',
                        'bg-indigo-50',
                        'text-indigo-900',
                        'font-bold'
                    ],

                    inactive: [
                        'border-transparent',
                        'text-slate-600',
                        'font-semibold'
                    ]

                },


                mobile: {

                    active: [
                        'border-indigo-700',
                        'bg-indigo-50',
                        'text-indigo-900',
                        'font-bold'
                    ],

                    inactive: [
                        'border-transparent',
                        'text-slate-600',
                        'font-semibold'
                    ]

                },


                icon: {

                    active: [
                        'bg-indigo-100',
                        'font-bold',
                        'text-indigo-900',
                        'ring-1',
                        'ring-indigo-700'
                    ],

                    inactive: [
                        'text-slate-600'
                    ]

                }

            };


            /* =====================================================
               NORMALIZE PATH
            ===================================================== */

            const normalizePath = value => {

                const path =
                    String(value || '/')
                        .split(/[?#]/, 1)[0] || '/';

                const withLeadingSlash =
                    path.startsWith('/')
                        ? path
                        : `/${path}`;

                return withLeadingSlash === '/'
                    ? '/'
                    : withLeadingSlash.replace(/\/+$/, '');

            };


            /* =====================================================
               MATCH PREFIX
            ===================================================== */

            const matchesPrefix =
                (pathname, prefix) => {

                    const normalizedPath =
                        normalizePath(pathname);

                    const normalizedPrefix =
                        normalizePath(prefix);

                    return normalizedPrefix === '/'
                        ? normalizedPath === '/'
                        : normalizedPath === normalizedPrefix ||
                        normalizedPath.startsWith(
                            `${normalizedPrefix}/`
                        );

                };


            /* =====================================================
               ACTIVE NAVIGATION
            ===================================================== */

            const syncActiveNavigation =
                (pathname = window.location.pathname) => {

                    document
                        .querySelectorAll('[data-nav-link]')
                        .forEach(link => {

                            const prefixes =
                                (link.dataset.navPrefixes || '')
                                    .split('|')
                                    .filter(Boolean);

                            const active =
                                prefixes.some(prefix =>
                                    matchesPrefix(
                                        pathname,
                                        prefix
                                    )
                                );

                            const classes =
                                activeClassMap[
                                link.dataset.navVariant
                                ] ||
                                activeClassMap.desktop;


                            classes.active.forEach(
                                className => {

                                    link.classList.toggle(
                                        className,
                                        active
                                    );

                                }
                            );


                            classes.inactive.forEach(
                                className => {

                                    link.classList.toggle(
                                        className,
                                        !active
                                    );

                                }
                            );


                            if (active) {

                                link.setAttribute(
                                    'aria-current',
                                    'page'
                                );

                            } else {

                                link.removeAttribute(
                                    'aria-current'
                                );

                            }

                        });

                };


            /* =====================================================
               CLOSE MOBILE NAVIGATION
            ===================================================== */

            const closeMobileNavigation = () => {

                if (!toggle || !menu) return;

                menu.classList.add('hidden');

                toggle.setAttribute(
                    'aria-expanded',
                    'false'
                );


                if (icon) {

                    icon.className =
                        'ph-bold ph-list text-xl';

                }


                if (toggleLabel) {

                    toggleLabel.textContent =
                        'Open navigation menu';

                }

            };


            /* =====================================================
               MOBILE MENU
            ===================================================== */

            if (toggle && menu) {

                toggle.addEventListener(
                    'click',
                    () => {

                        const isOpen =
                            !menu.classList.contains(
                                'hidden'
                            );


                        menu.classList.toggle(
                            'hidden',
                            isOpen
                        );


                        toggle.setAttribute(
                            'aria-expanded',
                            String(!isOpen)
                        );


                        if (icon) {

                            icon.className =
                                isOpen
                                    ? 'ph-bold ph-list text-xl'
                                    : 'ph-bold ph-x text-xl';

                        }


                        if (toggleLabel) {

                            toggleLabel.textContent =
                                isOpen
                                    ? 'Open navigation menu'
                                    : 'Close navigation menu';

                        }

                    }
                );


                document.addEventListener(
                    'keydown',
                    event => {

                        if (event.key === 'Escape') {

                            closeMobileNavigation();

                        }

                    }
                );

            }


            /* =====================================================
               NAVIGATION CLICK
            ===================================================== */

            document.addEventListener(
                'click',
                event => {

                    const link =
                        event.target.closest(
                            '[data-nav-link]'
                        );


                    if (
                        !link ||
                        event.defaultPrevented ||
                        event.button !== 0 ||
                        event.metaKey ||
                        event.ctrlKey ||
                        event.shiftKey ||
                        event.altKey
                    ) {

                        return;

                    }


                    syncActiveNavigation(
                        new URL(
                            link.href,
                            window.location.href
                        ).pathname
                    );


                    closeMobileNavigation();

                }
            );


            /* =====================================================
               HISTORY API
            ===================================================== */

            ['pushState', 'replaceState']
                .forEach(method => {

                    const originalMethod =
                        window.history[method];


                    window.history[method] =
                        function (...args) {

                            const result =
                                originalMethod.apply(
                                    this,
                                    args
                                );


                            window.dispatchEvent(
                                new Event(
                                    'internpilot:navigation'
                                )
                            );


                            return result;

                        };

                });


            window.addEventListener(
                'popstate',
                syncActiveNavigation
            );


            window.addEventListener(
                'internpilot:navigation',
                syncActiveNavigation
            );


            syncActiveNavigation();


            /* =====================================================
               DROPDOWNS
            ===================================================== */

            const closeAllDropdowns =
                except => {

                    document
                        .querySelectorAll(
                            '.ip-dropdown'
                        )
                        .forEach(dropdown => {

                            if (dropdown === except) return;


                            const trigger =
                                dropdown.querySelector(
                                    '.ip-dropdown__trigger'
                                );


                            const panel =
                                dropdown.querySelector(
                                    '.ip-dropdown__panel'
                                );


                            if (panel) {

                                panel.classList.add(
                                    'hidden'
                                );

                            }


                            if (trigger) {

                                trigger.setAttribute(
                                    'aria-expanded',
                                    'false'
                                );


                                const caret =
                                    trigger.querySelector(
                                        '.ph-caret-down'
                                    );


                                if (caret) {

                                    caret.style.transform =
                                        '';

                                }

                            }

                        });

                };


            /* =====================================================
               INITIALIZE DROPDOWNS
            ===================================================== */

            document
                .querySelectorAll('.ip-dropdown')
                .forEach(dropdown => {

                    const trigger =
                        dropdown.querySelector(
                            '.ip-dropdown__trigger'
                        );


                    const panel =
                        dropdown.querySelector(
                            '.ip-dropdown__panel'
                        );


                    if (!trigger || !panel) return;


                    const menuItems = () =>
                        Array.from(
                            panel.querySelectorAll(
                                'a[role="menuitem"], a:not([role])'
                            )
                        );


                    /* Open */

                    const openDropdown = () => {

                        closeAllDropdowns(
                            dropdown
                        );


                        panel.classList.remove(
                            'hidden'
                        );


                        trigger.setAttribute(
                            'aria-expanded',
                            'true'
                        );


                        const caret =
                            trigger.querySelector(
                                '.ph-caret-down'
                            );


                        if (caret) {

                            caret.style.transform =
                                'rotate(180deg)';

                        }

                    };


                    /* Close */

                    const closeDropdown =
                        (returnFocus = true) => {

                            panel.classList.add(
                                'hidden'
                            );


                            trigger.setAttribute(
                                'aria-expanded',
                                'false'
                            );


                            const caret =
                                trigger.querySelector(
                                    '.ph-caret-down'
                                );


                            if (caret) {

                                caret.style.transform =
                                    '';

                            }


                            if (returnFocus) {

                                trigger.focus();

                            }

                        };


                    const isOpen = () =>
                        !panel.classList.contains(
                            'hidden'
                        );


                    /* Click */

                    trigger.addEventListener(
                        'click',
                        event => {

                            event.stopPropagation();


                            if (isOpen()) {

                                closeDropdown();

                            } else {

                                openDropdown();

                            }

                        }
                    );


                    /* Keyboard */

                    trigger.addEventListener(
                        'keydown',
                        event => {

                            if (
                                event.key === 'ArrowDown' ||
                                event.key === 'Enter' ||
                                event.key === ' '
                            ) {

                                event.preventDefault();

                                openDropdown();


                                const items =
                                    menuItems();


                                if (items.length) {

                                    items[0].focus();

                                }

                            }

                        }
                    );


                    /* Menu keyboard navigation */

                    panel.addEventListener(
                        'keydown',
                        event => {

                            const items =
                                menuItems();


                            const current =
                                items.indexOf(
                                    document.activeElement
                                );


                            if (
                                event.key ===
                                'ArrowDown'
                            ) {

                                event.preventDefault();


                                const next =
                                    current <
                                        items.length - 1
                                        ? current + 1
                                        : 0;


                                items[next].focus();

                            }


                            else if (
                                event.key ===
                                'ArrowUp'
                            ) {

                                event.preventDefault();


                                const previous =
                                    current > 0
                                        ? current - 1
                                        : items.length - 1;


                                items[previous].focus();

                            }


                            else if (
                                event.key ===
                                'Escape'
                            ) {

                                event.preventDefault();

                                closeDropdown();

                            }


                            else if (
                                event.key ===
                                'Tab'
                            ) {

                                closeDropdown(false);

                            }

                        }
                    );


                    /* Mouse enter */

                    dropdown.addEventListener(
                        'mouseenter',
                        () => {

                            openDropdown();

                        }
                    );


                    /* Mouse leave */

                    dropdown.addEventListener(
                        'mouseleave',
                        () => {

                            if (
                                !dropdown.contains(
                                    document.activeElement
                                ) ||
                                document.activeElement ===
                                trigger
                            ) {

                                closeDropdown(false);

                            }

                        }
                    );

                });


            /* =====================================================
               CLICK OUTSIDE
            ===================================================== */

            document.addEventListener(
                'click',
                event => {

                    if (
                        !event.target.closest(
                            '.ip-dropdown'
                        )
                    ) {

                        closeAllDropdowns();

                    }

                }
            );


            /* =====================================================
               ESCAPE
            ===================================================== */

            document.addEventListener(
                'keydown',
                event => {

                    if (event.key === 'Escape') {

                        closeAllDropdowns();

                    }

                }
            );

        })();

    </script>