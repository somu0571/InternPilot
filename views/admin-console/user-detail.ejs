<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'users' }) %><section class="min-w-0 space-y-6"><a href="/admin/console/users" class="text-sm font-bold text-indigo-700 hover:underline">← Users</a><header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= user.role %></p><h1 class="mt-1 text-3xl font-bold text-slate-900"><%= user.name %></h1><p class="mt-1 text-slate-600"><%= user.email %></p></div><span class="rounded-full px-3 py-1 text-xs font-bold <%= suspension ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700' %>"><%= suspension ? 'Suspended' : 'Active' %></span></div><dl class="mt-5 grid gap-3 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Joined</dt><dd class="font-semibold"><%= new Date(user.createdAt).toLocaleString('en-IN') %></dd></div><div><dt class="text-slate-500">Location</dt><dd class="font-semibold"><%= user.location?.district || user.location?.state || 'Not provided' %></dd></div><div><dt class="text-slate-500">Reason</dt><dd class="font-semibold"><%= suspension?.reason || '—' %></dd></div></dl></header>
<% if (canSuspend) { %><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">Account access</h2><% if (suspension) { %><form action="/admin/console/users/<%= user._id %>/reactivate" method="POST" class="mt-3"><button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700">Reactivate sign-in</button></form><% } else { %><form action="/admin/console/users/<%= user._id %>/suspend" method="POST" class="mt-3 flex flex-col gap-2 sm:flex-row"><input required maxlength="1000" name="reason" placeholder="Reason for suspension" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm" /><button class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-bold text-white hover:bg-rose-700">Suspend account</button></form><% } %></article><% } %>
<article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 p-5"><h2 class="font-bold text-slate-900"><%= user.role === 'candidate' ? 'Applications' : 'Listings' %></h2></div><div class="divide-y divide-slate-100"><% const records = user.role === 'candidate' ? applications : listings; %><% if (records.length) { records.forEach(record => { %><div class="p-4 text-sm"><p class="font-bold"><%= user.role === 'candidate' ? (record.internship?.title || 'Deleted listing') : record.title %></p><p class="text-slate-500"><%= user.role === 'candidate' ? `${record.internship?.companyName || 'Unknown company'} · ${record.status}` : `${record.companyName} · ${record.status}` %></p></div><% }); } else { %><p class="p-5 text-sm text-slate-500">No related records.</p><% } %></div></article></section></div>
