<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'announcements' }) %><section class="min-w-0 space-y-6"><header class="ip-hero"><div class="relative flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-100/80">Admin console</p><h1 class="mt-1 text-3xl font-bold">Announcements</h1><p class="mt-1 text-sm text-indigo-100/90">Banners only appear to their audience within the scheduled time window.</p></div></div></header>
<form action="/admin/console/announcements" method="POST" class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Title<input required maxlength="140" name="title" class="mt-1 w-full rounded-lg border-slate-300 text-sm" /></label><label class="text-sm font-bold text-slate-700">Audience<select name="audience" class="mt-1 w-full rounded-lg border-slate-300 text-sm"><option value="all">Everyone</option><option value="candidates">Candidates only</option><option value="companies">Companies only</option></select></label></div><label class="text-sm font-bold text-slate-700">Message<textarea required maxlength="2000" name="message" rows="3" class="mt-1 w-full rounded-lg border-slate-300 text-sm"></textarea></label><div class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-bold text-slate-700">Tone<select name="tone" class="mt-1 w-full rounded-lg border-slate-300 text-sm"><option value="info">Info</option><option value="warning">Warning</option><option value="success">Success</option></select></label><label class="text-sm font-bold text-slate-700">Start<input required type="datetime-local" name="startsAt" value="<%= now.toISOString().slice(0, 16) %>" class="mt-1 w-full rounded-lg border-slate-300 text-sm" /></label><label class="text-sm font-bold text-slate-700">End<input required type="datetime-local" name="endsAt" class="mt-1 w-full rounded-lg border-slate-300 text-sm" /></label></div><label class="flex items-center gap-2 text-sm font-semibold text-slate-700"><input type="checkbox" name="sendInApp" class="rounded border-slate-300 text-indigo-600" /> Also send an in-app notification</label><div><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700">Publish announcement</button></div></form>
<div class="space-y-3" data-animate-stagger><% if (announcements.length) { announcements.forEach(announcement => { const active = announcement.startsAt <= now && announcement.endsAt >= now; %><article class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-start sm:justify-between"><div><div class="flex flex-wrap items-center gap-2"><h2 class="font-bold text-slate-900"><%= announcement.title %></h2><span class="rounded-full px-2 py-1 text-xs font-bold <%= active ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= active ? 'Live' : 'Scheduled / ended' %></span></div><p class="mt-1 text-sm text-slate-600"><%= announcement.message %></p><p class="mt-2 text-xs text-slate-500"><%= announcement.audience %> · <%= announcement.tone %> · <%= new Date(announcement.startsAt).toLocaleString('en-IN') %> to <%= new Date(announcement.endsAt).toLocaleString('en-IN') %><%= announcement.inAppSentAt ? ' · notification sent' : '' %></p></div><form action="/admin/console/announcements/<%= announcement._id %>/delete" method="POST" data-confirm="Remove this announcement? It stops showing on the site straight away." data-confirm-action="Remove"><button class="rounded-lg border border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50">Delete</button></form></article><% }); } else { %><div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">No announcements created yet.</div><% } %></div></section></div>
