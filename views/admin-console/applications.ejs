<% layout('layouts/boilerplate') %>
<%
const statusStyles = {
    Submitted: 'bg-slate-100 text-slate-700 border-slate-200',
    'Under Review': 'bg-sky-50 text-sky-700 border-sky-100',
    Shortlisted: 'bg-indigo-50 text-indigo-700 border-indigo-100',
    Interview: 'bg-violet-50 text-violet-700 border-violet-100',
    Rejected: 'bg-rose-50 text-rose-700 border-rose-100',
    Hired: 'bg-emerald-50 text-emerald-700 border-emerald-100',
    Withdrawn: 'bg-slate-100 text-slate-500 border-slate-200',
    'Offer Declined': 'bg-amber-50 text-amber-700 border-amber-100'
};
const initials = name => String(name || '?').trim().split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || '?';
%>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <%- include('partials/sidebar', { section: 'applications' }) %>
    <section class="min-w-0 space-y-5">
        <header class="ip-hero">
            <div class="relative flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-100/80">Admin console</p>
                    <h1 class="mt-1 text-3xl font-bold">Applications</h1>
                    <p class="mt-1 text-sm text-indigo-100/90">Every application on the platform, newest first.</p>
                </div>
                <span class="inline-flex items-center gap-2 self-start rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold ring-1 ring-white/25 sm:self-auto"><i class="ph-bold ph-files" aria-hidden="true"></i><span data-count-up><%= applications.length %></span> shown</span>
            </div>
        </header>

        <form method="GET" class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-3">
            <label class="text-xs font-bold text-slate-600">Search
                <input name="search" value="<%= filters.search %>" placeholder="Candidate, listing, or company" class="mt-1 w-full rounded-xl border-slate-300 text-sm" />
            </label>
            <label class="text-xs font-bold text-slate-600">Status
                <select name="status" class="mt-1 w-full rounded-xl border-slate-300 text-sm">
                    <option value="">All statuses</option>
                    <% statuses.forEach(status => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %>
                </select>
            </label>
            <div class="flex items-end gap-2">
                <button class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white"><i class="ph-bold ph-funnel" aria-hidden="true"></i> Filter</button>
                <a href="/admin/console/export/applications?<%= new URLSearchParams(filters).toString() %>" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:border-indigo-300 hover:text-indigo-700"><i class="ph-bold ph-download-simple" aria-hidden="true"></i> CSV</a>
            </div>
        </form>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50/80">
                        <tr>
                            <th class="px-5 py-3">Candidate</th>
                            <th class="px-5 py-3">Listing</th>
                            <th class="px-5 py-3">Status</th>
                            <th class="px-5 py-3">Applied</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100" data-animate-stagger>
                        <% if (applications.length) { applications.forEach(application => { const status = application.status === 'pending' ? 'Submitted' : application.status; %>
                            <tr>
                                <td class="px-5 py-3">
                                    <div class="flex items-center gap-3">
                                        <span class="ip-avatar" aria-hidden="true"><%= initials(application.candidate?.name) %></span>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900"><%= application.candidate?.name || 'Deleted candidate' %></p>
                                            <p class="truncate text-xs text-slate-500"><%= application.candidate?.email || '' %></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-3">
                                    <p class="font-semibold text-slate-800"><%= application.internship?.title || 'Deleted listing' %></p>
                                    <p class="text-xs text-slate-500"><%= application.internship?.companyName || '' %></p>
                                </td>
                                <td class="px-5 py-3"><span class="ip-pill <%= statusStyles[status] || statusStyles.Submitted %>"><%= status %></span></td>
                                <td class="px-5 py-3 text-slate-500"><%= new Date(application.appliedAt).toLocaleDateString('en-IN') %></td>
                            </tr>
                        <% }); } else { %>
                            <tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No applications match these filters.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
