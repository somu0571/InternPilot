<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'listings' }) %><section class="min-w-0 space-y-5"><header class="ip-hero"><div class="relative flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-100/80">Admin console</p><h1 class="mt-1 text-3xl font-bold">Listing moderation</h1><p class="mt-1 text-sm text-indigo-100/90">Flags are automated indicators, not a verdict.</p></div></div></header>
<form method="GET" class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row"><input name="search" value="<%= filters.search %>" placeholder="Search title or company" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm" /><select name="status" class="rounded-lg border-slate-300 text-sm"><option value="">All statuses</option><% ['published','paused','closed','draft'].forEach(status => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Filter</button></form>
<div class="space-y-4" data-animate-stagger><% if (listings.length) { listings.forEach(listing => { %><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex flex-col justify-between gap-4 lg:flex-row"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h2 class="text-lg font-bold text-slate-900"><%= listing.title || 'Untitled listing' %></h2><span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600"><%= listing.status %></span></div><p class="mt-1 text-sm text-slate-500"><%= listing.companyName || 'Unknown company' %> · <%= listing.vacancies %> openings · ₹<%= listing.monthlyStipend %>/month</p><div class="mt-3 flex flex-wrap gap-2"><% if (listing.riskFlags.length) { listing.riskFlags.forEach(flag => { %><span title="<%= flag.label %>" class="rounded-full px-2 py-1 text-xs font-semibold <%= flag.severity === 'high' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-800' %>"><%= flag.label %></span><% }); } else { %><span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700">No automatic flags</span><% } %></div></div><form action="/admin/console/listings/<%= listing._id %>/moderate" method="POST" class="grid gap-2 sm:grid-cols-[11rem_minmax(15rem,1fr)_auto] lg:w-[37rem]"><select name="action" class="rounded-lg border-slate-300 text-sm"><option value="pause">Pause listing</option><option value="close">Close listing</option><option value="restore">Restore listing</option></select><input required maxlength="1000" name="reason" placeholder="Reason shown to company" class="rounded-lg border-slate-300 text-sm" /><button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">Apply</button></form></div></article><% }); } else { %><div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">No listings match these filters.</div><% } %></div></section></div>
