<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <%- include('partials/sidebar', { section: 'overview' }) %>
    <section class="min-w-0 space-y-6">
        <header class="ip-hero flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div class="relative">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-100/80">Admin console</p>
                <h1 class="mt-1 text-3xl font-bold sm:text-4xl">Platform overview</h1>
                <p class="mt-1 text-sm text-indigo-100/90">Operational signals for the last <%= analytics.days %> days.</p>
            </div>
            <form method="GET" class="relative flex items-end gap-2">
                <label class="text-xs font-semibold text-indigo-100">Range
                    <select name="range" class="mt-1 block rounded-xl border-0 bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm">
                        <% [7, 30, 90].forEach(range => { %><option value="<%= range %>" <%= analytics.days === range ? 'selected' : '' %>><%= range %> days</option><% }) %>
                    </select>
                </label>
                <button class="rounded-xl bg-white px-4 py-2 text-sm font-bold text-indigo-700 shadow-sm hover:bg-indigo-50">Apply</button>
            </form>
        </header>
        <% const kpis = [
            ['Candidates', analytics.totals.candidates, 'ph-student', 'from-indigo-500 to-violet-500'],
            ['Companies', analytics.totals.companies, 'ph-buildings', 'from-sky-500 to-cyan-500'],
            ['Listings', analytics.totals.listings, 'ph-briefcase', 'from-violet-500 to-fuchsia-500'],
            ['Applications', analytics.totals.applications, 'ph-files', 'from-amber-500 to-orange-500'],
            ['Hires', analytics.totals.hires, 'ph-handshake', 'from-emerald-500 to-teal-500']
        ]; %>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5" data-animate-stagger>
            <% kpis.forEach(([label, stat, icon, gradient]) => { const up = stat.change >= 0; %>
                <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= label %></p>
                        <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br <%= gradient %> text-white shadow-sm"><i class="ph-bold <%= icon %> text-lg" aria-hidden="true"></i></span>
                    </div>
                    <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900" data-count-up><%= stat.current %></p>
                    <p class="mt-2 flex flex-wrap items-center gap-1.5"><span class="ip-pill ip-pill--nodot <%= up ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-rose-50 text-rose-700 border-rose-100' %>"><%= up ? '▲' : '▼' %> <%= up ? '+' : '' %><%= stat.change %>%</span><span class="text-[11px] text-slate-400">vs previous period</span></p>
                </article>
            <% }) %>
        </div>
        <div class="grid gap-6 xl:grid-cols-2" data-animate-stagger>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">Daily activity</h2><div class="mt-4 h-72"><canvas id="dailyActivityChart" aria-label="Daily sign-ups and applications chart"></canvas></div></article>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">Application funnel</h2><div class="mt-4 space-y-3"><% analytics.funnel.forEach(stage => { %><div><div class="flex justify-between text-sm"><span class="font-semibold text-slate-700"><%= stage.status %></span><span class="text-slate-500"><%= stage.count %> · <%= stage.conversion %>% conversion</span></div><div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100"><div class="ip-bar h-full rounded-full bg-gradient-to-r from-indigo-500 to-violet-500" style="width: <%= Math.min(100, stage.conversion) %>%"></div></div></div><% }) %><p class="border-t pt-3 text-xs text-slate-500">Rejected: <strong><%= analytics.rejected %></strong> · Withdrawn: <strong><%= analytics.withdrawn %></strong></p></div></article>
        </div>
        <div class="grid gap-6 xl:grid-cols-3" data-animate-stagger>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">Applications by state</h2><ul class="mt-3 space-y-2 text-sm"><% if (analytics.states.length) { analytics.states.forEach(item => { %><li class="flex justify-between"><span><%= item.state %></span><strong><%= item.count %></strong></li><% }); } else { %><li class="text-slate-500">No applications in this range.</li><% } %></ul></article>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">Top listings</h2><ul class="mt-3 space-y-3 text-sm"><% if (analytics.topListings.length) { analytics.topListings.forEach(item => { %><li><p class="font-semibold"><%= item.title %></p><p class="text-xs text-slate-500"><%= item.companyName %> · <%= item.applications %> applications</p></li><% }); } else { %><li class="text-slate-500">No applications in this range.</li><% } %></ul></article>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-900">PMIS eligibility</h2><dl class="mt-3 space-y-2 text-sm"><div class="flex justify-between"><dt>Eligible</dt><dd class="font-bold text-emerald-600"><%= analytics.pmis.eligible %></dd></div><div class="flex justify-between"><dt>Ineligible</dt><dd class="font-bold text-rose-600"><%= analytics.pmis.ineligible %></dd></div><div class="flex justify-between"><dt>Incomplete</dt><dd class="font-bold text-amber-600"><%= analytics.pmis.incomplete %></dd></div></dl><h3 class="mt-5 text-sm font-bold text-slate-900">Skills gap</h3><ul class="mt-2 space-y-1 text-xs"><% if (analytics.skillsGap.length) { analytics.skillsGap.forEach(item => { %><li class="flex justify-between"><span><%= item.skill %></span><span class="font-semibold"><%= item.candidates %> candidates</span></li><% }); } else { %><li class="text-slate-500">No skills data in this range.</li><% } %></ul></article>
        </div>
        <p class="text-xs text-slate-500">Download data: <a class="font-bold text-indigo-700 hover:underline" href="/admin/console/export/users">Users CSV</a> · <a class="font-bold text-indigo-700 hover:underline" href="/admin/console/export/applications">Applications CSV</a></p>
    </section>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        var canvas = document.getElementById('dailyActivityChart');
        if (!canvas || typeof Chart === 'undefined') return;
        var data = <%- safeJson(analytics.daily) %>;
        new Chart(canvas, { type: 'line', data: { labels: data.labels, datasets: [{ label: 'Sign-ups', data: data.signups, borderColor: '#4f46e5', backgroundColor: 'rgba(79,70,229,.12)', tension: .3 }, { label: 'Applications', data: data.applications, borderColor: '#059669', backgroundColor: 'rgba(5,150,105,.12)', tension: .3 }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } } });
    })();
</script>
