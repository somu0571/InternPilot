<% layout('layouts/boilerplate') %>
<% const company = user.companyDetails || {}; %>
<% const removal = typeof deletion !== 'undefined' && deletion ? deletion : { blocker: "This account can't be deleted.", items: [] }; %>

<div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[210px_minmax(0,1fr)] gap-6">
    <%- include('_nav') %>

    <div class="min-w-0 space-y-5">
        <a href="/admin/users" class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 hover:underline">
            <i class="ph-bold ph-arrow-left" aria-hidden="true"></i> All users
        </a>

        <section class="bg-white border border-slate-200 rounded-xl shadow-sm p-5" aria-labelledby="userName">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                    <h1 id="userName" class="text-xl font-bold text-slate-900 break-words"><%= user.name || 'Unnamed' %></h1>
                    <p class="text-xs text-slate-500 mt-0.5 break-all"><%= user.email %></p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2 py-0.5 rounded-full border bg-slate-50 border-slate-200 text-slate-600 font-semibold text-[11px]"><%= user.roleLabel %></span>
                    <% if (suspension) { %>
                        <span class="px-2 py-0.5 rounded-full border bg-rose-50 border-rose-200 text-rose-700 font-bold text-[11px]" data-suspended>Suspended</span>
                    <% } %>
                </div>
            </div>
            <dl class="grid sm:grid-cols-3 gap-x-6 gap-y-2 text-xs mt-4">
                <div><dt class="text-slate-400">Joined</dt><dd class="font-semibold text-slate-700"><%= user.joinedLabel || '-' %></dd></div>
                <div><dt class="text-slate-400">Location</dt><dd class="font-semibold text-slate-700"><%= [user.location && user.location.district, user.location && user.location.state].filter(Boolean).join(', ') || '-' %></dd></div>
                <% if (company.companyName) { %>
                    <div><dt class="text-slate-400">Company</dt><dd class="font-semibold text-slate-700"><%= company.companyName %><% if (user.role === 'company') { %> <span class="font-normal <%= company.isVerified ? 'text-emerald-600' : 'text-amber-600' %>">(<%= company.isVerified ? 'verified' : 'unverified' %>)</span><% } %></dd></div>
                <% } else if (user.education && user.education.qualification) { %>
                    <div><dt class="text-slate-400">Qualification</dt><dd class="font-semibold text-slate-700"><%= user.education.qualification %></dd></div>
                <% } %>
            </dl>
        </section>

        <section class="bg-white border <%= suspension ? 'border-rose-200' : 'border-slate-200' %> rounded-xl shadow-sm p-5 space-y-3" aria-labelledby="accessTitle">
            <h2 id="accessTitle" class="text-sm font-bold text-slate-900">Sign-in access</h2>
            <% if (suspension) { %>
                <p class="text-xs text-rose-700 bg-rose-50 border border-rose-100 rounded-lg px-3 py-2">
                    Suspended since <%= history.find(h => h.active).fromLabel %> by <%= (suspension.suspendedBy && suspension.suspendedBy.name) || 'an admin' %>. Reason shown to them: <span class="font-semibold"><%= suspension.reason %></span>
                </p>
                <form action="/admin/users/<%= user._id %>/reactivate" method="POST" class="space-y-2" id="reactivateForm">
                    <label for="reactivateNote" class="block text-xs font-semibold text-slate-700">Note for the log <span class="font-normal text-slate-400">(optional)</span></label>
                    <input id="reactivateNote" name="note" maxlength="1000" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-600" placeholder="e.g. Identity confirmed over email">
                    <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">Reactivate account</button>
                </form>
            <% } else if (canSuspend) { %>
                <p class="text-xs text-slate-500">Suspending signs them out on their next request and blocks sign-in until you reactivate the account. They see the reason you give.</p>
                <form action="/admin/users/<%= user._id %>/suspend" method="POST" class="space-y-2" id="suspendForm">
                    <label for="suspendReason" class="block text-xs font-semibold text-slate-700">Reason</label>
                    <textarea id="suspendReason" name="reason" rows="2" required minlength="10" maxlength="1000"
                        class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                        placeholder="e.g. Several fake applications reported by companies"></textarea>
                    <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg">Suspend sign-in</button>
                </form>
            <% } else { %>
                <p class="text-xs text-slate-500"><%= suspendBlocker %></p>
            <% } %>
        </section>

        <% if (user.role === 'candidate') { %>
            <section class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden" aria-labelledby="appsTitle">
                <h2 id="appsTitle" class="text-sm font-bold text-slate-900 p-5 pb-3">Recent applications</h2>
                <% if (!applications.length) { %>
                    <p class="text-xs text-slate-500 px-5 pb-5">No applications yet.</p>
                <% } else { %>
                    <table class="w-full text-left text-xs">
                        <tbody class="divide-y divide-slate-100">
                            <% applications.forEach(a => { %>
                                <tr>
                                    <td class="px-5 py-2.5"><span class="font-semibold text-slate-800"><%= (a.internship && a.internship.title) || 'Removed listing' %></span><span class="block text-[11px] text-slate-500"><%= a.internship && a.internship.companyName %></span></td>
                                    <td class="px-3 py-2.5 text-slate-600"><%= a.status %></td>
                                    <td class="px-3 py-2.5 text-slate-500 whitespace-nowrap"><%= a.appliedLabel %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        <% } else if (user.role !== 'admin') { %>
            <section class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden" aria-labelledby="listingsTitle">
                <h2 id="listingsTitle" class="text-sm font-bold text-slate-900 p-5 pb-3">Company listings</h2>
                <% if (!listings.length) { %>
                    <p class="text-xs text-slate-500 px-5 pb-5">No listings yet.</p>
                <% } else { %>
                    <table class="w-full text-left text-xs">
                        <tbody class="divide-y divide-slate-100">
                            <% listings.forEach(l => { %>
                                <tr>
                                    <td class="px-5 py-2.5 font-semibold text-slate-800"><%= l.title %></td>
                                    <td class="px-3 py-2.5 text-slate-600"><%= l.status %></td>
                                    <td class="px-3 py-2.5 text-slate-500"><%= l.applications %> applications</td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        <% } %>

        <div class="grid xl:grid-cols-2 gap-5">
            <section class="bg-white border border-slate-200 rounded-xl shadow-sm p-5" aria-labelledby="historyTitle">
                <h2 id="historyTitle" class="text-sm font-bold text-slate-900">Suspension history</h2>
                <% if (!history.length) { %>
                    <p class="text-xs text-slate-500 mt-2">Never suspended.</p>
                <% } else { %>
                    <ol class="space-y-3 mt-3">
                        <% history.forEach(h => { %>
                            <li class="text-xs border-l-2 <%= h.active ? 'border-rose-400' : 'border-slate-200' %> pl-3">
                                <p class="font-semibold text-slate-800"><%= h.fromLabel %><%= h.toLabel ? ' to ' + h.toLabel : ' (active)' %></p>
                                <p class="text-slate-600 mt-0.5"><%= h.reason %></p>
                                <p class="text-[11px] text-slate-400 mt-0.5">By <%= (h.suspendedBy && h.suspendedBy.name) || 'an admin' %><%= h.liftedBy ? ', reactivated by ' + h.liftedBy.name : '' %><%= h.liftReason ? ': ' + h.liftReason : '' %></p>
                            </li>
                        <% }) %>
                    </ol>
                <% } %>
            </section>

            <section class="bg-white border border-slate-200 rounded-xl shadow-sm p-5" aria-labelledby="actionsTitle">
                <h2 id="actionsTitle" class="text-sm font-bold text-slate-900">Admin actions on this account</h2>
                <% if (!actions.length) { %>
                    <p class="text-xs text-slate-500 mt-2">None yet.</p>
                <% } else { %>
                    <ul class="space-y-2 mt-3 text-xs">
                        <% actions.forEach(a => { %>
                            <li><span class="font-semibold text-slate-800"><%= a.label %></span> <span class="text-slate-400">· <%= (a.admin && a.admin.name) || 'Admin' %> · <%= new Date(a.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span></li>
                        <% }) %>
                    </ul>
                <% } %>
            </section>
        </div>

        <section class="bg-white border border-rose-200 rounded-xl shadow-sm p-5 space-y-3" aria-labelledby="deleteTitle" id="dangerZone">
            <h2 id="deleteTitle" class="text-sm font-bold text-rose-700 flex items-center gap-1.5">
                <i class="ph-bold ph-trash" aria-hidden="true"></i> Delete account
            </h2>
            <% if (removal.blocker) { %>
                <p class="text-xs text-slate-500" data-delete-blocked><%= removal.blocker %></p>
            <% } else { %>
                <p class="text-xs text-slate-600">This permanently removes the account and everything below that belongs to it. It can't be undone. The audit log keeps a record of who deleted it and why.</p>
                <% if (removal.items.length) { %>
                    <ul class="text-xs text-slate-600 grid sm:grid-cols-2 gap-x-6" data-delete-preview>
                        <% removal.items.forEach(item => { %>
                            <li class="flex justify-between border-b border-slate-100 py-1.5"><span><%= item.label %></span><span class="font-semibold tabular-nums"><%= item.count %></span></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="text-xs text-slate-500">Nothing else is linked to this account.</p>
                <% } %>
                <form action="/admin/users/<%= user._id %>/delete" method="POST" class="space-y-2 pt-1" id="deleteForm">
                    <label for="deleteReason" class="block text-xs font-semibold text-slate-700">Reason <span class="font-normal text-slate-400">(kept in the audit log)</span></label>
                    <textarea id="deleteReason" name="reason" rows="2" required minlength="10" maxlength="1000"
                        class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                        placeholder="e.g. The candidate asked for their account and data to be deleted"></textarea>
                    <label for="deleteConfirm" class="block text-xs font-semibold text-slate-700">Type <span class="font-mono text-rose-700 break-all"><%= user.email %></span> to confirm</label>
                    <input id="deleteConfirm" name="confirmEmail" required autocomplete="off" spellcheck="false"
                        class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500">
                    <button type="submit" class="px-4 py-2 bg-rose-700 hover:bg-rose-800 text-white text-xs font-semibold rounded-lg">Delete this account permanently</button>
                </form>
            <% } %>
        </section>
    </div>
</div>
