<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <%- include('../partials/motion-head') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InternPilot | Prime Minister's Internship Scheme</title>

    <!-- Anti-FOUC: set theme before first paint -->
    <script>
        (function () {
            var stored = null;
            try {
                stored = window.localStorage.getItem('theme'); // 'light' | 'dark' | 'system' | null
            } catch (error) {
                // Privacy settings can make localStorage unavailable. System mode remains safe.
            }
            var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = stored === 'dark' || (stored === 'system' && systemDark) || (!stored && systemDark);
            document.documentElement.classList.toggle('dark', isDark);
        })();
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/app-shell.css">
</head>

<body class="h-full flex flex-col bg-slate-50 dark:bg-slate-900 font-sans text-slate-800 dark:text-slate-100 m-0 overflow-x-hidden transition-colors">

    <%- include('../partials/header') %>
    <%- include('../partials/admin-announcements') %>

        <main class="flex-grow <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'w-full px-0 py-0' : 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full' %>">
            <%- include('../partials/flash') %>
            <% if (typeof siteAnnouncements !== 'undefined' && siteAnnouncements && siteAnnouncements.length) { %><%- include('../partials/site-announcements') %><% } %>
            <%- body %>
        </main>

        <%- include('../partials/footer') %>

            <% if (typeof currentUser !=='undefined' && currentUser && currentUser.role==='candidate' ) { %>
                <%- include('../partials/chat-widget') %>
                <%- include('../partials/quick-apply-modal') %>
                    <% } %>

    <button
        id="back-to-top-btn"
        type="button"
        aria-label="Scroll back to top of page"
        class="fixed bottom-6 left-6 z-50
               w-12 h-12 rounded-full
               bg-indigo-600 text-white
               shadow-lg shadow-indigo-600/25
               flex items-center justify-center
               hover:bg-indigo-700
               active:scale-90
               transition-colors duration-200
               cursor-pointer"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
        >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
    </button>

    <%- include('../partials/loading-script') %>

    <script src="/js/app-shell.js" defer></script>

</body>

</html>