<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InternPilot | Prime Minister's Internship Scheme</title>

    <!-- Anti-FOUC: set theme before first paint -->
    <script>
        (function () {
            var stored = localStorage.getItem('theme'); // 'light' | 'dark' | 'system' | null
            var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = stored === 'dark' || (stored === 'system' && systemDark) || (!stored && systemDark);
            document.documentElement.classList.toggle('dark', isDark);
        })();
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="/css/header.css">

    <style>
        #back-to-top-btn {
            opacity: 0;
            transform: translateY(10px);
            pointer-events: none;
            visibility: hidden;
            transition: opacity 0.3s ease,
                        transform 0.3s ease,
                        visibility 0.3s ease;
        }

        #back-to-top-btn.visible {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
            visibility: visible;
        }

        #back-to-top-btn:hover {
            box-shadow: 0 0 16px rgba(99, 102, 241, 0.45);
        }

        #back-to-top-btn:focus-visible {
            outline: 3px solid #818cf8;
            outline-offset: 3px;
        }

        .invisible-scrollbar {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
        .invisible-scrollbar::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
    </style>
</head>

<body class="h-full flex flex-col bg-slate-50 dark:bg-slate-900 font-sans text-slate-800 dark:text-slate-100 m-0 overflow-x-hidden transition-colors">

    <%- include('../partials/header') %>

        <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
            <%- include('../partials/flash') %>
            <%- body %>
        </main>

        <%- include('../partials/footer') %>

            <% if (typeof currentUser !=='undefined' && currentUser && currentUser.role==='candidate' ) { %>
                <%- include('../partials/chat-widget') %>
                    <% } %>

    <button
        id="back-to-top-btn"
        type="button"
        aria-label="Scroll back to top of page"
        class="fixed bottom-6 left-6 z-50
               w-12 h-12 rounded-full
               bg-indigo-600 text-white
               shadow-lg shadow-indigo-600/25
               flex items-center justify-center
               hover:bg-indigo-700
               active:scale-90
               transition-colors duration-200
               cursor-pointer"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
        >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
    </button>

    <script>
        (function () {
            var btn = document.getElementById('back-to-top-btn');
            if (!btn) return;

            function getThreshold() {
                return window.innerHeight;
            }

            var ticking = false;

            function onScroll() {
                if (!ticking) {
                    window.requestAnimationFrame(function () {
                        if (window.scrollY > getThreshold()) {
                            btn.classList.add('visible');
                        } else {
                            btn.classList.remove('visible');
                        }
                        ticking = false;
                    });
                    ticking = true;
                }
            }

            window.addEventListener('scroll', onScroll, { passive: true });

            btn.addEventListener('click', function () {
                window.scrollTo({
                    top: 0,
                    left: 0,
                    behavior: 'smooth'
                });
            });

        })();
    </script>

        <%- include('../partials/loading-script') %>

    <script>
        (function () {
            var STORAGE_KEY = 'theme';
            var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

            function getStored() {
                return localStorage.getItem(STORAGE_KEY) || 'system';
            }

            function applyTheme(mode) {
                var isDark = mode === 'dark' || (mode === 'system' && mediaQuery.matches);
                document.documentElement.classList.toggle('dark', isDark);
                updateToggleUI(mode);
            }

            function setTheme(mode) {
                localStorage.setItem(STORAGE_KEY, mode);
                applyTheme(mode);
            }

            function cycleTheme() {
                var order = ['light', 'dark', 'system'];
                var current = getStored();
                var next = order[(order.indexOf(current) + 1) % order.length];
                setTheme(next);
            }

            function updateToggleUI(mode) {
                var icon = document.getElementById('themeToggleIcon');
                var label = document.getElementById('themeToggleLabel');
                if (!icon) return;
                var iconMap = {
                    light: 'ph-bold ph-sun text-lg',
                    dark: 'ph-bold ph-moon text-lg',
                    system: 'ph-bold ph-monitor text-lg'
                };
                var labelMap = {
                    light: 'Light mode',
                    dark: 'Dark mode',
                    system: 'System theme'
                };
                icon.className = iconMap[mode] || iconMap.system;
                if (label) label.textContent = labelMap[mode] || labelMap.system;
            }

            mediaQuery.addEventListener('change', function () {
                if (getStored() === 'system') applyTheme('system');
            });

            var toggleBtn = document.getElementById('themeToggle');
            if (toggleBtn) toggleBtn.addEventListener('click', cycleTheme);

            applyTheme(getStored());
        })();
    </script>

</body>

</html>