<% layout('layouts/boilerplate') %>

<div class="max-w-3xl mx-auto space-y-6 py-4">

    <!-- Top Navigation / Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs">
        <a href="/company/<%= company._id %>/profile" class="font-semibold text-indigo-600 hover:underline flex items-center gap-1">
            <i class="ph-bold ph-arrow-left text-sm"></i> Back to <%= cName %> Profile
        </a>
        <span class="text-slate-300">&bull;</span>
        <span class="text-slate-500">Verified Intern Review</span>
    </div>

    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
            <i class="ph-bold ph-star text-9xl text-white"></i>
        </div>
        <div class="relative z-10 space-y-2">
            <div class="inline-flex items-center gap-2 bg-emerald-500/20 text-emerald-200 border border-emerald-400/30 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-sm">
                <i class="ph-bold ph-seal-check text-emerald-400"></i>
                Verified Intern Review
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Review <%= cName %>
            </h1>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-2xl">
                Share authentic feedback on mentorship, skill growth, stipend punctuality, and work culture. Your review helps students choose the right opportunities and encourages employers to maintain high standards.
            </p>
        </div>
    </div>

    <!-- Review Form Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">

        <form action="/companies/<%= company._id %>/reviews" method="POST" id="reviewForm" class="space-y-6">

            <!-- Verified Role Context -->
            <div class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-xl shrink-0">
                        <i class="ph-bold ph-shield-check"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 block">
                            Verified Internship Engagement
                        </span>
                        <h3 class="text-sm font-bold text-slate-900">
                            <%= eligibility.roleTitle || 'Intern' %> at <%= cName %>
                        </h3>
                    </div>
                </div>

                <div class="shrink-0 text-right">
                    <label class="text-[11px] font-semibold text-slate-500 block mb-1">Status</label>
                    <select name="employmentStatus" class="px-2.5 py-1 text-xs border border-slate-300 rounded-lg bg-white font-medium text-slate-700">
                        <option value="Former Intern" selected>Former Intern</option>
                        <option value="Current Intern">Current Intern</option>
                    </select>
                </div>
            </div>

            <!-- Overall Star Rating -->
            <div class="space-y-2 border-b border-slate-100 pb-5">
                <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
                    Overall Experience Rating <span class="text-rose-500">*</span>
                </label>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1 text-3xl text-slate-300 cursor-pointer" id="overallStarContainer">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <i class="ph-fill ph-star star-btn transition-colors hover:text-amber-400 text-amber-400" data-value="<%= i %>" onclick="setOverallRating(<%= i %>)"></i>
                        <% } %>
                    </div>
                    <span id="ratingLabel" class="text-sm font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
                        5.0 - Excellent
                    </span>
                    <input type="hidden" name="rating" id="ratingInput" value="5" required>
                </div>
            </div>

            <!-- Specific Workplace Metrics -->
            <div class="space-y-4 border-b border-slate-100 pb-6">
                <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="ph-bold ph-sliders text-indigo-600"></i>
                    Rate Key Workplace Aspects <span class="text-rose-500">*</span>
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <!-- Mentorship Rating -->
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800">Mentorship Quality</span>
                            <span id="mentorshipVal" class="text-xs font-bold text-indigo-600">5 / 5</span>
                        </div>
                        <p class="text-[11px] text-slate-500">Guidance from senior engineers & mentors</p>
                        <input type="range" name="mentorshipRating" min="1" max="5" value="5" step="1"
                            oninput="document.getElementById('mentorshipVal').textContent = this.value + ' / 5'"
                            class="w-full accent-indigo-600 cursor-pointer">
                    </div>

                    <!-- Learning Curve -->
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800">Learning Curve</span>
                            <span id="learningVal" class="text-xs font-bold text-indigo-600">5 / 5</span>
                        </div>
                        <p class="text-[11px] text-slate-500">Real production work & technical growth</p>
                        <input type="range" name="learningRating" id="learningRatingInput" min="1" max="5" value="5" step="1"
                            oninput="document.getElementById('learningVal').textContent = this.value + ' / 5'; document.getElementById('learningCurveRatingInput').value = this.value;"
                            class="w-full accent-indigo-600 cursor-pointer">
                        <input type="hidden" name="learningCurveRating" id="learningCurveRatingInput" value="5">
                    </div>

                    <!-- Stipend Punctuality -->
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800">Stipend Punctuality</span>
                            <span id="stipendVal" class="text-xs font-bold text-indigo-600">5 / 5</span>
                        </div>
                        <p class="text-[11px] text-slate-500">Timely and transparent stipend disbursement</p>
                        <input type="range" name="stipendPunctualityRating" min="1" max="5" value="5" step="1"
                            oninput="document.getElementById('stipendVal').textContent = this.value + ' / 5'"
                            class="w-full accent-indigo-600 cursor-pointer">
                    </div>

                    <!-- Work-Life Balance -->
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800">Work-Life Balance</span>
                            <span id="workLifeVal" class="text-xs font-bold text-indigo-600">5 / 5</span>
                        </div>
                        <p class="text-[11px] text-slate-500">Reasonable working hours & flexibility</p>
                        <input type="range" name="workLifeBalanceRating" min="1" max="5" value="5" step="1"
                            oninput="document.getElementById('workLifeVal').textContent = this.value + ' / 5'"
                            class="w-full accent-indigo-600 cursor-pointer">
                    </div>

                </div>
            </div>

            <!-- Written Feedback Fields -->
            <div class="space-y-4">
                <div>
                    <label for="title" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Review Headline <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="title" name="title" required maxlength="120"
                        placeholder="e.g. Great mentorship, challenging projects, and on-time stipend"
                        class="w-full px-3.5 py-2.5 text-xs sm:text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800">
                </div>

                <div>
                    <label for="pros" class="block text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1 flex items-center gap-1">
                        <i class="ph-bold ph-plus-circle text-emerald-600"></i>
                        Pros <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="pros" name="pros" required rows="3" maxlength="2000"
                        placeholder="What did you like most? (e.g. Supportive mentors, interesting tech stack, helpful code reviews, supportive team culture)"
                        class="w-full px-3.5 py-2.5 text-xs sm:text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-slate-800"></textarea>
                </div>

                <div>
                    <label for="cons" class="block text-xs font-bold text-rose-800 uppercase tracking-wider mb-1 flex items-center gap-1">
                        <i class="ph-bold ph-minus-circle text-rose-600"></i>
                        Cons <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="cons" name="cons" required rows="3" maxlength="2000"
                        placeholder="What were the downsides or challenges? (e.g. Documentation was lacking, fast-paced sprint deadlines, occasional extra hours)"
                        class="w-full px-3.5 py-2.5 text-xs sm:text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500 text-slate-800"></textarea>
                </div>

                <div>
                    <label for="adviceToManagement" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center gap-1">
                        <i class="ph-bold ph-lightbulb text-amber-500"></i>
                        Advice to Management <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <textarea id="adviceToManagement" name="adviceToManagement" rows="2" maxlength="2000"
                        placeholder="Constructive ideas for the company to improve future internship cohorts..."
                        class="w-full px-3.5 py-2.5 text-xs sm:text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800"></textarea>
                </div>
            </div>

            <!-- Anonymous Option Toggle -->
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl flex items-start gap-3">
                <input type="checkbox" id="isAnonymous" name="isAnonymous" value="true"
                    class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 mt-0.5 cursor-pointer">
                <label for="isAnonymous" class="text-xs text-slate-700 cursor-pointer">
                    <span class="font-bold text-slate-900 block">Post Anonymously</span>
                    <span class="text-[11px] text-slate-500 block mt-0.5">
                        Your name and avatar will be hidden. Your review will display as "Verified Intern - <%= eligibility.roleTitle %>" so you can share honest feedback safely.
                    </span>
                </label>
            </div>

            <!-- Submit Button & Action Bar -->
            <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                <a href="/company/<%= company._id %>/profile" class="text-xs font-semibold text-slate-600 hover:text-slate-800">
                    Cancel & Return
                </a>
                <button type="submit"
                    class="w-full sm:w-auto px-7 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                    <i class="ph-bold ph-paper-plane-tilt text-base"></i>
                    Publish Verified Review
                </button>
            </div>

        </form>

    </div>

</div>

<script>
    var ratingLabels = {
        1: '1.0 - Needs Significant Improvement',
        2: '2.0 - Below Average',
        3: '3.0 - Average Experience',
        4: '4.0 - Very Good',
        5: '5.0 - Excellent Experience'
    };

    function setOverallRating(val) {
        document.getElementById('ratingInput').value = val;
        var label = document.getElementById('ratingLabel');
        if (label) {
            label.textContent = ratingLabels[val] || (val + '.0');
        }

        var stars = document.querySelectorAll('#overallStarContainer .star-btn');
        stars.forEach(function(star) {
            var sVal = parseInt(star.getAttribute('data-value'), 10);
            if (sVal <= val) {
                star.classList.remove('text-slate-300');
                star.classList.add('text-amber-400');
            } else {
                star.classList.remove('text-amber-400');
                star.classList.add('text-slate-300');
            }
        });
    }
</script>
