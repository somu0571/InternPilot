<% layout('layouts/boilerplate') %>

<%
    const currentVerificationStatus = typeof verificationStatus === 'string'
        ? verificationStatus
        : (companyDetails && companyDetails.isVerified ? 'approved' : 'pending');
    const verificationDocuments = companyDetails && Array.isArray(companyDetails.verificationDocuments)
        ? companyDetails.verificationDocuments
        : [];
%>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- Top Navigation / Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <a href="/company/dashboard" class="text-indigo-600 hover:text-indigo-800 font-semibold flex items-center gap-1 transition-colors">
                    <i class="ph-bold ph-arrow-left"></i> Back to Dashboard
                </a>
                <span>/</span>
                <span class="font-medium text-slate-700">Company Profile</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                Company Profile Settings
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
                Establish credibility with prospective student applicants by keeping your official company profile complete and verified.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <a href="/company/<%= company._id %>/profile" target="_blank"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 shadow-xs transition-all"
                title="Preview how candidates see your profile">
                <i class="ph-bold ph-arrow-square-out text-sm text-indigo-600"></i>
                <span>View Public Profile</span>
            </a>
            <a href="/company/dashboard"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-all">
                <i class="ph-bold ph-squares-four text-sm"></i>
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    <!-- Quick Overview Card -->
    <div class="bg-gradient-to-r from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-2xl p-6 sm:p-8 shadow-md relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 relative z-10">
            <div class="flex items-center gap-4">
                <div class="relative shrink-0">
                    <% if (companyDetails.logo) { %>
                        <img id="header-logo-preview" src="<%= companyDetails.logo %>" alt="<%= companyDetails.companyName || company.name %>"
                            class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover bg-white p-1 border-2 border-indigo-400/40 shadow-sm" />
                    <% } else { %>
                        <div id="header-logo-preview" class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-indigo-700/60 border-2 border-indigo-400/40 text-white flex items-center justify-center text-3xl font-extrabold uppercase shadow-sm">
                            <%= (companyDetails.companyName || company.name || 'C').charAt(0) %>
                        </div>
                    <% } %>
                </div>

                <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-xl sm:text-2xl font-bold tracking-tight">
                            <%= companyDetails.companyName || company.name %>
                        </h2>
                        <% if (currentVerificationStatus === 'approved') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                                <i class="ph-bold ph-check-circle"></i> Verified
                            </span>
                        <% } else if (currentVerificationStatus === 'rejected') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/20 text-rose-100 border border-rose-300/30">
                                <i class="ph-bold ph-x-circle"></i> Verification Rejected
                            </span>
                        <% } else if (currentVerificationStatus === 'suspended') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/20 text-rose-100 border border-rose-300/30">
                                <i class="ph-bold ph-warning-octagon"></i> Company Suspended
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-400/30">
                                <i class="ph-bold ph-clock"></i> Verification Pending
                            </span>
                        <% } %>
                    </div>
                    <p class="text-xs text-indigo-200/90 flex items-center gap-2 flex-wrap">
                        <span><i class="ph-bold ph-buildings mr-1"></i><%= companyDetails.industry || 'Industry Not Set' %></span>
                        <span>&bull;</span>
                        <span><i class="ph-bold ph-users mr-1"></i><%= companyDetails.companySize || 'Size Not Set' %></span>
                        <span>&bull;</span>
                        <span><i class="ph-bold ph-map-pin mr-1"></i><%= companyDetails.location || 'Location Not Set' %></span>
                    </p>
                    <p class="text-[11px] text-slate-300 pt-1">
                        Active Opportunities Posted: <strong class="text-white"><%= typeof companyInternshipsCount !== 'undefined' ? companyInternshipsCount : 0 %></strong>
                    </p>
                </div>
            </div>

            <div class="sm:text-right shrink-0">
                <span class="text-xs text-indigo-200 block">Logged in as</span>
                <span class="text-sm font-semibold text-white capitalize"><%= user.name %> (<%= user.role %>)</span>
                <% if (user.role === 'recruiter') { %>
                    <span class="block text-[11px] text-slate-400 mt-0.5">Editing company profile as team member</span>
                <% } %>
            </div>
        </div>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Employer verification</p>
                <h3 class="mt-1 text-base font-bold text-slate-900">
                    <% if (currentVerificationStatus === 'approved') { %>Your company is verified<% } else if (currentVerificationStatus === 'rejected') { %>Verification needs attention<% } else if (currentVerificationStatus === 'suspended') { %>Publishing is suspended<% } else { %>Verification is pending<% } %>
                </h3>
                <p class="mt-1 max-w-2xl text-xs text-slate-500">
                    <% if (currentVerificationStatus === 'approved') { %>You can publish and resume internship opportunities.<% } else { %>You can save drafts, but an admin must approve your company before opportunities can be published or resumed.<% } %>
                </p>
                <% if (companyDetails.verificationReason) { %>
                    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900"><span class="font-semibold">Admin review:</span> <%= companyDetails.verificationReason %></p>
                <% } %>
            </div>
            <span class="w-fit rounded-full px-3 py-1 text-xs font-bold <%= currentVerificationStatus === 'approved' ? 'bg-emerald-100 text-emerald-700' : currentVerificationStatus === 'pending' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-700' %>"><%= currentVerificationStatus.charAt(0).toUpperCase() + currentVerificationStatus.slice(1) %></span>
        </div>

        <% if (verificationDocuments.length) { %>
            <div class="mt-4 border-t border-slate-100 pt-4">
                <p class="text-xs font-semibold text-slate-700">Submitted documents</p>
                <ul class="mt-2 space-y-1 text-xs">
                    <% verificationDocuments.forEach(document => { %>
                        <li><a href="<%= document.fileUrl %>" target="_blank" rel="noopener noreferrer" class="text-indigo-700 hover:underline"><i class="ph-bold ph-file-arrow-up mr-1"></i><%= document.fileName %></a></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (user.role === 'company') { %>
            <form action="/company/verification/documents" method="POST" enctype="multipart/form-data" class="mt-5 border-t border-slate-100 pt-5">
                <label for="verification-documents" class="block text-xs font-bold text-slate-700">Supporting documents</label>
                <p class="mt-1 text-[11px] text-slate-500">Upload registration or incorporation evidence. PDF, PNG, JPG; up to 5 files, 5MB each.</p>
                <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <input id="verification-documents" name="documents" type="file" multiple required accept="application/pdf,image/png,image/jpeg" class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" />
                    <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-indigo-700"><i class="ph-bold ph-upload-simple"></i> Submit for review</button>
                </div>
            </form>
        <% } %>
    </section>

    <!-- Main Profile Edit Form Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div>
                <h3 class="text-base font-bold text-slate-900">Company Information</h3>
                <p class="text-xs text-slate-500 mt-0.5">Fill in all details to build trust and increase student application rates.</p>
            </div>
            <span class="text-xs text-slate-400 font-medium">* Required fields</span>
        </div>

        <form action="/company/profile" method="POST" enctype="multipart/form-data" class="p-6 sm:p-8 space-y-6">

            <!-- Logo Upload Section -->
            <div class="space-y-3 pb-6 border-b border-slate-100">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                    Company Logo
                </label>
                <div class="flex flex-col sm:flex-row sm:items-center gap-5">
                    <div class="relative shrink-0">
                        <% if (companyDetails.logo) { %>
                            <img id="form-logo-preview" src="<%= companyDetails.logo %>" alt="Company Logo"
                                class="w-24 h-24 rounded-2xl object-cover border border-slate-200 bg-slate-50 p-1 shadow-xs" />
                        <% } else { %>
                            <div id="form-logo-preview" class="w-24 h-24 rounded-2xl bg-indigo-50 border border-dashed border-indigo-300 text-indigo-700 flex items-center justify-center text-3xl font-extrabold uppercase shadow-xs">
                                <%= (companyDetails.companyName || company.name || 'C').charAt(0) %>
                            </div>
                        <% } %>
                    </div>

                    <div class="space-y-2 flex-1">
                        <div class="flex items-center gap-3">
                            <label class="cursor-pointer inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg border border-indigo-200 transition-colors">
                                <i class="ph-bold ph-upload-simple text-sm"></i>
                                <span>Upload New Logo</span>
                                <input type="file" id="logo-input" name="logo" accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml" class="hidden" onchange="previewSelectedLogo(event)" />
                            </label>

                            <% if (companyDetails.logo) { %>
                                <button type="button" onclick="removeCurrentLogo()" class="inline-flex items-center gap-1 text-xs text-rose-600 hover:text-rose-800 font-medium hover:underline">
                                    <i class="ph-bold ph-trash"></i> Remove Logo
                                </button>
                            <% } %>
                        </div>
                        <input type="hidden" id="remove-logo-input" name="removeLogo" value="false" />

                        <p class="text-[11px] text-slate-500">
                            Supported file formats: <strong>PNG, JPG, JPEG, WEBP, or SVG</strong>. Maximum size: <strong>3MB</strong>. A square ratio (1:1) is recommended.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Basic Details Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Company Name -->
                <div>
                    <label for="companyName" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Company Name <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="companyName" name="companyName" required
                        value="<%= companyDetails.companyName || company.name || '' %>"
                        placeholder="e.g. Acme Technologies Pvt Ltd"
                        class="w-full px-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
                    <p class="text-[11px] text-slate-400 mt-1">This name will be displayed on all your public internship listings.</p>
                </div>

                <!-- Industry -->
                <div>
                    <label for="industry" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Industry / Sector
                    </label>
                    <% const currentIndustry = companyDetails.industry || ''; %>
                    <select id="industry" name="industry"
                        class="w-full px-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs bg-white">
                        <option value="">Select an Industry</option>
                        <% const industries = [
                            'IT & Software Services',
                            'Finance & Banking',
                            'Healthcare & Pharmaceuticals',
                            'Education & EdTech',
                            'Manufacturing & Engineering',
                            'E-commerce & Retail',
                            'Marketing, Advertising & Media',
                            'Beauty, Wellness & Skincare',
                            'Consulting & Professional Services',
                            'Agriculture & AgriTech',
                            'Telecommunications',
                            'Automotive',
                            'Logistics & Supply Chain',
                            'Other'
                        ]; %>
                        <% industries.forEach(ind => { %>
                            <option value="<%= ind %>" <%= currentIndustry.toLowerCase() === ind.toLowerCase() ? 'selected' : '' %>><%= ind %></option>
                        <% }) %>
                        <% if (currentIndustry && !industries.some(ind => ind.toLowerCase() === currentIndustry.toLowerCase())) { %>
                            <option value="<%= currentIndustry %>" selected><%= currentIndustry %></option>
                        <% } %>
                    </select>
                </div>

                <!-- Company Size -->
                <div>
                    <label for="companySize" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Company Size (Employees)
                    </label>
                    <% const currentSize = companyDetails.companySize || ''; %>
                    <select id="companySize" name="companySize"
                        class="w-full px-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs bg-white">
                        <option value="">Select Company Size</option>
                        <option value="1-10 Employees" <%= currentSize === '1-10 Employees' ? 'selected' : '' %>>1-10 Employees (Startup / Seed)</option>
                        <option value="11-50 Employees" <%= currentSize === '11-50 Employees' ? 'selected' : '' %>>11-50 Employees (Early Stage)</option>
                        <option value="51-200 Employees" <%= currentSize === '51-200 Employees' ? 'selected' : '' %>>51-200 Employees (Growing SME)</option>
                        <option value="201-500 Employees" <%= currentSize === '201-500 Employees' ? 'selected' : '' %>>201-500 Employees (Mid-market)</option>
                        <option value="501-1000 Employees" <%= currentSize === '501-1000 Employees' ? 'selected' : '' %>>501-1000 Employees (Large)</option>
                        <option value="1000+ Employees" <%= currentSize === '1000+ Employees' ? 'selected' : '' %>>1000+ Employees (Enterprise)</option>
                    </select>
                </div>

                <!-- Website URL -->
                <div>
                    <label for="website" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Company Website URL
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="ph-bold ph-globe text-sm"></i>
                        </span>
                        <input type="text" id="website" name="website"
                            value="<%= companyDetails.website || '' %>"
                            placeholder="https://www.example.com"
                            class="w-full pl-9 pr-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">Must be a valid web link (e.g., https://example.com)</p>
                </div>

                <!-- Location / Headquarters -->
                <div>
                    <label for="location" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Headquarters / Location
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="ph-bold ph-map-pin text-sm text-rose-500"></i>
                        </span>
                        <input type="text" id="location" name="location"
                            value="<%= companyDetails.location || '' %>"
                            placeholder="e.g. Mumbai, Maharashtra"
                            class="w-full pl-9 pr-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
                    </div>
                </div>

                <!-- Corporate Identification Number (CIN) -->
                <div>
                    <label for="cin" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Corporate Identification Number (CIN)
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="ph-bold ph-certificate text-sm text-amber-500"></i>
                        </span>
                        <input type="text" id="cin" name="cin"
                            value="<%= companyDetails.cin || '' %>"
                            placeholder="e.g. U74999MH2018PTC312456"
                            <%= user.role !== 'company' && user.role !== 'admin' ? 'readonly' : '' %>
                            class="w-full pl-9 pr-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs <%= user.role !== 'company' && user.role !== 'admin' ? 'bg-slate-50 cursor-not-allowed' : '' %>" />
                    </div>
                    <% if (user.role !== 'company' && user.role !== 'admin') { %>
                        <p class="text-[11px] text-slate-400 mt-1">CIN can only be edited by company owner.</p>
                    <% } %>
                </div>

                <!-- Contact Email -->
                <div>
                    <label for="contactEmail" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Official Contact Email
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="ph-bold ph-envelope-simple text-sm text-indigo-500"></i>
                        </span>
                        <input type="email" id="contactEmail" name="contactEmail"
                            value="<%= companyDetails.contactEmail || '' %>"
                            placeholder="e.g. careers@company.com"
                            class="w-full pl-9 pr-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
                    </div>
                </div>

                <!-- Contact Phone -->
                <div>
                    <label for="contactPhone" class="block text-xs font-bold text-slate-700 mb-1.5">
                        Official Contact Phone / Helpline
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="ph-bold ph-phone text-sm text-emerald-500"></i>
                        </span>
                        <input type="text" id="contactPhone" name="contactPhone"
                            value="<%= companyDetails.contactPhone || '' %>"
                            placeholder="e.g. +91 98765 43210"
                            class="w-full pl-9 pr-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
                    </div>
                </div>
            </div>

            <!-- Additional Contact Information -->
            <div>
                <label for="contactInformation" class="block text-xs font-bold text-slate-700 mb-1.5">
                    Additional Contact & Support Notes
                </label>
                <input type="text" id="contactInformation" name="contactInformation"
                    value="<%= companyDetails.contactInformation || '' %>"
                    placeholder="e.g. Available Mon-Fri 10am-6pm IST for recruitment inquiries"
                    class="w-full px-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs" />
            </div>

            <!-- About Company / Description -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="description" class="block text-xs font-bold text-slate-700">
                        About the Company / Description
                    </label>
                    <span id="desc-char-count" class="text-[11px] text-slate-400">0 / 2000 chars</span>
                </div>
                <textarea id="description" name="description" rows="5" maxlength="2000"
                    placeholder="Introduce your organization to prospective applicants. Describe your core mission, work environment, technologies, and what interns can expect to learn."
                    oninput="updateCharCount(this)"
                    class="w-full px-3.5 py-2.5 text-xs text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-2xs leading-relaxed"><%= companyDetails.description || '' %></textarea>
                <p class="text-[11px] text-slate-400 mt-1">A well-written description significantly improves student trust and application quality.</p>
            </div>

            <!-- Form Action Buttons -->
            <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-end gap-3">
                <a href="/company/dashboard"
                    class="px-5 py-2.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg text-center transition-colors">
                    Cancel
                </a>
                <button type="submit" id="save-profile-btn"
                    class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition-all">
                    <i class="ph-bold ph-floppy-disk text-sm"></i>
                    <span>Save Profile Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function updateCharCount(el) {
        const count = el.value.length;
        document.getElementById('desc-char-count').textContent = count + ' / 2000 chars';
    }

    // Initialize character count on load
    document.addEventListener('DOMContentLoaded', () => {
        const descEl = document.getElementById('description');
        if (descEl) updateCharCount(descEl);
    });

    function previewSelectedLogo(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;

        if (file.size > 3 * 1024 * 1024) {
            alert('File is too large! Please choose an image smaller than 3MB.');
            event.target.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const previewEl = document.getElementById('form-logo-preview');
            if (previewEl.tagName.toLowerCase() === 'img') {
                previewEl.src = e.target.result;
            } else {
                const img = document.createElement('img');
                img.id = 'form-logo-preview';
                img.src = e.target.result;
                img.alt = 'Company Logo';
                img.className = 'w-24 h-24 rounded-2xl object-cover border border-slate-200 bg-slate-50 p-1 shadow-xs';
                previewEl.parentNode.replaceChild(img, previewEl);
            }
            document.getElementById('remove-logo-input').value = 'false';
        };
        reader.readAsDataURL(file);
    }

    function removeCurrentLogo() {
        if (!confirm('Are you sure you want to remove the current company logo?')) return;
        document.getElementById('remove-logo-input').value = 'true';
        document.getElementById('logo-input').value = '';
        const previewEl = document.getElementById('form-logo-preview');
        const initial = (document.getElementById('companyName').value || 'C').charAt(0).toUpperCase();

        const placeholder = document.createElement('div');
        placeholder.id = 'form-logo-preview';
        placeholder.className = 'w-24 h-24 rounded-2xl bg-indigo-50 border border-dashed border-indigo-300 text-indigo-700 flex items-center justify-center text-3xl font-extrabold uppercase shadow-xs';
        placeholder.textContent = initial;
        previewEl.parentNode.replaceChild(placeholder, previewEl);
    }
</script>
