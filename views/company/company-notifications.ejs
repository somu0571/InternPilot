<% layout('layouts/boilerplate') %>

    <% const unreadCount = notifications.filter(notification => !notification.isRead).length; %>

    <div class="max-w-4xl mx-auto space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-5">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Company Notifications</h1>
                <p class="mt-1 text-sm text-slate-500">
                    Updates about applications and upcoming deadlines.
                </p>
            </div>

            <% if (unreadCount > 0) { %>
                <form action="/company/notifications/read-all" method="POST">
                    <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50 px-3.5 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-100 transition-colors">
                        <i class="ph-bold ph-checks text-base"></i>
                        Mark all as read
                    </button>
                </form>
            <% } %>
        </div>

        <% if (notifications.length === 0) { %>
            <div class="rounded-xl border border-slate-200 bg-white px-6 py-14 text-center shadow-sm">
                <i class="ph-bold ph-bell-ringing text-4xl text-slate-300"></i>
                <h2 class="mt-3 text-base font-bold text-slate-800">You are all caught up</h2>
                <p class="mt-1 text-sm text-slate-500">New alerts about applications and deadlines will appear here.</p>
                <a href="/company/dashboard"
                    class="mt-5 inline-flex rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-700 transition-colors">
                    Return to dashboard
                </a>
            </div>
        <% } else { %>
            <div class="space-y-3">
                <% notifications.forEach(notification => { %>
                    <% const typeStyle = notification.type === 'new_application'
                        ? { icon: 'ph-file-text', iconClass: 'bg-indigo-100 text-indigo-700', label: 'New Application' }
                        : notification.type === 'candidate_withdrawal'
                            ? { icon: 'ph-arrow-u-up-left', iconClass: 'bg-rose-100 text-rose-700', label: 'Withdrawal' }
                            : notification.type === 'approaching_deadline'
                                ? { icon: 'ph-hourglass', iconClass: 'bg-amber-100 text-amber-700', label: 'Deadline' }
                                : notification.type === 'high_application_volume'
                                    ? { icon: 'ph-trend-up', iconClass: 'bg-emerald-100 text-emerald-700', label: 'High Volume' }
                                    : notification.type === 'upcoming_interview'
                                        ? { icon: 'ph-calendar-check', iconClass: 'bg-blue-100 text-blue-700', label: 'Interview' }
                                        : notification.type === 'offer_accepted'
                                            ? { icon: 'ph-seal-check', iconClass: 'bg-emerald-100 text-emerald-700', label: 'Offer accepted' }
                                            : notification.type === 'offer_declined'
                                                ? { icon: 'ph-x-circle', iconClass: 'bg-rose-100 text-rose-700', label: 'Offer declined' }
                                                : notification.type === 'offer_expired'
                                                    ? { icon: 'ph-hourglass-low', iconClass: 'bg-amber-100 text-amber-700', label: 'Offer expired' }
                                        : { icon: 'ph-bell', iconClass: 'bg-slate-100 text-slate-700', label: 'Update' }; %>

                    <article class="flex gap-4 rounded-xl border p-4 sm:p-5 shadow-sm <%= notification.isRead ? 'border-slate-200 bg-white' : 'border-indigo-200 bg-indigo-50/40' %>">
                        <div class="shrink-0 h-10 w-10 rounded-full flex items-center justify-center <%= typeStyle.iconClass %>">
                            <i class="ph-bold <%= typeStyle.icon %> text-lg"></i>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1.5">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h2 class="font-bold text-slate-900"><%= notification.title %></h2>
                                        <% if (!notification.isRead) { %>
                                            <span class="h-2 w-2 rounded-full bg-indigo-600" aria-label="Unread"></span>
                                        <% } %>
                                    </div>
                                    <span class="mt-1 inline-block text-[10px] uppercase tracking-wide font-bold text-slate-500"><%= typeStyle.label %></span>
                                </div>
                                <time class="shrink-0 text-xs text-slate-400" datetime="<%= notification.createdAt.toISOString() %>">
                                    <%= notification.createdAt.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                </time>
                            </div>

                            <p class="mt-2 text-sm leading-6 text-slate-600"><%= notification.message %></p>

                            <div class="mt-4 flex flex-wrap items-center gap-3">
                                <a href="<%= notification.link %>" class="text-xs font-bold text-indigo-700 hover:text-indigo-800 hover:underline">
                                    View details &rarr;
                                </a>
                                <% if (!notification.isRead) { %>
                                    <form action="/company/notifications/<%= notification._id %>/read" method="POST">
                                        <button type="submit" class="text-xs font-semibold text-slate-500 hover:text-slate-700">
                                            Mark as read
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
