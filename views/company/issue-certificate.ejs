<% layout('layouts/boilerplate') %>

<div class="max-w-6xl mx-auto space-y-6">

    <!-- Breadcrumb Navigation -->
    <div class="flex items-center gap-2 text-xs">
        <a href="/company/applications/<%= application._id %>/candidate"
            class="font-semibold text-indigo-600 hover:underline flex items-center gap-1">
            <i class="ph-bold ph-arrow-left text-sm"></i> Back to Candidate Profile
        </a>
        <span class="text-slate-300">&bull;</span>
        <span class="text-slate-500"><%= internship.title %></span>
        <span class="text-slate-300">&bull;</span>
        <span class="text-slate-700 font-semibold">Issue Credential</span>
    </div>

    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
            <i class="ph-bold ph-certificate text-9xl text-white"></i>
        </div>
        <div class="relative z-10 max-w-3xl space-y-3">
            <div class="inline-flex items-center gap-2 bg-indigo-500/20 text-indigo-200 border border-indigo-400/30 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-sm">
                <i class="ph-bold ph-seal-check text-amber-400"></i>
                Official PMIS Credentialing
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Issue Internship Certificate & LOR
            </h1>
            <p class="text-slate-300 text-sm leading-relaxed">
                Officially recognize <strong><%= candidate.name %></strong>'s contributions for their internship tenure at <strong><%= cName %></strong>. This generates an authentic, tamper-proof Certificate of Completion with a public verification QR code and an optional Letter of Recommendation.
            </p>
        </div>
    </div>

    <!-- Main Grid: Form + Live Preview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Issuance Form (7 cols) -->
        <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">

            <form action="/company/applications/<%= application._id %>/certificate/issue" method="POST" id="certificateForm" class="space-y-6">

                <!-- Section 1: Candidate & Role Summary -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <% if (candidate.avatar) { %>
                            <img src="<%= candidate.avatar %>" alt="<%= candidate.name %>" class="w-12 h-12 rounded-full object-cover border border-slate-200">
                        <% } else { %>
                            <div class="w-12 h-12 bg-indigo-600 text-white font-bold text-lg rounded-full flex items-center justify-center">
                                <%= candidate.name ? candidate.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                        <% } %>
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm"><%= candidate.name %></h3>
                            <p class="text-xs text-slate-500"><%= candidate.email || 'Candidate' %></p>
                            <span class="inline-block mt-1 text-[11px] font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">
                                <%= internship.title %>
                            </span>
                        </div>
                    </div>
                    <div class="text-xs text-slate-500 sm:text-right">
                        <span class="block font-medium text-slate-400">Host Company</span>
                        <span class="font-bold text-slate-700"><%= cName %></span>
                    </div>
                </div>

                <!-- Section 2: Dates & Duration -->
                <div class="space-y-4 pt-2">
                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2">
                        <i class="ph-bold ph-calendar text-indigo-600"></i>
                        Tenure & Completion Details
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="completionDate" class="block text-xs font-semibold text-slate-700 mb-1">
                                Completion Date <span class="text-rose-500">*</span>
                            </label>
                            <% const todayStr = new Date().toISOString().split('T')[0]; %>
                            <input type="date" id="completionDate" name="completionDate" required value="<%= todayStr %>"
                                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                            <span class="text-[11px] text-slate-400 mt-1 block">Date when the internship successfully finished</span>
                        </div>

                        <div>
                            <label for="duration" class="block text-xs font-semibold text-slate-700 mb-1">
                                Tenure Duration <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="duration" name="duration" required
                                value="<%= internship.duration || '3 Months' %>"
                                placeholder="e.g. 3 Months, 6 Months, 12 Weeks"
                                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                            <span class="text-[11px] text-slate-400 mt-1 block">Total duration completed by candidate</span>
                        </div>
                    </div>

                    <div>
                        <label for="startDate" class="block text-xs font-semibold text-slate-700 mb-1">
                            Start Date <span class="text-slate-400 font-normal">(Optional)</span>
                        </label>
                        <% const startStr = application.appliedAt ? new Date(application.appliedAt).toISOString().split('T')[0] : ''; %>
                        <input type="date" id="startDate" name="startDate" value="<%= startStr %>"
                            class="w-full sm:w-1/2 px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                    </div>
                </div>

                <!-- Section 3: Performance & Skills -->
                <div class="space-y-4 pt-2">
                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2">
                        <i class="ph-bold ph-star text-amber-500"></i>
                        Performance & Key Competencies
                    </h2>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-2">
                            Performance Rating <span class="text-rose-500">*</span>
                        </label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <% const ratings = [
                                { value: 'Outstanding', desc: 'Top 5% Performance', color: 'emerald' },
                                { value: 'Exceeds Expectations', desc: 'Exceeded deliverables', color: 'indigo' },
                                { value: 'Very Good', desc: 'Met & excelled goals', color: 'blue' },
                                { value: 'Good', desc: 'Satisfactory completion', color: 'slate' }
                            ]; %>
                            <% ratings.forEach((r, idx) => { %>
                                <label class="border border-slate-200 rounded-xl p-3 cursor-pointer hover:border-indigo-300 transition-all flex flex-col justify-between text-center relative group has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/40 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600">
                                    <input type="radio" name="performanceRating" value="<%= r.value %>" <%= idx === 0 ? 'checked' : '' %> class="sr-only">
                                    <span class="block font-bold text-xs text-slate-800 mb-1"><%= r.value %></span>
                                    <span class="block text-[10px] text-slate-500"><%= r.desc %></span>
                                </label>
                            <% }); %>
                        </div>
                    </div>

                    <div>
                        <label for="skills" class="block text-xs font-semibold text-slate-700 mb-1">
                            Demonstrated Skills & Technologies
                        </label>
                        <input type="text" id="skills" name="skills"
                            value="<%= prefilledSkills.join(', ') %>"
                            placeholder="e.g. Node.js, Express, MongoDB, UI Design, Problem Solving"
                            class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                        <span class="text-[11px] text-slate-400 mt-1 block">Separate skills with commas. These will appear as verified competencies on the certificate.</span>

                        <% if (prefilledSkills.length > 0) { %>
                            <div class="flex flex-wrap gap-1.5 mt-2">
                                <span class="text-[11px] text-slate-400 mr-1 self-center">Suggestions:</span>
                                <% prefilledSkills.forEach(s => { %>
                                    <button type="button" onclick="appendSkill('<%= s %>')"
                                        class="px-2 py-0.5 text-[11px] bg-slate-100 hover:bg-indigo-100 text-slate-700 hover:text-indigo-700 rounded transition-colors">
                                        + <%= s %>
                                    </button>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Section 4: Optional Letter of Recommendation -->
                <div class="space-y-4 pt-2">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="ph-bold ph-file-text text-indigo-600"></i>
                            Letter of Recommendation (Optional)
                        </h2>
                        <span class="text-[11px] text-slate-400">Attached as official recommendation sheet</span>
                    </div>

                    <div>
                        <label for="letterOfRecommendation" class="block text-xs font-semibold text-slate-700 mb-1">
                            Recommendation Text
                        </label>
                        <textarea id="letterOfRecommendation" name="letterOfRecommendation" rows="5"
                            placeholder="Write an official recommendation highlighting <%= candidate.name %>'s key accomplishments, problem-solving skills, work ethic, and suitability for future roles or academic credit..."
                            class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700"></textarea>
                        <div class="flex items-center justify-between text-[11px] text-slate-400 mt-1">
                            <span>Markdown paragraphs and line breaks are preserved.</span>
                            <button type="button" onclick="insertRecommendationTemplate()" class="text-indigo-600 font-semibold hover:underline">
                                Insert Standard Template
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Section 5: Authorized Signatory Details -->
                <div class="space-y-4 pt-2">
                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2">
                        <i class="ph-bold ph-pen-nib text-indigo-600"></i>
                        Authorized Signatory
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="signatoryName" class="block text-xs font-semibold text-slate-700 mb-1">
                                Signatory Full Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="signatoryName" name="signatoryName" required
                                value="<%= user.name || '' %>"
                                placeholder="e.g. Dr. Rajesh Sharma"
                                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                        </div>

                        <div>
                            <label for="signatoryTitle" class="block text-xs font-semibold text-slate-700 mb-1">
                                Designation / Role Title <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="signatoryTitle" name="signatoryTitle" required
                                value="Head of Talent Acquisition & Mentorship"
                                placeholder="e.g. Director of Engineering / HR Head"
                                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700">
                        </div>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <a href="/company/applications/<%= application._id %>/candidate"
                        class="text-xs font-semibold text-slate-600 hover:text-slate-800 transition-colors">
                        Cancel & Return
                    </a>
                    <button type="submit"
                        class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                        <i class="ph-bold ph-seal-check text-base"></i>
                        Issue Official Certificate & LOR
                    </button>
                </div>

            </form>
        </div>

        <!-- Right Column: Live Certificate Card Preview (5 cols) -->
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">

            <!-- Card Preview Container -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i class="ph-bold ph-eye text-indigo-600"></i>
                        Live Credential Preview
                    </span>
                    <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                        Tamper-Proof
                    </span>
                </div>

                <!-- Visual Miniature Certificate -->
                <div class="border-2 border-amber-300/80 rounded-xl p-5 bg-gradient-to-br from-amber-50/40 via-white to-indigo-50/30 shadow-inner relative space-y-3 font-sans text-center">
                    <!-- Top Ribbon -->
                    <div class="flex items-center justify-center gap-1.5 text-[10px] uppercase font-bold tracking-widest text-indigo-900 border-b border-indigo-100 pb-2">
                        <i class="ph-bold ph-seal text-amber-500"></i>
                        PMIS &bull; InternPilot Certified
                    </div>

                    <h4 class="text-base font-serif font-black tracking-tight text-slate-900 uppercase pt-1">
                        Certificate of Completion
                    </h4>
                    <p class="text-[11px] text-slate-500 italic">This is proudly presented to</p>

                    <p class="text-sm font-extrabold text-indigo-950 border-b border-indigo-200 pb-1 inline-block px-4">
                        <%= candidate.name %>
                    </p>

                    <p class="text-[11px] text-slate-600 leading-relaxed px-2">
                        for successfully completing the internship program as<br>
                        <strong class="text-slate-800"><%= internship.title %></strong><br>
                        at <span class="font-semibold text-slate-800"><%= cName %></span>
                    </p>

                    <div class="flex items-center justify-center gap-2 pt-1">
                        <span id="previewRating" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                            Rating: Outstanding
                        </span>
                        <span id="previewDuration" class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                            <%= internship.duration || '3 Months' %>
                        </span>
                    </div>

                    <!-- Seal & Code Footer -->
                    <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-left text-[9px] text-slate-500">
                        <div>
                            <span class="block font-mono font-bold text-slate-700">ID: IP-<%= new Date().getFullYear() %>-XXXX-XXXX</span>
                            <span>Publicly Verifiable</span>
                        </div>
                        <div class="w-8 h-8 bg-indigo-900 text-amber-400 rounded-full flex items-center justify-center text-xs font-bold shadow-sm">
                            <i class="ph-bold ph-seal-check"></i>
                        </div>
                    </div>
                </div>

                <!-- Credential Security Highlights -->
                <div class="space-y-2.5 text-xs text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h5 class="font-bold text-slate-800 text-xs flex items-center gap-1.5">
                        <i class="ph-bold ph-shield-check text-emerald-600"></i>
                        Credential Security Guarantees
                    </h5>
                    <ul class="space-y-1.5 text-[11px] text-slate-500">
                        <li class="flex items-start gap-1.5">
                            <i class="ph-bold ph-check text-emerald-500 mt-0.5"></i>
                            Cryptographically unique Certificate ID assigned automatically.
                        </li>
                        <li class="flex items-start gap-1.5">
                            <i class="ph-bold ph-check text-emerald-500 mt-0.5"></i>
                            Scannable QR code linking to public verification page.
                        </li>
                        <li class="flex items-start gap-1.5">
                            <i class="ph-bold ph-check text-emerald-500 mt-0.5"></i>
                            Accepted by universities for PMIS academic credit verification.
                        </li>
                    </ul>
                </div>
            </div>

        </div>

    </div>

</div>

<script>
    function appendSkill(skill) {
        var input = document.getElementById('skills');
        var current = input.value.trim();
        var skills = current ? current.split(',').map(function(s) { return s.trim(); }) : [];
        if (skills.indexOf(skill) === -1) {
            skills.push(skill);
            input.value = skills.join(', ');
        }
    }

    function insertRecommendationTemplate() {
        var candidateName = '<%= candidate.name %>';
        var role = '<%= internship.title %>';
        var company = '<%= cName %>';
        var textarea = document.getElementById('letterOfRecommendation');
        var template = 'It is my absolute pleasure to recommend ' + candidateName + ' for their remarkable performance and contributions during their internship as ' + role + ' with ' + company + '.\n\nThroughout their tenure, ' + candidateName + ' demonstrated exceptional technical aptitude, strong problem-solving skills, and commendable professional commitment. They effectively tackled complex project objectives, collaborated smoothly with team members, and showed eager initiative in learning new frameworks.\n\nI have no hesitation in recommending ' + candidateName + ' for future career opportunities and academic degree credits. They will undoubtedly be an invaluable asset to any high-performing engineering organization.';
        textarea.value = template;
    }

    // Dynamic Live Preview updates
    (function() {
        var durationInput = document.getElementById('duration');
        var previewDuration = document.getElementById('previewDuration');
        if (durationInput && previewDuration) {
            durationInput.addEventListener('input', function() {
                previewDuration.textContent = durationInput.value.trim() || 'Duration';
            });
        }

        var ratingInputs = document.querySelectorAll('input[name="performanceRating"]');
        var previewRating = document.getElementById('previewRating');
        if (ratingInputs && previewRating) {
            ratingInputs.forEach(function(radio) {
                radio.addEventListener('change', function() {
                    if (this.checked) {
                        previewRating.textContent = 'Rating: ' + this.value;
                    }
                });
            });
        }
    })();
</script>
