<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto space-y-8 py-4">

    <!-- Top Navigation / Breadcrumb -->
    <div class="flex items-center justify-between">
        <a href="/company/<%= company._id %>/profile" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
            <i class="ph-bold ph-arrow-left"></i> Back to <%= cName %> Profile
        </a>

        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'candidate') { %>
            <% if (typeof eligibility !== 'undefined' && eligibility && eligibility.existingReview) { %>
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl">
                    <i class="ph-bold ph-check-circle text-emerald-600"></i>
                    <span>You reviewed this company</span>
                </span>
            <% } else { %>
                <a href="/companies/<%= company._id %>/reviews/new"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm hover:shadow transition-all">
                    <i class="ph-bold ph-pencil-simple text-sm"></i>
                    <span>Write a Verified Review</span>
                </a>
            <% } %>
        <% } %>
    </div>

    <!-- Company Header Banner -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
            <% if (companyDetails.logo) { %>
                <img src="<%= companyDetails.logo %>" alt="<%= cName %> Logo"
                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border border-slate-200 bg-slate-50 p-1 shadow-xs shrink-0" />
            <% } else { %>
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-indigo-600 text-white flex items-center justify-center text-3xl font-extrabold uppercase shadow-xs shrink-0">
                    <%= cName.charAt(0) %>
                </div>
            <% } %>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                        <%= cName %>
                    </h1>
                    <% if (companyDetails.isVerified) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                            <i class="ph-bold ph-seal-check"></i> Verified Employer
                        </span>
                    <% } %>
                </div>
                <p class="text-xs text-slate-500 mt-1">
                    Verified Intern Reviews, Workplace Culture & Mentorship Insights
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
            <a href="/company/<%= company._id %>/profile"
                class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
                View Company Profile
            </a>
        </div>
    </div>

    <!-- Rating Analytics Dashboard Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <i class="ph-bold ph-chart-bar text-indigo-600"></i>
                <span>Workplace Ratings & Scorecard</span>
            </h2>
            <span class="text-xs text-slate-500 font-medium">
                Based on <%= stats.totalReviews %> <%= stats.totalReviews === 1 ? 'verified review' : 'verified reviews' %>
            </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

            <!-- Overall Big Score (4 cols) -->
            <div class="lg:col-span-4 text-center sm:text-left sm:border-r sm:border-slate-100 sm:pr-8 space-y-3">
                <div class="flex flex-col sm:flex-row items-center gap-4">
                    <span class="text-5xl font-black text-slate-900 tracking-tight">
                        <%= stats.totalReviews > 0 ? stats.averageRating : '—' %>
                    </span>
                    <div class="space-y-1 text-center sm:text-left">
                        <div class="flex items-center gap-1 text-amber-400 text-lg justify-center sm:justify-start">
                            <% const fullStars = Math.floor(stats.averageRating || 0); %>
                            <% for (let i = 1; i <= 5; i++) { %>
                                <i class="<%= i <= fullStars ? 'ph-fill' : 'ph-bold' %> ph-star"></i>
                            <% } %>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">out of 5.0 stars</p>
                    </div>
                </div>

                <% if (stats.totalReviews > 0) { %>
                    <div class="p-3 bg-emerald-50 border border-emerald-100 rounded-2xl flex items-center gap-2 text-xs font-bold text-emerald-800">
                        <i class="ph-bold ph-thumbs-up text-emerald-600 text-base"></i>
                        <span><%= stats.recommendRate %>% of interns recommend this company</span>
                    </div>
                <% } %>
            </div>

            <!-- Specific Workplace Aspects (4 cols) -->
            <div class="lg:col-span-4 space-y-3.5 sm:border-r sm:border-slate-100 sm:pr-8">
                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-bold text-slate-700">Mentorship Quality</span>
                        <span class="font-bold text-indigo-700"><%= stats.mentorshipAvg %> / 5</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (stats.mentorshipAvg / 5) * 100 %>%"></div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-bold text-slate-700">Learning Curve</span>
                        <span class="font-bold text-indigo-700"><%= stats.learningAvg %> / 5</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (stats.learningAvg / 5) * 100 %>%"></div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-bold text-slate-700">Stipend Punctuality</span>
                        <span class="font-bold text-indigo-700"><%= stats.stipendAvg %> / 5</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (stats.stipendAvg / 5) * 100 %>%"></div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-bold text-slate-700">Work-Life Balance</span>
                        <span class="font-bold text-indigo-700"><%= stats.workLifeAvg %> / 5</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (stats.workLifeAvg / 5) * 100 %>%"></div>
                    </div>
                </div>
            </div>

            <!-- Star Distribution Breakdown (4 cols) -->
            <div class="lg:col-span-4 space-y-2 text-xs">
                <% for (let star = 5; star >= 1; star--) { %>
                    <% const pct = (stats.distributionPercentages && stats.distributionPercentages[star]) || 0; %>
                    <% const count = (stats.distribution && stats.distribution[star]) || 0; %>
                    <a href="/companies/<%= company._id %>/reviews?rating=<%= star %>"
                        class="flex items-center gap-2 text-slate-600 hover:text-indigo-600 transition-colors group">
                        <span class="w-12 font-bold shrink-0"><%= star %> stars</span>
                        <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
                            <div class="bg-amber-400 group-hover:bg-amber-500 h-2 rounded-full transition-all" style="width: <%= pct %>%"></div>
                        </div>
                        <span class="w-8 text-right font-medium text-slate-400 shrink-0"><%= count %></span>
                    </a>
                <% } %>
            </div>

        </div>
    </div>

    <!-- Reviews Section: Filter & Sort + Review Cards -->
    <div class="space-y-6">

        <!-- Controls Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
            <div class="flex items-center gap-2 flex-wrap">
                <% const currentRatingFilter = typeof activeRatingFilter !== 'undefined' ? activeRatingFilter : null; %>
                <% const currentSort = typeof activeSort !== 'undefined' ? activeSort : 'newest'; %>
                <span class="text-xs font-bold text-slate-700">Filter by Rating:</span>
                <a href="/companies/<%= company._id %>/reviews"
                    class="px-3 py-1 rounded-full text-xs font-semibold <%= !currentRatingFilter ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %> transition-colors">
                    All (<%= stats.totalReviews %>)
                </a>
                <% for (let star = 5; star >= 1; star--) { %>
                    <a href="/companies/<%= company._id %>/reviews?rating=<%= star %>"
                        class="px-3 py-1 rounded-full text-xs font-semibold <%= currentRatingFilter === star ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %> transition-colors">
                        <%= star %>★ (<%= (stats.distribution && stats.distribution[star]) || 0 %>)
                    </a>
                <% } %>
            </div>

            <div class="flex items-center gap-2 self-end sm:self-auto">
                <span class="text-xs font-medium text-slate-500">Sort by:</span>
                <select onchange="location.href = this.value" class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg bg-white font-semibold text-slate-700">
                    <option value="/companies/<%= company._id %>/reviews?sort=newest<%= currentRatingFilter ? '&rating=' + currentRatingFilter : '' %>" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest First</option>
                    <option value="/companies/<%= company._id %>/reviews?sort=highest<%= currentRatingFilter ? '&rating=' + currentRatingFilter : '' %>" <%= currentSort === 'highest' ? 'selected' : '' %>>Highest Rated</option>
                    <option value="/companies/<%= company._id %>/reviews?sort=lowest<%= currentRatingFilter ? '&rating=' + currentRatingFilter : '' %>" <%= currentSort === 'lowest' ? 'selected' : '' %>>Lowest Rated</option>
                    <option value="/companies/<%= company._id %>/reviews?sort=helpful<%= currentRatingFilter ? '&rating=' + currentRatingFilter : '' %>" <%= currentSort === 'helpful' ? 'selected' : '' %>>Most Helpful</option>
                </select>
            </div>
        </div>

        <!-- Review Cards List -->
        <% if (reviews && reviews.length > 0) { %>
            <div class="space-y-6">
                <% reviews.forEach(review => { %>
                    <div id="review-<%= review._id %>" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs space-y-5">

                        <!-- Review Header -->
                        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <div class="flex items-center gap-0.5 text-amber-400 text-sm">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="<%= i <= review.rating ? 'ph-fill' : 'ph-bold' %> ph-star"></i>
                                        <% } %>
                                    </div>
                                    <span class="font-bold text-xs text-slate-800"><%= review.rating %>.0</span>
                                    <span class="text-slate-300">&bull;</span>
                                    <span class="text-xs font-bold text-slate-900"><%= review.title %></span>
                                </div>

                                <!-- Review Author Meta -->
                                <div class="flex items-center gap-2 text-xs text-slate-500 flex-wrap">
                                    <% if (review.isAnonymous) { %>
                                        <span class="font-bold text-slate-800 flex items-center gap-1">
                                            <i class="ph-bold ph-shield-check text-emerald-600"></i> Verified Intern
                                        </span>
                                    <% } else { %>
                                        <span class="font-bold text-slate-800">
                                            <%= (review.candidate && review.candidate.name) ? review.candidate.name : 'Verified Intern' %>
                                        </span>
                                    <% } %>
                                    <span>&bull;</span>
                                    <span><%= review.employmentStatus || 'Former Intern' %></span>
                                    <span>&bull;</span>
                                    <span class="text-indigo-700 font-semibold"><%= review.roleTitle %></span>
                                    <span>&bull;</span>
                                    <span><%= new Date(review.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                </div>
                            </div>

                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 shrink-0">
                                <i class="ph-bold ph-seal-check text-emerald-600"></i> Verified Completed Internship
                            </span>
                        </div>

                        <!-- Specific Metric Badges -->
                        <div class="flex items-center gap-2 flex-wrap text-[11px] font-semibold">
                            <span class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700">
                                Mentorship: <strong class="text-indigo-600"><%= review.mentorshipRating %>/5</strong>
                            </span>
                            <span class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700">
                                Learning: <strong class="text-indigo-600"><%= review.learningRating %>/5</strong>
                            </span>
                            <span class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700">
                                Stipend: <strong class="text-indigo-600"><%= review.stipendPunctualityRating %>/5</strong>
                            </span>
                            <span class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700">
                                Work-Life: <strong class="text-indigo-600"><%= review.workLifeBalanceRating %>/5</strong>
                            </span>
                        </div>

                        <!-- Pros & Cons Body -->
                        <div class="space-y-3 text-xs sm:text-sm text-slate-700 leading-relaxed">
                            <div>
                                <h4 class="font-bold text-emerald-800 text-xs flex items-center gap-1 mb-1">
                                    <i class="ph-bold ph-plus-circle text-emerald-600"></i> Pros
                                </h4>
                                <p class="pl-4 border-l-2 border-emerald-300 whitespace-pre-line"><%= review.pros %></p>
                            </div>

                            <div>
                                <h4 class="font-bold text-rose-800 text-xs flex items-center gap-1 mb-1">
                                    <i class="ph-bold ph-minus-circle text-rose-600"></i> Cons
                                </h4>
                                <p class="pl-4 border-l-2 border-rose-300 whitespace-pre-line"><%= review.cons %></p>
                            </div>

                            <% if (review.adviceToManagement) { %>
                                <div>
                                    <h4 class="font-bold text-amber-800 text-xs flex items-center gap-1 mb-1">
                                        <i class="ph-bold ph-lightbulb text-amber-500"></i> Advice to Management
                                    </h4>
                                    <p class="pl-4 border-l-2 border-amber-300 text-slate-600 whitespace-pre-line"><%= review.adviceToManagement %></p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Official Employer Response (if present) -->
                        <% if (review.employerResponse && (review.employerResponse.response || review.employerResponse.comment)) { %>
                            <div class="p-4 bg-slate-50 border-l-4 border-indigo-600 rounded-r-2xl space-y-2 text-xs">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-slate-900 flex items-center gap-1.5">
                                        <i class="ph-bold ph-buildings text-indigo-600"></i>
                                        Official Response from <%= cName %>
                                    </span>
                                    <% if (review.employerResponse.respondedAt) { %>
                                        <span class="text-[11px] text-slate-400">
                                            <%= new Date(review.employerResponse.respondedAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </span>
                                    <% } %>
                                </div>
                                <p class="text-slate-700 leading-relaxed whitespace-pre-line"><%= review.employerResponse.response || review.employerResponse.comment %></p>
                            </div>
                        <% } else if (isCompanyOwnerOrRecruiter) { %>
                            <!-- Response Form for Company Reps -->
                            <div class="pt-2 border-t border-slate-100">
                                <details class="group">
                                    <summary class="text-xs font-bold text-indigo-600 hover:text-indigo-800 cursor-pointer inline-flex items-center gap-1">
                                        <i class="ph-bold ph-chat-circle-dots"></i>
                                        <span>Post Official Employer Response</span>
                                    </summary>
                                    <form action="/company/reviews/<%= review._id %>/response" method="POST" class="mt-3 space-y-3">
                                        <textarea name="response" required rows="3"
                                            placeholder="Write an official, respectful response to this intern's review..."
                                            class="w-full px-3 py-2 text-xs border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800"></textarea>
                                        <div class="flex items-center justify-end gap-2">
                                            <button type="submit" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-lg transition-colors">
                                                Publish Official Response
                                            </button>
                                        </div>
                                    </form>
                                </details>
                            </div>
                        <% } %>

                        <!-- Helpful Vote Action -->
                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                            <form action="/reviews/<%= review._id %>/helpful" method="POST" class="inline">
                                <% const hasVoted = currentUser && review.helpfulVotes && review.helpfulVotes.some(v => v.toString() === currentUser._id.toString()); %>
                                <button type="submit"
                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border <%= hasVoted ? 'bg-indigo-50 border-indigo-200 text-indigo-700 font-bold' : 'border-slate-200 text-slate-600 hover:bg-slate-50' %> transition-colors">
                                    <i class="ph-bold ph-thumbs-up"></i>
                                    <span>Helpful (<%= (review.helpfulVotes && review.helpfulVotes.length) || 0 %>)</span>
                                </button>
                            </form>
                        </div>

                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="bg-white border-2 border-dashed border-slate-200 rounded-3xl p-10 sm:p-14 text-center space-y-4">
                <div class="w-16 h-16 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-3xl mx-auto">
                    <i class="ph-bold ph-chat-circle-dots"></i>
                </div>
                <div class="space-y-1 max-w-md mx-auto">
                    <h3 class="text-base font-bold text-slate-900">No Reviews Found</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        <% if (activeRatingFilter) { %>
                            There are currently no <%= activeRatingFilter %>-star reviews for this employer.
                        <% } else { %>
                            No verified intern reviews have been submitted for <%= cName %> yet.
                        <% } %>
                    </p>
                </div>
                <% if (activeRatingFilter) { %>
                    <a href="/companies/<%= company._id %>/reviews"
                        class="inline-block px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
                        View All Reviews
                    </a>
                <% } else if (eligibility && eligibility.isEligible && !eligibility.existingReview) { %>
                    <a href="/companies/<%= company._id %>/reviews/new"
                        class="inline-block px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all">
                        Be the First to Review
                    </a>
                <% } %>
            </div>
        <% } %>

    </div>

</div>
