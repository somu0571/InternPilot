<% layout('layouts/boilerplate') %>

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Manage Team</h1>
        <a href="/company/dashboard" class="text-sm text-blue-600 hover:underline">Back to Dashboard</a>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-sm"><%= success_msg %></div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm"><%= error_msg %></div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Add Team Member Form -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm h-fit">
            <h2 class="text-lg font-bold text-slate-900 mb-4 border-b pb-2">Add Team Member</h2>
            <form action="/company/team/add" method="POST" class="space-y-4 text-sm">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Name</label>
                    <input type="text" name="name" required class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Email</label>
                    <input type="email" name="email" required class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Temporary Password</label>
                    <input type="password" name="password" required class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Role</label>
                    <select name="role" required class="w-full px-3 py-2 border rounded-lg border-slate-300 bg-white">
                        <option value="recruiter">Recruiter — create listings and review applicants</option>
                        <option value="hiring_manager">Hiring Manager — read-only applicant access</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white font-semibold py-2 rounded-lg hover:bg-blue-700 transition">
                    Add Team Member
                </button>
            </form>
        </div>

        <!-- Active Team Members List -->
        <div class="lg:col-span-2">
            <h2 class="text-lg font-bold text-slate-900 mb-4">Active Team Members</h2>
            <% if (teamMembers && teamMembers.length > 0) { %>
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                    <ul class="divide-y divide-slate-200">
                        <% teamMembers.forEach(member => { %>
                            <li class="p-4 flex justify-between items-center hover:bg-slate-50 transition">
                                <div>
                                    <h3 class="font-bold text-slate-800"><%= member.name %></h3>
                                    <p class="text-xs text-slate-500"><%= member.email %></p>
                                    <p class="text-xs font-semibold text-indigo-700 mt-1"><%= member.role === 'hiring_manager' ? 'Hiring Manager' : 'Recruiter' %></p>
                                </div>
                                <div>
                                    <form action="/company/team/remove/<%= member._id %>" method="POST" onsubmit="return confirm('Are you sure you want to deactivate this team member? They will no longer be able to log in.');">
                                        <button type="submit" class="px-3 py-1 bg-red-100 text-red-600 rounded text-xs font-semibold hover:bg-red-200 transition">
                                            Deactivate
                                        </button>
                                    </form>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            <% } else { %>
                <div class="bg-white border border-slate-200 rounded-xl p-8 text-center text-slate-500">
                    No active team members found in your company.
                </div>
            <% } %>
        </div>
    </div>
</div>
