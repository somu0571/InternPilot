<% layout('layouts/boilerplate') %>
<% const permissionList = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : []; %>
<% const canReviewApplications = permissionList.includes('applications:review'); %>

    <div class="max-w-5xl mx-auto space-y-6">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <a href="/internships" class="text-xs font-semibold text-indigo-600 hover:underline">&larr; Back to
                        Listings</a>
                    <span class="text-slate-300">&bull;</span>
                    <span
                        class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                        <%= (internship && internship.vacancies) ? internship.vacancies : 1 %> Openings
                    </span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
                    <%= internship ? internship.title : 'Listing Applicants' %>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Applicant portal & AI candidate ranking for <%= internship ? (internship.companyName ||
                        internship.company) : 'Organization' %>
                </p>
            </div>

            <% const poolSize = typeof totalApplicants !== 'undefined' ? totalApplicants : (Array.isArray(applications) ? applications.length : 0); %>
            <% const shownCount = Array.isArray(applications) ? applications.length : 0; %>
            <%# Only the /company route passes filters; other callers get the plain list. %>
            <% const filtersEnabled = typeof candidateFilters !== 'undefined' && !!candidateFilters; %>
            <div class="bg-indigo-50 border border-indigo-100 px-4 py-2.5 rounded-xl text-right">
                <span class="block text-[10px] font-semibold text-indigo-500 uppercase tracking-wider">Total
                    Applicants</span>
                <span class="text-xl font-bold text-indigo-700" data-live-region="count" aria-live="polite">
                    <%= shownCount === poolSize ? poolSize : shownCount + ' of ' + poolSize %> Candidates
                </span>
            </div>
        </div>

        <!-- Search Input -->
        <div class="mb-4 flex flex-col sm:flex-row gap-3">
            <div class="relative max-w-md flex-1">
                <label for="candidateSearch" class="sr-only">Search candidates</label>
                <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="text" id="candidateSearch" aria-label="Search candidates by name, skill, qualification, or location" placeholder="Search by name, skill, qualification, or location..."
                    class="w-full pl-10 pr-4 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
            <div class="sm:w-52">
                <label for="proficiencyFilter" class="sr-only">Minimum skill proficiency</label>
                <select id="proficiencyFilter"
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <option value="">Any proficiency</option>
                    <option value="Beginner">Beginner or above</option>
                    <option value="Intermediate">Intermediate or above</option>
                    <option value="Advanced">Advanced only</option>
                </select>
            </div>
        </div>

        <% if (filtersEnabled && poolSize > 0) { %><%- include('../partials/candidate-filter-panel') %><% } %>

        <%# Swapped in place by the candidate filter script. data-state carries the filters the server applied. %>
        <div data-live-region="results" class="space-y-4 transition-opacity"
            data-state="<%= JSON.stringify(typeof candidateFilters !== 'undefined' ? candidateFilters : {}) %>">

        <% if (filtersEnabled) { %><%- include('../partials/candidate-active-filters') %><% } %>

        <% if (poolSize === 0) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
                <i class="ph-bold ph-users-three text-4xl text-slate-300 mb-2"></i>
                <h3 class="text-base font-bold text-slate-800">No applicants yet</h3>
                <p class="text-xs text-slate-500 mt-1">Applications will appear here once candidates start applying.</p>
            </div>
        <% } else if (!applications || applications.length === 0) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
                <i class="ph-bold ph-funnel-x text-4xl text-slate-300 mb-2"></i>
                <h3 class="text-base font-bold text-slate-800">No candidates match these filters</h3>
                <p class="text-xs text-slate-500 mt-1 mb-4">Remove a filter above to widen the pool again.</p>
                <% if (typeof filterBasePath !== 'undefined' && filterBasePath) { %>
                    <a href="<%= filterBasePath %>" class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors">
                        Clear all filters
                    </a>
                <% } %>
            </div>
            <% } else { %>
                <div class="space-y-4">

                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900">Ranked Applicants (AI Skill Fit)</h3>
                        <span class="text-xs text-slate-400">Sorted by highest match %</span>
                    </div>

                    <div class="grid grid-cols-1 gap-4">
                        <% applications.forEach((app, index)=> { %>
                            <% const isTopRecommendation = index < 3 && !['Withdrawn', 'withdrawn'].includes(app.status) && (app.matchScore || 0) >= 60; %>
                            <% const candidateSkillProfiles = Array.isArray(app.candidateSkillProfiles) && app.candidateSkillProfiles.length
                                ? app.candidateSkillProfiles
                                : ((app.candidate && Array.isArray(app.candidate.skills))
                                    ? app.candidate.skills.map(name => ({ name, proficiency: 'Intermediate' }))
                                    : []); %>
                            <% const candidateSkillText = candidateSkillProfiles.map(skill => `${skill.name} ${skill.proficiency}`).join(' '); %>
                            <div
                                class="applicant-card <%= isTopRecommendation ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200 bg-white' %> rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4"
                                data-search-text="<%= ((app.candidate && app.candidate.name) ? app.candidate.name : '') + ' ' + ((app.candidate && app.candidate.education) ? (app.candidate.education.qualification || '') : '') + ' ' + ((app.candidate && app.candidate.location) ? ((app.candidate.location.district ? app.candidate.location.district + ' ' : '') + (app.candidate.location.state || '')) : '') + ' ' + candidateSkillText %>"
                                data-skill-profiles="<%= JSON.stringify(candidateSkillProfiles.map(skill => ({ name: skill.name, proficiency: skill.proficiency }))) %>">

                                <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
                                    <div class="flex items-start gap-3.5 min-w-0 flex-1">
                                        <!-- Rank Badge -->
                                        <div
                                            class="w-8 h-8 rounded-full bg-slate-100 font-bold text-slate-600 text-xs flex items-center justify-center border border-slate-200 shrink-0">
                                            #<%= index + 1 %>
                                        </div>

                                        <div class="space-y-1.5 min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <h4 class="text-base font-bold text-slate-900">
                                                    <%= (app.candidate && app.candidate.name) ? app.candidate.name
                                                        : 'Unknown Candidate' %>
                                                </h4>

                                                <% const isAppWithdrawn = ['Withdrawn', 'withdrawn'].includes(app.status); %>
                                                <% if (isAppWithdrawn) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-300 flex items-center gap-1">
                                                        <i class="ph-bold ph-arrow-u-up-left"></i> Withdrawn
                                                    </span>
                                                <% } %>
                                                <% if (app.interview && app.interview.status && app.interview.status !== 'Cancelled') { %>
                                                    <span
                                                        class="text-[10px] font-bold px-2 py-0.5 rounded border flex items-center gap-1
                                                        <%= app.interview.status === 'Scheduled' ? 'text-indigo-700 bg-indigo-50 border-indigo-200' : 'text-amber-700 bg-amber-50 border-amber-200' %>">
                                                        <i class="ph-bold ph-calendar"></i> <%= app.interview.status %> Interview
                                                    </span>
                                                <% } %>
                                                <% const isPmisEligible = typeof checkPmisEligibility === 'function' ? checkPmisEligibility(app.candidate).isEligible : (app.candidate && app.candidate.age >= 21 && app.candidate.age <= 24 && app.candidate.familyIncome !== undefined && app.candidate.familyIncome !== null && app.candidate.familyIncome <= 800000); %>
                                                <% if (isPmisEligible) { %>
                                                    <span
                                                        class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                                                        PMIS Eligible
                                                    </span>
                                                <% } %>
                                                <% if (isTopRecommendation) { %>
                                                    <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200 flex items-center gap-1">
                                                        <i class="ph-fill ph-star"></i> Top Match #<%= index + 1 %>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <%
                                                const metaItems = [];
                                                const candidateQual = (app.candidate?.education?.qualification || '').trim();
                                                if (candidateQual && candidateQual !== 'N/A') {
                                                    metaItems.push({
                                                        icon: 'ph-graduation-cap text-indigo-500',
                                                        text: candidateQual
                                                    });
                                                }
                                                const locParts = [app.candidate?.location?.district, app.candidate?.location?.state]
                                                    .map(part => (part || '').trim())
                                                    .filter(Boolean);
                                                if (locParts.length > 0) {
                                                    metaItems.push({
                                                        icon: 'ph-map-pin text-rose-500',
                                                        text: locParts.join(', ')
                                                    });
                                                }
                                                if (app.candidate?.age && Number(app.candidate.age) > 0) {
                                                    metaItems.push({
                                                        text: 'Age: ' + app.candidate.age
                                                    });
                                                }
                                            %>
                                            <% if (metaItems.length > 0) { %>
                                                <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                                    <% metaItems.forEach((item, itemIdx) => { %>
                                                        <% if (itemIdx > 0) { %>
                                                            <span class="text-slate-300 font-bold">&bull;</span>
                                                        <% } %>
                                                        <span class="inline-flex items-center gap-1.5">
                                                            <% if (item.icon) { %>
                                                                <i class="ph-bold <%= item.icon %>"></i>
                                                            <% } %>
                                                            <%= item.text %>
                                                        </span>
                                                    <% }) %>
                                                </div>
                                            <% } %>

                                            <%
                                                const reqSkills = Array.isArray(internship?.requiredSkills) ? internship.requiredSkills : [];
                                                const minQual = (typeof internship?.minQualifications === 'string'
                                                    ? internship.minQualifications
                                                    : (typeof internship?.minQualification === 'string' ? internship.minQualification : '')).trim();

                                                const recruiterTokens = [
                                                    ...reqSkills,
                                                    ...(minQual ? minQual.split(/[,/|•\n+&]+/) : []),
                                                    ...(Array.isArray(internship?.eligibilityCriteria) ? internship.eligibilityCriteria : []).flatMap(e => String(e || '').split(/[,/|•\n+&]+/))
                                                ]
                                                    .map(s => String(s || '').trim().toLowerCase())
                                                    .filter(s => s && !['any', 'none', 'n/a', 'na', 'all'].includes(s));

                                                let matchingCandidateSkills = [];
                                                if (Array.isArray(app.matchingSkillProfiles) && app.matchingSkillProfiles.length > 0) {
                                                    matchingCandidateSkills = app.matchingSkillProfiles.map(s => ({
                                                        name: s.profileSkill || s.name || s.skill,
                                                        proficiency: s.proficiency || 'Intermediate'
                                                    }));
                                                } else if (recruiterTokens.length > 0) {
                                                    matchingCandidateSkills = candidateSkillProfiles.filter(profile => {
                                                        const pKey = String(profile.name || '').trim().toLowerCase();
                                                        return recruiterTokens.some(token => pKey === token || (token.length >= 3 && pKey.includes(token)) || (pKey.length >= 3 && token.includes(pKey)));
                                                    });
                                                } else if (Array.isArray(app.matchingSkills) && app.matchingSkills.length > 0) {
                                                    const matchSet = new Set(app.matchingSkills.map(s => String(s || '').trim().toLowerCase()));
                                                    matchingCandidateSkills = candidateSkillProfiles.filter(profile =>
                                                        matchSet.has(String(profile.name || '').trim().toLowerCase())
                                                    );
                                                } else if (app.matchRationale && /matching skills:/i.test(app.matchRationale)) {
                                                    const matchPart = app.matchRationale.match(/matching skills:\s*([^.]+)/i);
                                                    if (matchPart && matchPart[1]) {
                                                        const extracted = matchPart[1].split(/[,/]+/).map(s => s.trim().toLowerCase()).filter(Boolean);
                                                        matchingCandidateSkills = candidateSkillProfiles.filter(profile =>
                                                            extracted.some(e => String(profile.name || '').trim().toLowerCase().includes(e) || e.includes(String(profile.name || '').trim().toLowerCase()))
                                                        );
                                                    }
                                                }
                                                // When no skills match what the recruiter entered, matchingCandidateSkills is empty ([]),
                                                // ensuring candidate skills are removed from the card unless they match the recruiter's requirements.
                                            %>

                                            <!-- Matching Skills Only -->
                                            <% if (matchingCandidateSkills.length > 0) { %>
                                                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                                                    <% const visibleSkills = matchingCandidateSkills.slice(0, 4); %>
                                                    <% const hiddenSkills = matchingCandidateSkills.slice(4); %>
                                                    <% visibleSkills.forEach(skill => { %>
                                                        <span
                                                            class="inline-flex items-center gap-1 text-[11px] font-medium bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded">
                                                            <%= skill.name %>
                                                            <span class="rounded bg-white px-1 text-[10px] font-bold text-slate-600" aria-label="<%= skill.name %> proficiency: <%= skill.proficiency %>"><%= skill.proficiency %></span>
                                                        </span>
                                                    <% }) %>
                                                    <% if (hiddenSkills.length > 0) { %>
                                                        <span id="extra-skills-<%= app._id %>" class="hidden inline-flex flex-wrap items-center gap-1.5">
                                                            <% hiddenSkills.forEach(skill => { %>
                                                                <span
                                                                    class="inline-flex items-center gap-1 text-[11px] font-medium bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded">
                                                                    <%= skill.name %>
                                                                    <span class="rounded bg-white px-1 text-[10px] font-bold text-slate-600" aria-label="<%= skill.name %> proficiency: <%= skill.proficiency %>"><%= skill.proficiency %></span>
                                                                </span>
                                                            <% }) %>
                                                        </span>
                                                        <button type="button"
                                                            onclick="const el = document.getElementById('extra-skills-<%= app._id %>'); const isHidden = el.classList.toggle('hidden'); this.textContent = isHidden ? '+<%= hiddenSkills.length %> more' : 'Show less';"
                                                            class="inline-flex items-center text-[11px] font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-2 py-0.5 rounded transition-colors cursor-pointer">
                                                            +<%= hiddenSkills.length %> more
                                                        </button>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div
                                        class="flex flex-wrap sm:flex-nowrap items-center justify-between lg:justify-end gap-5 shrink-0 pt-3 lg:pt-0 border-t lg:border-0 border-slate-100">

                                        <!-- Match Score Card & View Profile Column -->
                                        <div class="flex flex-col items-center gap-2">
                                            <!-- Match Card -->
                                            <div class="flex items-center gap-3 px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 shadow-sm min-w-[13rem] max-w-[18rem]">
                                                <div class="text-left shrink-0">
                                                    <span class="block text-[9px] font-bold text-slate-400 uppercase tracking-wider">MATCH</span>
                                                    <span class="text-sm font-extrabold <%= (app.matchScore || 0) >= 75 ? 'text-emerald-600' : ((app.matchScore || 0) >= 40 ? 'text-amber-600' : 'text-rose-600') %>">
                                                        <%= app.matchScore || 0 %>%
                                                    </span>
                                                </div>
                                                <% if (app.matchRationale) { %>
                                                    <div class="border-l border-slate-200 pl-3 text-[11px] leading-snug text-slate-500" title="<%= app.matchRationale %>">
                                                        <span class="line-clamp-2"><%= app.matchRationale %></span>
                                                    </div>
                                                <% } else { %>
                                                    <div class="border-l border-slate-200 pl-3 text-[11px] leading-snug text-slate-400 italic">
                                                        Limited profile data available.
                                                    </div>
                                                <% } %>
                                            </div>

                                            <!-- View Profile Link with Arrow in Front -->
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/company/applications/<%= app._id %>/candidate"
                                                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-indigo-600 transition-colors">
                                                    <i class="ph-bold ph-arrow-up-right text-xs"></i>
                                                    View Profile
                                                </a>
                                                <% if (app.applicationKit) { %>
                                                    <span class="text-slate-300">&bull;</span>
                                                    <a href="/company/applications/<%= app._id %>/candidate#submitted-application-kit"
                                                        class="inline-flex items-center gap-1 text-[11px] font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
                                                        <i class="ph-bold ph-briefcase text-xs"></i> Submitted Kit
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Chat / Message Button -->
                                        <% if (typeof messageUnreadCount !== 'undefined') { %>
                                            <div class="flex items-center justify-center self-center">
                                                <%- include('../partials/message-start-button', { application: app, label: 'Message ' + ((app.candidate && app.candidate.name) || 'candidate'), compact: true }) %>
                                            </div>
                                        <% } %>

                                        <!-- Status Dropdown & Resume Column -->
                                        <div class="flex flex-col gap-2 min-w-[8.5rem] w-36">
                                            <!-- Employer Actions Dropdown or Withdrawn Indicator (Top) -->
                                            <% if (isAppWithdrawn) { %>
                                                <div class="w-full text-center px-3 py-1.5 bg-slate-100 text-slate-500 border border-slate-300 text-xs font-semibold rounded-lg flex items-center justify-center gap-1 shadow-sm"
                                                    title="Candidate withdrew their application <%= app.withdrawalReason ? '(' + app.withdrawalReason + ')' : '' %>">
                                                    <i class="ph-bold ph-arrow-u-up-left text-slate-500"></i>
                                                    Withdrawn
                                                </div>
                                            <% } else if (app.status === 'Interview') { %>
                                                <div class="w-full text-center px-3 py-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1 shadow-sm"
                                                    title="Candidate is in the interview stage">
                                                    <i class="ph-bold ph-calendar text-indigo-600"></i>
                                                    Interview
                                                </div>
                                            <% } else if (canReviewApplications) { %>
                                                <form action="/company/applications/<%= app._id %>/status"
                                                    method="POST" class="w-full" data-loading-text="Updating...">
                                                    <select name="status" onchange="if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); }" class="w-full text-center px-3 py-1.5 text-xs font-semibold rounded-lg border shadow-sm cursor-pointer outline-none transition-colors <%=
                                                    app.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                                    app.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                                    app.status === 'Under Review' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                                    'bg-indigo-50 text-indigo-700 border-indigo-200'
                                                %>">
                                                        <option value="Submitted" <%=app.status==='Submitted'
                                                            ? 'selected' : '' %>>Submitted</option>
                                                        <option value="Under Review" <%=app.status==='Under Review'
                                                            ? 'selected' : '' %>>Under Review</option>
                                                        <option value="Shortlisted" <%=app.status==='Shortlisted'
                                                            ? 'selected' : '' %>>Shortlisted</option>
                                                        <option value="Rejected" <%=app.status==='Rejected'
                                                            ? 'selected' : '' %>>Rejected</option>
                                                    </select>
                                                </form>
                                            <% } else { %>
                                                <span class="w-full text-center px-3 py-1.5 bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg shadow-sm">
                                                    <%= app.status || 'Submitted' %>
                                                </span>
                                            <% } %>

                                            <!-- Candidate Resume Button (Bottom) -->
                                            <% const submittedResumePath = app.applicationKit && app.applicationKit.resume
                                                ? ((app.applicationKit.resume.fileUrl || '').startsWith('/uploads/')
                                                    ? app.applicationKit.resume.fileUrl
                                                    : sanitizeHttpUrl(app.applicationKit.resume.fileUrl).url)
                                                : ''; %>
                                            <% const resumePath = submittedResumePath || (app.candidate ? (app.candidate.resume || app.candidate.resumeUrl) : null); %>
                                            <% if (resumePath) { %>
                                                <a href="<%= resumePath %>" target="_blank"
                                                    class="w-full px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                                    <i class="ph-bold ph-file-pdf text-sm text-indigo-600"></i> <%= submittedResumePath ? 'Submitted Resume' : 'Resume' %>
                                                </a>
                                            <% } else { %>
                                                <span
                                                    class="w-full px-3 py-1.5 bg-slate-50 text-slate-400 border border-slate-200 text-xs font-medium rounded-lg flex items-center justify-center gap-1 shadow-sm">
                                                    <i class="ph-bold ph-file-x text-sm"></i> No Resume
                                                </span>
                                            <% } %>
                                        </div>

                                    </div>
                                </div>

                                <!-- Candidate Notes Section (Collapsible) -->
                                <% const notesCount = Array.isArray(app.notes) ? app.notes.length : 0; %>
                                <div class="border-t border-slate-100 pt-2.5">
                                    <button type="button"
                                        onclick="
                                            const section = document.getElementById('notes-section-<%= app._id %>');
                                            const icon = document.getElementById('notes-icon-<%= app._id %>');
                                            const isHidden = section.classList.toggle('hidden');
                                            if (icon) icon.classList.toggle('rotate-180', !isHidden);
                                        "
                                        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-indigo-600 py-1 transition-colors group cursor-pointer"
                                        aria-expanded="false"
                                        aria-controls="notes-section-<%= app._id %>">
                                        <i class="ph-bold ph-note-pencil text-indigo-600 text-sm"></i>
                                        <span>Candidate Notes (<%= notesCount %>)</span>
                                        <i id="notes-icon-<%= app._id %>" class="ph-bold ph-caret-down text-[11px] text-slate-400 group-hover:text-indigo-600 transition-transform duration-200"></i>
                                    </button>

                                    <div id="notes-section-<%= app._id %>" class="hidden mt-2.5 space-y-2.5 pt-2 border-t border-slate-100">
                                        <% if (Array.isArray(app.notes) && app.notes.length > 0) { %>
                                            <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                                                <% app.notes.forEach(note => { %>
                                                    <% const noteAuthorId = note.createdBy?._id ? note.createdBy._id.toString() : (note.createdBy ? note.createdBy.toString() : ''); %>
                                                    <% const isNoteCreator = user && user._id && noteAuthorId === user._id.toString(); %>
                                                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs space-y-1">
                                                        <div class="flex items-center justify-between text-slate-500">
                                                            <span class="font-semibold text-slate-700">
                                                                <%= note.createdBy ? (note.createdBy.companyDetails?.companyName || note.createdBy.name || 'Company') : 'Company' %>
                                                            </span>
                                                            <div class="flex items-center gap-2">
                                                                <span class="text-[10px] text-slate-400">
                                                                    <%= new Date(note.createdAt).toLocaleString() %><%= note.updatedAt ? ' (edited)' : '' %>
                                                                </span>
                                                                <% if (canReviewApplications && isNoteCreator) { %>
                                                                    <div class="flex items-center gap-1.5 ml-1">
                                                                        <button type="button" onclick="document.getElementById('edit-note-<%= note._id %>').classList.toggle('hidden')" class="text-slate-400 hover:text-indigo-600 transition-colors" title="Edit Note">
                                                                            <i class="ph-bold ph-pencil-simple text-xs"></i>
                                                                        </button>
                                                                        <form action="/company/applications/<%= app._id %>/notes/<%= note._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this note?')" data-loading-text="Deleting...">
                                                                            <button type="submit" class="text-slate-400 hover:text-rose-600 transition-colors" title="Delete Note">
                                                                                <i class="ph-bold ph-trash text-xs"></i>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <p class="text-slate-700 whitespace-pre-line"><%= note.text %></p>

                                                        <% if (canReviewApplications && isNoteCreator) { %>
                                                            <div id="edit-note-<%= note._id %>" class="hidden pt-2 border-t border-slate-200 mt-2">
                                                                <form action="/company/applications/<%= app._id %>/notes/<%= note._id %>/edit" method="POST" class="flex items-start gap-2" data-loading-text="Saving...">
                                                                    <textarea name="text" required rows="2"
                                                                        class="flex-1 px-2.5 py-1 text-xs border border-slate-200 rounded-md focus:outline-none focus:border-indigo-500 bg-white resize-y"><%= note.text %></textarea>
                                                                    <button type="submit"
                                                                        class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-md transition-colors shrink-0">
                                                                        Save
                                                                    </button>
                                                                    <button type="button" onclick="document.getElementById('edit-note-<%= note._id %>').classList.add('hidden')"
                                                                        class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-medium rounded-md transition-colors shrink-0">
                                                                        Cancel
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <p class="text-xs text-slate-400 italic">No notes added yet.</p>
                                        <% } %>

                                        <% if (canReviewApplications) { %>
                                        <form action="/company/applications/<%= app._id %>/notes" method="POST" class="flex items-center gap-2 pt-1" data-loading-text="Adding...">
                                            <input type="text" name="text" placeholder="Add a note about this candidate..." required
                                                class="flex-1 px-3 py-1.5 text-xs border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors" />
                                            <button type="submit"
                                                class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors shrink-0 flex items-center gap-1">
                                                <i class="ph-bold ph-plus text-xs"></i> Add Note
                                            </button>
                                        </form>
                                        <% } %>
                                    </div>
                                </div>

                            </div>
                            <% }) %>
                    </div>
                </div>
                <% } %>

        </div>

        <!-- Search Empty State -->
        <div id="searchEmptyState" class="hidden bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm mt-4">
            <i class="ph-bold ph-magnifying-glass text-4xl text-slate-300 mb-2"></i>
            <h3 class="text-base font-bold text-slate-800">No matches found</h3>
            <p class="text-xs text-slate-500 mt-1">Try adjusting your search keywords.</p>
        </div>
    </div>

<% if (filtersEnabled) { %><%- include('../partials/candidate-filters-script') %><% } %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('candidateSearch');
        const proficiencyFilter = document.getElementById('proficiencyFilter');
        const emptyState = document.getElementById('searchEmptyState');
        const proficiencyRank = { Beginner: 0, Intermediate: 1, Advanced: 2 };

        if (!searchInput) return;

        const applyFilters = () => {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const minimumLevel = proficiencyFilter ? proficiencyFilter.value : '';
            // Re-read on every run: the candidate filters swap the cards in place.
            const candidateCards = document.querySelectorAll('.applicant-card');
            let visibleCount = 0;

            candidateCards.forEach(card => {
                const cardData = (card.getAttribute('data-search-text') || '').toLowerCase();
                let skillProfiles = [];
                try {
                    skillProfiles = JSON.parse(card.getAttribute('data-skill-profiles') || '[]');
                } catch (_) { /* ignore malformed legacy data */ }

                // The text search can match a candidate name, qualification,
                // location, or skill. Keep that generic search independent
                // from the minimum-proficiency filter so, for example,
                // searching "Alice" still finds Alice when she has any
                // Advanced skill.
                const hasMinimumLevel = !minimumLevel || skillProfiles.some(profile =>
                    (proficiencyRank[profile.proficiency] ?? -1) >= proficiencyRank[minimumLevel]
                );

                const matchesSearch = !searchTerm || cardData.includes(searchTerm);
                if (matchesSearch && hasMinimumLevel) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCount === 0 && candidateCards.length > 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        };

        searchInput.addEventListener('input', applyFilters);
        if (proficiencyFilter) proficiencyFilter.addEventListener('change', applyFilters);
    });
</script>
