<% layout('layouts/boilerplate') %>

    <div class="max-w-5xl mx-auto space-y-6">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <a href="/internships" class="text-xs font-semibold text-indigo-600 hover:underline">&larr; Back to
                        Listings</a>
                    <span class="text-slate-300">&bull;</span>
                    <span
                        class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                        <%= (internship && internship.vacancies) ? internship.vacancies : 1 %> Openings
                    </span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
                    <%= internship ? internship.title : 'Listing Applicants' %>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Applicant portal & AI candidate ranking for <%= internship ? (internship.companyName ||
                        internship.company) : 'Organization' %>
                </p>
            </div>

            <div class="bg-indigo-50 border border-indigo-100 px-4 py-2.5 rounded-xl text-right">
                <span class="block text-[10px] font-semibold text-indigo-500 uppercase tracking-wider">Total
                    Applicants</span>
                <span class="text-xl font-bold text-indigo-700">
                    <%= Array.isArray(applications) ? applications.length : 0 %> Candidates
                </span>
            </div>
        </div>

        <!-- Search Input -->
        <div class="mb-4">
            <div class="relative max-w-md">
                <label for="candidateSearch" class="sr-only">Search candidates</label>
                <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="text" id="candidateSearch" aria-label="Search candidates by name, skill, qualification, or location" placeholder="Search by name, skill, qualification, or location..."
                    class="w-full pl-10 pr-4 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
        </div>

        <% if (!applications || applications.length===0) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
                <i class="ph-bold ph-users-three text-4xl text-slate-300 mb-2"></i>
                <h3 class="text-base font-bold text-slate-800">No applicants yet</h3>
                <p class="text-xs text-slate-500 mt-1">Applications will appear here once candidates start applying.</p>
            </div>
            <% } else { %>
                <div class="space-y-4">

                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900">Ranked Applicants (AI Skill Fit)</h3>
                        <span class="text-xs text-slate-400">Sorted by highest match %</span>
                    </div>

                    <div class="grid grid-cols-1 gap-4">
                        <% applications.forEach((app, index)=> { %>
                            <% const isTopRecommendation = index < 3 && !['Withdrawn', 'withdrawn'].includes(app.status) && (app.matchScore || 0) >= 60; %>
                            <div
                                class="applicant-card <%= isTopRecommendation ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200 bg-white' %> rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4"
                                data-search-text="<%= ((app.candidate && app.candidate.name) ? app.candidate.name : '') + ' ' + ((app.candidate && app.candidate.education) ? (app.candidate.education.qualification || '') : '') + ' ' + ((app.candidate && app.candidate.location) ? ((app.candidate.location.district ? app.candidate.location.district + ' ' : '') + (app.candidate.location.state || '')) : '') + ' ' + ((app.candidate && Array.isArray(app.candidate.skills)) ? app.candidate.skills.join(' ') : '') %>">

                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <div class="flex items-start gap-4">
                                        <!-- Rank Badge -->
                                        <div
                                            class="w-8 h-8 rounded-full bg-slate-100 font-bold text-slate-600 text-xs flex items-center justify-center border border-slate-200 shrink-0">
                                            #<%= index + 1 %>
                                        </div>

                                        <div class="space-y-1.5">
                                            <div class="flex items-center gap-2">
                                                <h4 class="text-base font-bold text-slate-900">
                                                    <%= (app.candidate && app.candidate.name) ? app.candidate.name
                                                        : 'Unknown Candidate' %>
                                                </h4>

                                                <% const isAppWithdrawn = ['Withdrawn', 'withdrawn'].includes(app.status); %>
                                                <% if (isAppWithdrawn) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-300 flex items-center gap-1">
                                                        <i class="ph-bold ph-arrow-u-up-left"></i> Withdrawn
                                                    </span>
                                                <% } %>
                                                <% if (app.interview && app.interview.status && app.interview.status !== 'Cancelled') { %>
                                                    <span
                                                        class="text-[10px] font-bold px-2 py-0.5 rounded border flex items-center gap-1
                                                        <%= app.interview.status === 'Scheduled' ? 'text-indigo-700 bg-indigo-50 border-indigo-200' : 'text-amber-700 bg-amber-50 border-amber-200' %>">
                                                        <i class="ph-bold ph-calendar"></i> <%= app.interview.status %> Interview
                                                    </span>
                                                <% } %>
                                                <% const isPmisEligible = app.candidate && app.candidate.age >= 21 && app.candidate.age <= 24 && app.candidate.familyIncome !== undefined && app.candidate.familyIncome !== null && app.candidate.familyIncome <= 800000; %>
                                                <% if (isPmisEligible) { %>
                                                    <span
                                                        class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                                                        PMIS Eligible
                                                    </span>
                                                <% } %>
                                                <% if (isTopRecommendation) { %>
                                                    <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200 flex items-center gap-1">
                                                        <i class="ph-fill ph-star"></i> Top Match #<%= index + 1 %>
                                                    </span>
                                                <% } %>
                                            </div>

                                            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                                                <span>
                                                    <i class="ph-bold ph-graduation-cap text-indigo-500"></i>
                                                    <%= (app.candidate && app.candidate.education) ?
                                                        (app.candidate.education.qualification || 'N/A' ) : 'N/A' %>
                                                </span>
                                                <span>&bull;</span>
                                                <span>
                                                    <i class="ph-bold ph-map-pin text-rose-500"></i>
                                                    <%= (app.candidate && app.candidate.location) ?
                                                        ((app.candidate.location.district ? app.candidate.location.district
                                                        + ', ' : '' ) + (app.candidate.location.state || '' )) : 'N/A' %>
                                                </span>
                                                <span>&bull;</span>
                                                <span>
                                                    Age: <%= (app.candidate && app.candidate.age) ? app.candidate.age
                                                        : 'N/A' %>
                                                </span>
                                            </div>

                                            <!-- Skills matching badges -->
                                            <div class="flex flex-wrap gap-1.5 pt-1">
                                                <% if (app.candidate && Array.isArray(app.candidate.skills)) { %>
                                                    <% app.candidate.skills.forEach(skill=> { %>
                                                        <span
                                                            class="text-[11px] font-medium bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded">
                                                            <%= skill %>
                                                        </span>
                                                        <% }) %>
                                                            <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-center justify-between md:justify-end gap-4 pt-3 md:pt-0 border-t md:border-0 border-slate-100">

                                        <!-- Match Score -->
                                        <div class="text-center">
                                            <span
                                                class="block text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Match
                                                Fit</span>
                                            <span
                                                class="px-3 py-1 rounded-lg border text-xs font-bold <%= (app.matchScore || 0) >= 75 ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : ((app.matchScore || 0) >= 40 ? 'bg-amber-50 border-amber-200 text-amber-700' : 'bg-rose-50 border-rose-200 text-rose-700') %>">
                                                <%= app.matchScore || 0 %>%
                                            </span>
                                            <% if (app.matchRationale) { %>
                                                <p class="mt-2 max-w-[14rem] text-[11px] leading-snug text-slate-500" title="How this score was calculated">
                                                    <i class="ph-bold ph-sparkle text-amber-500"></i> <%= app.matchRationale %>
                                                </p>
                                            <% } %>
                                        </div>

                                        <!-- View Profile Button -->
                                        <a href="/company/applications/<%= app._id %>/candidate"
                                            class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                                            <i class="ph-bold ph-user text-sm"></i> View Profile
                                        </a>

                                        <!-- Candidate Resume Button -->
                                        <% const resumePath=app.candidate ? (app.candidate.resume ||
                                            app.candidate.resumeUrl) : null; %>
                                            <% if (resumePath) { %>
                                                <a href="<%= resumePath %>" target="_blank"
                                                    class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                                                    <i class="ph-bold ph-file-pdf text-sm"></i> Resume
                                                </a>
                                                <% } else { %>
                                                    <span
                                                        class="px-3 py-1.5 bg-slate-100 text-slate-400 border border-slate-200 text-xs font-medium rounded-lg flex items-center gap-1">
                                                        <i class="ph-bold ph-file-x text-sm"></i> No Resume
                                                    </span>
                                                    <% } %>

                                                        <!-- Employer Actions Dropdown or Withdrawn Indicator -->
                                                        <% if (isAppWithdrawn) { %>
                                                            <div class="px-3 py-1.5 bg-slate-100 text-slate-500 border border-slate-300 text-xs font-semibold rounded-lg flex items-center gap-1"
                                                                title="Candidate withdrew their application <%= app.withdrawalReason ? '(' + app.withdrawalReason + ')' : '' %>">
                                                                <i class="ph-bold ph-arrow-u-up-left text-slate-500"></i>
                                                                Withdrawn
                                                            </div>
                                                        <% } else if (app.status === 'Interview') { %>
                                                            <div class="px-3 py-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-semibold rounded-lg flex items-center gap-1"
                                                                title="Candidate is in the interview stage">
                                                                <i class="ph-bold ph-calendar text-indigo-600"></i>
                                                                Interview
                                                            </div>
                                                        <% } else { %>
                                                            <form action="/company/applications/<%= app._id %>/status"
                                                                method="POST" class="inline-block" data-loading-text="Updating...">
                                                                <select name="status" onchange="if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); }" class="px-3 py-1.5 text-xs font-semibold rounded-lg border shadow-sm cursor-pointer outline-none transition-colors <%=
                                                        app.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                                        app.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                                        app.status === 'Under Review' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                                        'bg-indigo-50 text-indigo-700 border-indigo-200'
                                                    %>">
                                                                    <option value="Submitted" <%=app.status==='Submitted'
                                                                        ? 'selected' : '' %>>Submitted</option>
                                                                    <option value="Under Review" <%=app.status==='Under Review'
                                                                        ? 'selected' : '' %>>Under Review</option>
                                                                    <option value="Shortlisted" <%=app.status==='Shortlisted'
                                                                        ? 'selected' : '' %>>Shortlisted</option>
                                                                    <option value="Rejected" <%=app.status==='Rejected'
                                                                        ? 'selected' : '' %>>Rejected</option>
                                                                </select>
                                                            </form>
                                                        <% } %>

                                    </div>
                                </div>

                                <!-- Candidate Notes Section -->
                                <div class="border-t border-slate-100 pt-3 space-y-2.5">
                                    <h5 class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                        <i class="ph-bold ph-note-pencil text-indigo-600 text-sm"></i>
                                        Candidate Notes (<%= Array.isArray(app.notes) ? app.notes.length : 0 %>)
                                    </h5>

                                    <% if (Array.isArray(app.notes) && app.notes.length > 0) { %>
                                        <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                                            <% app.notes.forEach(note => { %>
                                                <% const noteAuthorId = note.createdBy?._id ? note.createdBy._id.toString() : (note.createdBy ? note.createdBy.toString() : ''); %>
                                                <% const isNoteCreator = user && user._id && noteAuthorId === user._id.toString(); %>
                                                <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs space-y-1">
                                                    <div class="flex items-center justify-between text-slate-500">
                                                        <span class="font-semibold text-slate-700">
                                                            <%= note.createdBy ? (note.createdBy.companyDetails?.companyName || note.createdBy.name || 'Company') : 'Company' %>
                                                        </span>
                                                        <div class="flex items-center gap-2">
                                                            <span class="text-[10px] text-slate-400">
                                                                <%= new Date(note.createdAt).toLocaleString() %><%= note.updatedAt ? ' (edited)' : '' %>
                                                            </span>
                                                            <% if (isNoteCreator) { %>
                                                                <div class="flex items-center gap-1.5 ml-1">
                                                                    <button type="button" onclick="document.getElementById('edit-note-<%= note._id %>').classList.toggle('hidden')" class="text-slate-400 hover:text-indigo-600 transition-colors" title="Edit Note">
                                                                        <i class="ph-bold ph-pencil-simple text-xs"></i>
                                                                    </button>
                                                                    <form action="/company/applications/<%= app._id %>/notes/<%= note._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this note?')" data-loading-text="Deleting...">
                                                                        <button type="submit" class="text-slate-400 hover:text-rose-600 transition-colors" title="Delete Note">
                                                                            <i class="ph-bold ph-trash text-xs"></i>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <p class="text-slate-700 whitespace-pre-line"><%= note.text %></p>

                                                    <% if (isNoteCreator) { %>
                                                        <div id="edit-note-<%= note._id %>" class="hidden pt-2 border-t border-slate-200 mt-2">
                                                            <form action="/company/applications/<%= app._id %>/notes/<%= note._id %>/edit" method="POST" class="flex items-start gap-2" data-loading-text="Saving...">
                                                                <textarea name="text" required rows="2"
                                                                    class="flex-1 px-2.5 py-1 text-xs border border-slate-200 rounded-md focus:outline-none focus:border-indigo-500 bg-white resize-y"><%= note.text %></textarea>
                                                                <button type="submit"
                                                                    class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-md transition-colors shrink-0">
                                                                    Save
                                                                </button>
                                                                <button type="button" onclick="document.getElementById('edit-note-<%= note._id %>').classList.add('hidden')"
                                                                    class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-medium rounded-md transition-colors shrink-0">
                                                                    Cancel
                                                                </button>
                                                            </form>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <p class="text-xs text-slate-400 italic">No notes added yet.</p>
                                    <% } %>

                                    <form action="/company/applications/<%= app._id %>/notes" method="POST" class="flex items-center gap-2 pt-1" data-loading-text="Adding...">
                                        <input type="text" name="text" placeholder="Add a note about this candidate..." required
                                            class="flex-1 px-3 py-1.5 text-xs border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors" />
                                        <button type="submit"
                                            class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors shrink-0 flex items-center gap-1">
                                            <i class="ph-bold ph-plus text-xs"></i> Add Note
                                        </button>
                                    </form>
                                </div>

                            </div>
                            <% }) %>
                    </div>
                </div>
                <% } %>

        <!-- Search Empty State -->
        <div id="searchEmptyState" class="hidden bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm mt-4">
            <i class="ph-bold ph-magnifying-glass text-4xl text-slate-300 mb-2"></i>
            <h3 class="text-base font-bold text-slate-800">No matches found</h3>
            <p class="text-xs text-slate-500 mt-1">Try adjusting your search keywords.</p>
        </div>
    </div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('candidateSearch');
        const candidateCards = document.querySelectorAll('.applicant-card');
        const emptyState = document.getElementById('searchEmptyState');

        if (!searchInput) return;

        searchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase().trim();
            let visibleCount = 0;

            candidateCards.forEach(card => {
                const cardData = (card.getAttribute('data-search-text') || '').toLowerCase();

                if (cardData.includes(searchTerm)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCount === 0 && candidateCards.length > 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        });
    });
</script>