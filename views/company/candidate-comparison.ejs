<% layout('layouts/boilerplate') %>

<div class="max-w-7xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/company/internships/<%= internship._id %>/applicants" class="text-xs font-semibold text-indigo-600 hover:underline flex items-center gap-1">
                    <i class="ph-bold ph-arrow-left text-xs"></i> Back to Applicants
                </a>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">
                    Candidate Comparison
                </span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
                Comparing Candidates for <%= internship ? internship.title : 'Internship' %>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
                Side-by-side evaluation of <%= applications.length %> selected applicants for <%= internship ? (internship.companyName || internship.company) : 'Organization' %>
            </p>
        </div>

        <a href="/company/internships/<%= internship._id %>/applicants" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg transition-colors inline-flex items-center gap-1.5 self-start sm:self-auto">
            <i class="ph-bold ph-users text-sm"></i> Return to Applicants List
        </a>
    </div>

    <!-- Required Skills Summary Header Card -->
    <% if (internship && Array.isArray(internship.requiredSkills) && internship.requiredSkills.length > 0) { %>
        <div class="bg-indigo-50/60 border border-indigo-100 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <i class="ph-bold ph-target text-indigo-600 text-lg"></i>
                <span class="text-xs font-bold text-slate-800">Internship Required Skills:</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
                <% internship.requiredSkills.forEach(skill => { %>
                    <span class="text-xs font-semibold bg-white border border-indigo-200 text-indigo-800 px-2.5 py-1 rounded-md shadow-2xs">
                        <%= skill %>
                    </span>
                <% }) %>
            </div>
        </div>
    <% } %>

    <!-- Side-by-Side Comparison Grid -->
    <div class="grid grid-cols-1 <%= applications.length === 2 ? 'md:grid-cols-2' : (applications.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2 lg:grid-cols-4') %> gap-6">
        <% applications.forEach((app, index) => { %>
            <% const candidate = app.candidate || {}; %>
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden">
                <!-- Candidate Header Card -->
                <div class="p-5 border-b border-slate-100 bg-slate-50/50 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded">
                            Candidate <%= index + 1 %>
                        </span>

                        <!-- Match Score -->
                        <span class="px-2.5 py-0.5 rounded-full border text-xs font-bold <%= (app.matchScore || 0) >= 75 ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : ((app.matchScore || 0) >= 40 ? 'bg-amber-50 border-amber-200 text-amber-700' : 'bg-rose-50 border-rose-200 text-rose-700') %>">
                            <%= app.matchScore || 0 %>% Fit
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-700 font-bold text-lg flex items-center justify-center border border-indigo-200 shrink-0">
                            <%= candidate.name ? candidate.name.charAt(0).toUpperCase() : 'C' %>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-base font-bold text-slate-900 truncate">
                                <%= candidate.name || 'Unknown Candidate' %>
                            </h3>
                            <p class="text-xs text-slate-500 truncate">
                                <%= candidate.email || 'No email' %>
                            </p>
                            <% if (candidate.age >= 18 && candidate.age <= 24) { %>
                                <span class="inline-block mt-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                                    PMIS Eligible
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="p-5 space-y-5 flex-1 divide-y divide-slate-100">

                    <!-- Application Status & Applied Date -->
                    <div class="space-y-2">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Application Details</h4>
                        <div class="flex flex-col gap-2">
                            <form action="/company/applications/<%= app._id %>/status" method="POST" data-loading-text="Updating...">
                                <label for="status-select-<%= app._id %>" class="sr-only">Status for <%= candidate.name || 'Candidate' %></label>
                                <select id="status-select-<%= app._id %>" name="status" onchange="if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); }"
                                    class="w-full px-3 py-1.5 text-xs font-semibold rounded-lg border shadow-sm cursor-pointer outline-none transition-colors <%=
                                        app.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                        app.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                        app.status === 'Under Review' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                        'bg-indigo-50 text-indigo-700 border-indigo-200'
                                    %>">
                                    <option value="Submitted" <%= app.status === 'Submitted' ? 'selected' : '' %>>Submitted</option>
                                    <option value="Under Review" <%= app.status === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                                    <option value="Shortlisted" <%= app.status === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                                    <option value="Rejected" <%= app.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                            </form>
                            <span class="text-xs text-slate-500 flex items-center gap-1">
                                <i class="ph-bold ph-calendar-blank text-slate-400"></i>
                                Applied: <%= app.appliedAt ? new Date(app.appliedAt).toLocaleDateString() : 'N/A' %>
                            </span>
                        </div>
                    </div>

                    <!-- Education & Qualification -->
                    <div class="pt-4 space-y-1.5">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Education & Qualification</h4>
                        <div class="text-xs text-slate-800 space-y-1">
                            <p class="font-semibold flex items-center gap-1.5">
                                <i class="ph-bold ph-graduation-cap text-indigo-500 text-sm"></i>
                                <%= (candidate.education && candidate.education.qualification) || candidate.qualification || 'N/A' %>
                            </p>
                            <p class="text-slate-500 flex items-center gap-1.5">
                                <i class="ph-bold ph-buildings text-slate-400 text-sm"></i>
                                <%= (candidate.education && candidate.education.institutionName) || candidate.institution || 'N/A' %>
                            </p>
                        </div>
                    </div>

                    <!-- Location & Demographics -->
                    <div class="pt-4 space-y-1.5">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Location & Demographics</h4>
                        <div class="text-xs text-slate-700 space-y-1">
                            <p class="flex items-center gap-1.5">
                                <i class="ph-bold ph-map-pin text-rose-500 text-sm"></i>
                                <%= candidate.location ? ((candidate.location.district ? candidate.location.district + ', ' : '') + (candidate.location.state || '')) : 'N/A' %>
                                <%= (!candidate.location || (!candidate.location.district && !candidate.location.state)) ? 'N/A' : '' %>
                            </p>
                            <p class="text-slate-500">Age: <span class="font-medium text-slate-700"><%= candidate.age || 'N/A' %></span></p>
                        </div>
                    </div>

                    <!-- Resume -->
                    <div class="pt-4 space-y-1.5">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Resume</h4>
                        <div>
                            <% const resumePath = candidate.resume || candidate.resumeUrl; %>
                            <% if (resumePath) { %>
                                <a href="<%= resumePath %>" target="_blank"
                                    class="w-full px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                    <i class="ph-bold ph-file-pdf text-sm"></i> View Resume
                                </a>
                            <% } else { %>
                                <span class="w-full px-3 py-1.5 bg-slate-100 text-slate-400 border border-slate-200 text-xs font-medium rounded-lg flex items-center justify-center gap-1">
                                    <i class="ph-bold ph-file-x text-sm"></i> No Resume Provided
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Internship Required Skills Comparison -->
                    <div class="pt-4 space-y-2">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                            <span>Required Skills Match</span>
                            <i class="ph-bold ph-check-square text-indigo-500 text-xs"></i>
                        </h4>

                        <% if (internship && Array.isArray(internship.requiredSkills) && internship.requiredSkills.length > 0) { %>
                            <div class="space-y-1.5">
                                <%
                                    const candidateSkillsLower = Array.isArray(candidate.skills) ? candidate.skills.map(s => String(s).trim().toLowerCase()) : [];
                                %>
                                <% internship.requiredSkills.forEach(reqSkill => { %>
                                    <% const hasSkill = candidateSkillsLower.includes(String(reqSkill).trim().toLowerCase()); %>
                                    <div class="flex items-center justify-between p-1.5 rounded-md text-xs <%= hasSkill ? 'bg-emerald-50/70 border border-emerald-100' : 'bg-slate-50 border border-slate-100' %>">
                                        <span class="font-medium text-slate-700"><%= reqSkill %></span>
                                        <% if (hasSkill) { %>
                                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700">
                                                <i class="ph-bold ph-check-circle text-emerald-600"></i> Yes
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-400">
                                                <i class="ph-bold ph-x-circle text-slate-300"></i> No
                                            </span>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic">No required skills specified for internship.</p>
                        <% } %>
                    </div>

                    <!-- All Candidate Skills -->
                    <div class="pt-4 space-y-1.5">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">All Candidate Skills</h4>
                        <div class="flex flex-wrap gap-1.5">
                            <% if (Array.isArray(candidate.skills) && candidate.skills.length > 0) { %>
                                <% candidate.skills.forEach(skill => { %>
                                    <span class="text-[11px] font-medium bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded">
                                        <%= skill %>
                                    </span>
                                <% }) %>
                            <% } else { %>
                                <span class="text-xs text-slate-400 italic">No skills listed.</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Candidate Notes Section -->
                    <div class="pt-4 space-y-2">
                        <h4 class="text-xs font-bold text-slate-700 flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <i class="ph-bold ph-note-pencil text-indigo-600 text-sm"></i>
                                Notes (<%= Array.isArray(app.notes) ? app.notes.length : 0 %>)
                            </span>
                        </h4>

                        <% if (Array.isArray(app.notes) && app.notes.length > 0) { %>
                            <div class="space-y-2 max-h-40 overflow-y-auto pr-1">
                                <% app.notes.forEach(note => { %>
                                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs space-y-1">
                                        <div class="flex items-center justify-between text-slate-500">
                                            <span class="font-semibold text-slate-700">
                                                <%= note.createdBy ? (note.createdBy.companyDetails?.companyName || note.createdBy.name || 'Company') : 'Company' %>
                                            </span>
                                            <span class="text-[10px] text-slate-400">
                                                <%= new Date(note.createdAt).toLocaleDateString() %>
                                            </span>
                                        </div>
                                        <p class="text-slate-700 whitespace-pre-line"><%= note.text %></p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic">No notes added yet.</p>
                        <% } %>

                        <form action="/company/applications/<%= app._id %>/notes" method="POST" class="flex items-center gap-2 pt-1" data-loading-text="Adding...">
                            <input type="text" name="text" placeholder="Add note..." required
                                class="flex-1 px-2.5 py-1.5 text-xs border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500 bg-slate-50 focus:bg-white transition-colors" />
                            <button type="submit"
                                class="px-2.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors shrink-0">
                                Add
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        <% }) %>
    </div>
</div>
