<% layout('layouts/boilerplate') %>
<% const permissionList = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : []; %>
<% const canReviewApplications = permissionList.includes('applications:review'); %>
<% const canIssueOffer = canReviewApplications && ['Shortlisted', 'Interview'].includes(application.status); %>
<% const candidateSkillProfiles = (typeof skillProfiles !== 'undefined' && Array.isArray(skillProfiles) && skillProfiles.length)
    ? skillProfiles
    : ((candidate && Array.isArray(candidate.skills))
        ? candidate.skills.map(name => ({ name, proficiency: 'Intermediate' }))
        : []); %>
<% const safeMeetingLink = application && application.interview
    ? sanitizeHttpUrl(application.interview.meetingLink).url
    : ''; %>
<% const safeStoredFileUrl = value => {
    const raw = typeof value === 'string' ? value.trim() : '';
    return /^\/uploads\/(?:resumes|documents)\//.test(raw) ? raw : sanitizeHttpUrl(raw).url;
}; %>
<% const submittedResumeUrl = application && application.applicationKit && application.applicationKit.resume
    ? safeStoredFileUrl(application.applicationKit.resume.fileUrl)
    : ''; %>

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Back Navigation -->
    <div class="flex items-center gap-2">
        <a href="/company/internships/<%= internship._id %>/applicants"
            class="text-xs font-semibold text-indigo-600 hover:underline flex items-center gap-1">
            <i class="ph-bold ph-arrow-left text-sm"></i> Back to Applicants
        </a>
        <span class="text-slate-300">&bull;</span>
        <span class="text-xs text-slate-500"><%= internship.title %></span>
    </div>

    <!-- Header Card -->
    <div
        class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div class="flex items-center gap-5">
            <% if (candidate.avatar) { %>
                <img src="<%= candidate.avatar %>" alt="<%= candidate.name %>"
                    class="w-16 h-16 rounded-full object-cover border-2 border-indigo-200">
            <% } else { %>
                <div
                    class="w-16 h-16 bg-indigo-100 text-indigo-700 font-extrabold text-2xl rounded-full flex items-center justify-center border-2 border-indigo-200">
                    <%= candidate.name ? candidate.name.charAt(0).toUpperCase() : 'U' %>
                </div>
            <% } %>
            <div>
                <h1 class="text-xl font-bold text-slate-800 tracking-tight">
                    <%= candidate.name || 'Unknown Candidate' %>
                </h1>
                <p class="text-xs text-slate-500 font-medium flex items-center gap-1 mt-1">
                    <i class="ph-bold ph-map-pin text-rose-500 text-sm"></i>
                    <%= (candidate.location && typeof candidate.location === 'object')
                        ? ([candidate.location.district, candidate.location.state].filter(Boolean).join(', ') || 'Location Not Provided')
                        : (candidate.location || 'Location Not Provided') %>
                </p>
                <% const candidateEligible = (typeof eligibility !== 'undefined' && eligibility) ? eligibility.isEligible : (typeof checkPmisEligibility === 'function' ? checkPmisEligibility(candidate).isEligible : (candidate.age && candidate.age >= 21 && candidate.age <= 24 && candidate.familyIncome && candidate.familyIncome <= 800000)); %>
                <% if (candidateEligible) { %>
                    <span
                        class="inline-block mt-1.5 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                        PMIS Eligible
                    </span>
                <% } %>
            </div>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
            <% const resumeUrl = submittedResumeUrl || safeStoredFileUrl(candidate.resume || candidate.resumeUrl); %>
            <% if (resumeUrl) { %>
                <a href="<%= resumeUrl %>" target="_blank"
                    class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                    <i class="ph-bold ph-file-pdf text-sm"></i> <%= submittedResumeUrl ? 'View Submitted Resume' : 'View Resume' %>
                </a>
            <% } else { %>
                <span
                    class="px-4 py-2 bg-slate-100 text-slate-400 border border-slate-200 text-xs font-medium rounded-lg flex items-center gap-1.5">
                    <i class="ph-bold ph-file-x text-sm"></i> No Resume Uploaded
                </span>
            <% } %>
            <% if (typeof messageUnreadCount !== 'undefined') { %><%- include('../partials/message-start-button', { application, label: 'Message candidate' }) %><% } %>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Sidebar -->
        <div class="space-y-6">

            <!-- Application Context Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2
                    class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="ph-bold ph-briefcase text-indigo-600 text-lg"></i>
                    Application Info
                </h2>

                <div class="space-y-3 text-xs">
                    <div>
                        <span class="text-slate-400 font-medium block">Internship Applied For</span>
                        <span class="font-bold text-slate-700 text-sm"><%= internship.title %></span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Company</span>
                        <span class="font-bold text-slate-700 text-sm"><%= internship.companyName || 'N/A' %></span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block mb-1">Application Status</span>
                        <% const isReadOnlyStatus = ['Withdrawn', 'withdrawn', 'Hired', 'Offer Declined'].includes(application.status); %>
                        <% if (!isReadOnlyStatus && canReviewApplications) { %>
                            <form action="/company/applications/<%= application._id %>/status"
                                method="POST" class="inline-block">
                                <select name="status" onchange="this.form.submit()" class="px-3 py-1.5 text-xs font-semibold rounded-lg border shadow-sm cursor-pointer outline-none transition-colors <%=
                                application.status === 'Hired' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                application.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                application.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                application.status === 'Under Review' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                'bg-indigo-50 text-indigo-700 border-indigo-200'
                            %>">
                                    <option value="Submitted" <%= application.status === 'Submitted' ? 'selected' : '' %>>Submitted</option>
                                    <option value="Under Review" <%= application.status === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                                    <option value="Shortlisted" <%= application.status === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                                    <option value="Interview" <%= application.status === 'Interview' ? 'selected' : '' %>>Interview</option>
                                    <option value="Hired" <%= application.status === 'Hired' ? 'selected' : '' %>>Hired</option>
                                    <option value="Rejected" <%= application.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                            </form>
                        <% } else { %>
                            <span class="inline-block px-3 py-1.5 text-xs font-semibold rounded-lg border <%=
                                application.status === 'Hired' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                application.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                application.status === 'Rejected' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                application.status === 'Under Review' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                'bg-indigo-50 text-indigo-700 border-indigo-200'
                            %>">
                                <%= application.status || 'Submitted' %>
                            </span>
                        <% } %>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Match Score</span>
                        <span class="inline-block mt-1 px-3 py-1 rounded-lg border text-xs font-bold <%=
                            (application.matchScore || 0) >= 75 ? 'bg-emerald-50 border-emerald-200 text-emerald-700' :
                            ((application.matchScore || 0) >= 40 ? 'bg-amber-50 border-amber-200 text-amber-700' :
                            'bg-rose-50 border-rose-200 text-rose-700')
                        %>">
                            <%= application.matchScore || 0 %>%
                        </span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Applied On</span>
                        <span class="font-bold text-slate-700 text-sm">
                            <%= application.appliedAt ? new Date(application.appliedAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %>
                        </span>
                    </div>
                </div>
            </div>

            <% if (canReviewApplications && application.status === 'Hired') { %>
                <div class="bg-white border border-indigo-200 rounded-2xl p-6 shadow-sm space-y-4">
                    <div class="border-b border-indigo-100 pb-3">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="ph-bold ph-files text-indigo-600 text-lg"></i>
                            Internship documents
                        </h2>
                        <p class="mt-1 text-xs text-slate-500">Issue a certificate and recommendation letter as downloadable PDFs for the candidate.</p>
                    </div>
                    <form action="/company/applications/<%= application._id %>/certificates/issues" method="POST">
                        <button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-indigo-700">
                            <i class="ph-bold ph-seal-check mr-1" aria-hidden="true"></i> Issue Certificate &amp; LOR
                        </button>
                    </form>
                </div>
            <% } %>

            <% if (canIssueOffer) { %>
                <div class="bg-white border border-emerald-200 rounded-2xl p-6 shadow-sm space-y-4">
                    <div class="border-b border-emerald-100 pb-3">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="ph-bold ph-seal-check text-emerald-600 text-lg"></i>
                            Issue formal offer
                        </h2>
                        <p class="mt-1 text-xs text-slate-500">The candidate can accept or decline before the expiry time.</p>
                    </div>
                    <form id="issueOfferForm" action="/company/applications/<%= application._id %>/offers" method="POST" class="space-y-3">
                        <div>
                            <label for="offer-expiry" class="block text-xs font-semibold text-slate-700 mb-1">Offer expiry (IST) *</label>
                            <input id="offer-expiry" type="datetime-local" name="expiresAt" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="offer-start-date" class="block text-xs font-semibold text-slate-700 mb-1">Start date</label>
                                <input id="offer-start-date" type="date" name="startDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600">
                            </div>
                            <div>
                                <label for="offer-stipend" class="block text-xs font-semibold text-slate-700 mb-1">Monthly stipend</label>
                                <input id="offer-stipend" type="number" min="0" name="monthlyStipend" value="<%= internship.monthlyStipend || 0 %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600">
                            </div>
                        </div>
                        <div>
                            <label for="offer-duration" class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                            <input id="offer-duration" type="text" maxlength="120" name="duration" value="<%= internship.duration || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        </div>
                        <div>
                            <label for="offer-terms" class="block text-xs font-semibold text-slate-700 mb-1">Additional terms</label>
                            <textarea id="offer-terms" name="additionalTerms" rows="3" maxlength="2000" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" placeholder="Optional instructions or conditions"></textarea>
                        </div>
                        <button type="submit" class="w-full rounded-lg bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-emerald-700">
                            Issue offer
                        </button>
                    </form>
                </div>
            <% } %>

            <!-- Interview Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2 class="text-sm font-bold text-slate-800 flex items-center justify-between border-b border-slate-100 pb-3">
                    <span class="flex items-center gap-2">
                        <i class="ph-bold ph-calendar text-indigo-600 text-lg"></i>
                        Interview
                    </span>
                    <% if (application.interview && application.interview.status && application.interview.status !== 'Cancelled') { %>
                        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full
                            <%= application.interview.status === 'Scheduled' ? 'bg-indigo-50 text-indigo-700' : 'bg-amber-50 text-amber-700' %>">
                            <%= application.interview.status %>
                        </span>
                    <% } else if (application.interview && application.interview.status === 'Cancelled') { %>
                        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700">
                            Cancelled
                        </span>
                    <% } %>
                </h2>

                <% if (application.interview && application.interview.status && application.interview.status !== 'Cancelled') { %>
                    <div class="space-y-3 text-xs">
                        <div>
                            <span class="text-slate-400 font-medium block">Date & Time (IST)</span>
                            <span class="font-bold text-slate-700 text-sm">
                                <%= application.interview.scheduledAt ? new Date(application.interview.scheduledAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) : 'N/A' %>
                            </span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div>
                                <span class="text-slate-400 font-medium block">Duration</span>
                                <span class="font-bold text-slate-700 text-sm"><%= application.interview.duration %> mins</span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Mode</span>
                                <span class="font-bold text-slate-700 text-sm"><%= application.interview.mode %></span>
                            </div>
                        </div>
                        <% if (application.interview.mode === 'Online' && safeMeetingLink) { %>
                            <div>
                                <span class="text-slate-400 font-medium block">Meeting Link</span>
                                <a href="<%= safeMeetingLink %>" target="_blank" rel="noopener noreferrer" class="font-bold text-indigo-600 hover:underline break-all"><%= safeMeetingLink %></a>
                            </div>
                        <% } else if (application.interview.mode === 'In-Person' && application.interview.location) { %>
                            <div>
                                <span class="text-slate-400 font-medium block">Location</span>
                                <span class="font-bold text-slate-700"><%= application.interview.location %></span>
                            </div>
                        <% } %>
                        <% if (application.interview.instructions) { %>
                            <div>
                                <span class="text-slate-400 font-medium block">Instructions</span>
                                <p class="text-slate-700 mt-0.5 p-2 bg-slate-50 rounded border border-slate-100 whitespace-pre-line"><%= application.interview.instructions %></p>
                            </div>
                        <% } %>
                    </div>

                    <% if (canReviewApplications) { %>
                        <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
                            <button type="button" onclick="openScheduleModal(true)" class="w-full px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg transition-colors border border-indigo-200">
                                Reschedule Interview
                            </button>
                            <button type="button" onclick="document.getElementById('cancelInterviewModal').classList.remove('hidden')" class="w-full px-4 py-2 bg-white hover:bg-rose-50 text-rose-600 text-xs font-semibold rounded-lg transition-colors border border-rose-200">
                                Cancel Interview
                            </button>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-4">
                        <p class="text-xs text-slate-500 mb-3">
                            <%= application.interview && application.interview.status === 'Cancelled' ? 'The previous interview was cancelled.' : 'No interview has been scheduled yet.' %>
                        </p>
                        <% if (canReviewApplications && !['Rejected', 'rejected', 'Withdrawn', 'withdrawn', 'Hired', 'Offer Declined'].includes(application.status)) { %>
                            <button type="button" onclick="openScheduleModal(false)" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors w-full shadow-sm">
                                Schedule Interview
                            </button>
                        <% } else if (canReviewApplications) { %>
                            <p class="text-xs text-rose-500 italic">Cannot schedule an interview after a final application outcome.</p>
                        <% } else { %>
                            <p class="text-xs text-slate-500 italic">Interview scheduling is available to Admins and Recruiters.</p>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Certificate & LOR Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2 class="text-sm font-bold text-slate-800 flex items-center justify-between border-b border-slate-100 pb-3">
                    <span class="flex items-center gap-2">
                        <i class="ph-bold ph-certificate text-amber-500 text-lg"></i>
                        Completion Credential
                    </span>
                    <% if (typeof certificate !== 'undefined' && certificate) { %>
                        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                            Issued
                        </span>
                    <% } else { %>
                        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
                            Pending
                        </span>
                    <% } %>
                </h2>

                <% if (typeof certificate !== 'undefined' && certificate) { %>
                    <div class="space-y-3 text-xs">
                        <div>
                            <span class="text-slate-400 font-medium block">Certificate ID</span>
                            <span class="font-mono font-bold text-slate-800 tracking-wider text-xs bg-slate-100 px-2 py-1 rounded inline-block">
                                <%= certificate.certificateId %>
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-slate-400 font-medium block">Rating</span>
                                <span class="font-bold text-amber-600"><%= certificate.performanceRating %></span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Tenure</span>
                                <span class="font-bold text-slate-700"><%= certificate.duration %></span>
                            </div>
                        </div>
                        <% if (certificate.letterOfRecommendation) { %>
                            <div class="flex items-center gap-1.5 text-indigo-700 font-semibold text-[11px] bg-indigo-50 p-2 rounded-lg border border-indigo-100">
                                <i class="ph-bold ph-file-text text-sm"></i> Includes Letter of Recommendation
                            </div>
                        <% } %>
                        <div class="pt-2">
                            <a href="/certificates/<%= certificate.certificateId %>/view" target="_blank"
                                class="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                <i class="ph-bold ph-arrow-square-out text-sm"></i> View & Print Certificate
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center py-2 space-y-2">
                        <p class="text-xs text-slate-500">
                            Issue an official Certificate of Completion and optional Letter of Recommendation with a tamper-proof verification ID.
                        </p>
                        <% if (canReviewApplications && !['Rejected', 'rejected', 'Withdrawn', 'withdrawn'].includes(application.status)) { %>
                            <a href="/company/applications/<%= application._id %>/certificate/issue"
                                class="w-full px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1.5 shadow-sm">
                                <i class="ph-bold ph-seal-check text-sm"></i> Issue Certificate & LOR
                            </a>
                        <% } else if (['Rejected', 'rejected', 'Withdrawn', 'withdrawn'].includes(application.status)) { %>
                            <p class="text-xs text-slate-400 italic">Credentials cannot be issued for rejected or withdrawn candidates.</p>
                        <% } else { %>
                            <p class="text-xs text-slate-400 italic">Available to Recruiters & Admins.</p>
                        <% } %>
                    </div>
                <% } %>
            </div>

        </div>

        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Candidate Details Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2
                    class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="ph-bold ph-user text-indigo-600 text-lg"></i>
                    Candidate Details
                </h2>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                    <div>
                        <span class="text-slate-400 font-medium block">Age</span>
                        <span class="font-bold text-slate-700 text-sm">
                            <%= candidate.age ? candidate.age : 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Qualification</span>
                        <span class="font-bold text-slate-700 text-sm">
                            <%= (candidate.education && candidate.education.qualification) ? candidate.education.qualification : 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Institution</span>
                        <span class="font-bold text-slate-700 text-sm">
                            <%= candidate.institution || candidate.education?.institutionName || candidate.institutionName || 'N/A' %>
                        </span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Family Income</span>
                        <span class="font-bold text-slate-700 text-sm">
                            <%= candidate.familyIncome ? '₹' + Number(candidate.familyIncome).toLocaleString('en-IN') + '/yr' : 'N/A' %>
                        </span>
                    </div>
                </div>

                <div
                    class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-800 flex items-center gap-2">
                    <i class="ph-bold ph-warning text-amber-600 text-sm shrink-0"></i>
                    Review PMIS Criteria (Age: 21–24, Family Income &lt; ₹8 Lakhs/year)
                </div>
            </div>

            <%- include('../partials/application-kit-summary', { applicationKit: application.applicationKit }) %>

            <!-- Skills Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2
                    class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="ph-bold ph-gear text-indigo-600 text-lg"></i>
                    Skills
                </h2>

                <% if (candidateSkillProfiles.length > 0) { %>
                    <div class="flex flex-wrap gap-2">
                        <% candidateSkillProfiles.forEach(skill => { %>
                            <span
                                class="inline-flex items-center gap-1.5 bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm">
                                <%= skill.name %>
                                <span class="rounded bg-white/80 px-1.5 py-0.5 text-[10px] font-bold text-indigo-800" aria-label="<%= skill.name %> proficiency: <%= skill.proficiency %>"><%= skill.proficiency %></span>
                            </span>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-xs text-slate-400 italic">No skills added yet.</p>
                <% } %>
            </div>

            <!-- Projects Card (future-ready) -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2
                    class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="ph-bold ph-code text-indigo-600 text-lg"></i>
                    Projects
                </h2>

                <% if (candidate.projects && candidate.projects.length > 0) { %>
                    <div class="space-y-3">
                        <% candidate.projects.forEach(project => { %>
                            <div class="border border-slate-100 rounded-lg p-3">
                                <h4 class="text-sm font-bold text-slate-800"><%= project.title || project.name || 'Untitled' %></h4>
                                <% if (project.description) { %>
                                    <p class="text-xs text-slate-500 mt-1"><%= project.description %></p>
                                <% } %>
                                <% if (project.techStack && project.techStack.length > 0) { %>
                                    <div class="flex flex-wrap gap-1.5 mt-2">
                                        <% project.techStack.forEach(tech => { %>
                                            <span class="bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold px-2 py-0.5 rounded"><%= tech %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                                <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                    <% if (project.link) { %>
                                        <a href="<%= project.link %>" target="_blank" rel="noopener noreferrer" class="text-xs text-indigo-600 hover:underline inline-block">View Project</a>
                                    <% } %>
                                    <% if (project.fileUrl) { %>
                                        <a href="<%= project.fileUrl %>" target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-700 hover:underline font-semibold inline-block">
                                            <i class="ph-bold ph-paperclip"></i> <%= project.fileName || 'View Attachment' %>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-xs text-slate-400 italic">No projects added yet.</p>
                <% } %>
            </div>

            <!-- Certifications Card (future-ready) -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <h2
                    class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="ph-bold ph-certificate text-indigo-600 text-lg"></i>
                    Certifications
                </h2>

                <% if (candidate.certifications && candidate.certifications.length > 0) { %>
                    <div class="space-y-3">
                        <% candidate.certifications.forEach(cert => { %>
                            <div class="border border-slate-100 rounded-lg p-3">
                                <h4 class="text-sm font-bold text-slate-800"><%= cert.name || cert.title || 'Untitled' %></h4>
                                <% if (cert.issuer) { %>
                                    <p class="text-xs text-slate-500 mt-0.5">Issued by: <%= cert.issuer %></p>
                                <% } %>
                                <% if (cert.issueDate) { %>
                                    <p class="text-xs text-slate-400 mt-0.5"><%= new Date(cert.issueDate).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %></p>
                                <% } %>
                                <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                    <% if (cert.link) { %>
                                        <a href="<%= cert.link %>" target="_blank" rel="noopener noreferrer" class="text-xs text-indigo-600 hover:underline inline-block">Credential Link</a>
                                    <% } %>
                                    <% if (cert.fileUrl) { %>
                                        <a href="<%= cert.fileUrl %>" target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-700 hover:underline font-semibold inline-block">
                                            <i class="ph-bold ph-paperclip"></i> <%= cert.fileName || 'View Certificate' %>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-xs text-slate-400 italic">No certifications added yet.</p>
                <% } %>
            </div>

        </div>
    </div>

</div>

<% if (canReviewApplications) { %>
<!-- Interview Modals -->
<div id="scheduleInterviewModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900" id="scheduleModalTitle">Schedule Interview</h3>
            <button type="button" onclick="document.getElementById('scheduleInterviewModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="ph-bold ph-x text-xl"></i>
            </button>
        </div>
        <form id="scheduleInterviewForm" method="POST" action="/company/applications/<%= application._id %>/interview/schedule" class="p-6 space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Date & Time (IST) *</label>
                <%
                    let dtLocal = '';
                    if (application.interview && application.interview.scheduledAt) {
                        const d = new Date(application.interview.scheduledAt);
                        const istOffset = 5.5 * 60 * 60 * 1000;
                        const istDate = new Date(d.getTime() + istOffset);
                        dtLocal = istDate.toISOString().slice(0, 16);
                    }
                %>
                <input type="datetime-local" name="scheduledAt" required value="<%= dtLocal %>" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Duration *</label>
                    <select name="duration" required class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
                        <option value="15" <%= application.interview?.duration === 15 ? 'selected' : '' %>>15 mins</option>
                        <option value="30" <%= !application.interview || application.interview.duration === 30 ? 'selected' : '' %>>30 mins</option>
                        <option value="45" <%= application.interview?.duration === 45 ? 'selected' : '' %>>45 mins</option>
                        <option value="60" <%= application.interview?.duration === 60 ? 'selected' : '' %>>60 mins</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Mode *</label>
                    <select name="mode" id="interviewModeSelect" required onchange="toggleInterviewModeFields()" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
                        <option value="Online" <%= application.interview?.mode === 'Online' ? 'selected' : '' %>>Online</option>
                        <option value="Phone" <%= application.interview?.mode === 'Phone' ? 'selected' : '' %>>Phone</option>
                        <option value="In-Person" <%= application.interview?.mode === 'In-Person' ? 'selected' : '' %>>In-Person</option>
                    </select>
                </div>
            </div>

            <div id="onlineModeField" class="<%= application.interview?.mode && application.interview.mode !== 'Online' ? 'hidden' : '' %>">
                <label class="block text-xs font-semibold text-slate-700 mb-1">Meeting Link *</label>
                <input type="url" name="meetingLink" id="meetingLinkInput" value="<%= application.interview?.meetingLink || '' %>" placeholder="e.g. https://meet.google.com/..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
            </div>

            <div id="inPersonModeField" class="<%= application.interview?.mode !== 'In-Person' ? 'hidden' : '' %>">
                <label class="block text-xs font-semibold text-slate-700 mb-1">Location *</label>
                <input type="text" name="location" id="locationInput" value="<%= application.interview?.location || '' %>" placeholder="e.g. Office address, Room 302" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Instructions for Candidate (Optional)</label>
                <textarea name="instructions" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none"><%= application.interview?.instructions || '' %></textarea>
            </div>

            <div class="pt-4 flex gap-3">
                <button type="button" onclick="document.getElementById('scheduleInterviewModal').classList.add('hidden')" class="flex-1 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg text-sm transition-colors">Cancel</button>
                <button type="submit" id="scheduleSubmitBtn" class="flex-1 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm transition-colors shadow-sm">Schedule</button>
            </div>
        </form>
    </div>
</div>

<div id="cancelInterviewModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-rose-600">Cancel Interview</h3>
            <button type="button" onclick="document.getElementById('cancelInterviewModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="ph-bold ph-x text-xl"></i>
            </button>
        </div>
        <form method="POST" action="/company/applications/<%= application._id %>/interview/cancel" class="p-6 space-y-4">
            <p class="text-sm text-slate-600">Are you sure you want to cancel the scheduled interview? The candidate will be notified via email.</p>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Reason for Cancellation (Optional, shared with candidate)</label>
                <textarea name="cancelReason" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
            </div>

            <div class="pt-4 flex gap-3">
                <button type="button" onclick="document.getElementById('cancelInterviewModal').classList.add('hidden')" class="flex-1 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg text-sm transition-colors">Keep Interview</button>
                <button type="submit" class="flex-1 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-lg text-sm transition-colors shadow-sm">Cancel Interview</button>
            </div>
        </form>
    </div>
</div>

<script>
function toggleInterviewModeFields() {
    const mode = document.getElementById('interviewModeSelect').value;
    const onlineField = document.getElementById('onlineModeField');
    const inPersonField = document.getElementById('inPersonModeField');
    const meetingLink = document.getElementById('meetingLinkInput');
    const location = document.getElementById('locationInput');

    if (mode === 'Online') {
        onlineField.classList.remove('hidden');
        inPersonField.classList.add('hidden');
        meetingLink.required = true;
        location.required = false;
    } else if (mode === 'In-Person') {
        onlineField.classList.add('hidden');
        inPersonField.classList.remove('hidden');
        meetingLink.required = false;
        location.required = true;
    } else {
        onlineField.classList.add('hidden');
        inPersonField.classList.add('hidden');
        meetingLink.required = false;
        location.required = false;
    }
}

function openScheduleModal(isReschedule) {
    document.getElementById('scheduleInterviewModal').classList.remove('hidden');
    document.getElementById('scheduleModalTitle').textContent = isReschedule ? 'Reschedule Interview' : 'Schedule Interview';
    document.getElementById('scheduleSubmitBtn').textContent = isReschedule ? 'Save Changes' : 'Schedule';

    const form = document.getElementById('scheduleInterviewForm');
    const actionBase = "/company/applications/<%= application._id %>/interview";
    form.action = actionBase + (isReschedule ? '/reschedule' : '/schedule');

    toggleInterviewModeFields();
}
</script>
<% } %>
