<%
    // Admin dashboard card (#161). The counts come from routes/grievances.js.
    const s = typeof summary !== 'undefined' && summary ? summary : { active: 0, overdue: 0 };
%>
<a href="/admin/grievances" id="grievanceDeskCard" aria-label="Open grievance desk, <%= s.active %> open grievances<%= s.overdue ? `, ${s.overdue} overdue` : '' %>"
    class="group rounded-lg border <%= s.overdue ? 'border-rose-200 dark:border-rose-900' : 'border-slate-200 dark:border-slate-800' %> bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:bg-slate-900">
    <div class="flex items-start justify-between gap-3">
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Grievance desk</p>
            <p class="mt-3 text-3xl font-bold text-slate-950 dark:text-white"><%= s.active %></p>
        </div>
        <span class="rounded-lg <%= s.overdue ? 'bg-rose-50 text-rose-700 dark:bg-rose-950 dark:text-rose-300' : 'bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300' %> p-2.5"><i class="ph-bold ph-chat-circle-text text-xl" aria-hidden="true"></i></span>
    </div>
    <p class="mt-3 flex items-center justify-between gap-2 text-xs">
        <span class="text-slate-500 dark:text-slate-400"><% if (s.overdue) { %><span class="font-semibold text-rose-700 dark:text-rose-300"><%= s.overdue %> overdue</span><% } else { %>Open grievances<% } %></span>
        <span class="font-semibold text-indigo-700 group-hover:underline dark:text-indigo-300">Open desk <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></span>
    </p>
</a>
