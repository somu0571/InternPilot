<% layout('layouts/boilerplate') %>

    <div class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">

        <header class="flex flex-col gap-5 border-b border-slate-200 pb-6 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-center gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-bold text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300" aria-hidden="true"><%= String(user.name || 'A').split(/\s+/).map(part => part[0]).join('').slice(0, 2).toUpperCase() %></span>
                <div class="min-w-0">
                    <p class="text-sm text-slate-500 dark:text-slate-400">Welcome back, <span class="font-semibold text-slate-800 dark:text-slate-100"><%= user.name %></span></p>
                    <h1 class="text-2xl font-bold text-slate-950 dark:text-white">Admin dashboard</h1>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-300">
                    <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true"></span>System operational
                </span>
                <a href="/admin/overview" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <i class="ph-bold ph-chart-line-up" aria-hidden="true"></i>Admin console
                </a>
            </div>
        </header>

        <section aria-label="Platform metrics" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-animate-stagger>
            <article class="rounded-lg border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total candidates</p><p class="mt-3 text-3xl font-bold text-slate-950 dark:text-white" data-count-up><%= stats.candidates %></p></div><span class="rounded-lg bg-sky-50 p-2.5 text-sky-700 dark:bg-sky-950 dark:text-sky-300"><i class="ph-bold ph-users-three text-xl" aria-hidden="true"></i></span></div>
                <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Candidate accounts</p>
            </article>
            <article class="rounded-lg border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500 dark:text-slate-400">Registered companies</p><p class="mt-3 text-3xl font-bold text-slate-950 dark:text-white" data-count-up><%= stats.companies %></p></div><span class="rounded-lg bg-indigo-50 p-2.5 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300"><i class="ph-bold ph-buildings text-xl" aria-hidden="true"></i></span></div>
                <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Company accounts</p>
            </article>
            <article class="rounded-lg border border-amber-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-amber-900 dark:bg-slate-900">
                <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500 dark:text-slate-400">Pending verifications</p><p class="mt-3 text-3xl font-bold text-amber-700 dark:text-amber-300" data-count-up><%= stats.pendingVerifications %></p></div><span class="rounded-lg bg-amber-50 p-2.5 text-amber-700 dark:bg-amber-950 dark:text-amber-300"><i class="ph-bold ph-shield-warning text-xl" aria-hidden="true"></i></span></div>
                <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Awaiting review</p>
            </article>
            <% if (typeof grievanceSummary !== 'undefined' && grievanceSummary) { %><%- include('../grievances/admin-summary', { summary: grievanceSummary }) %><% } %>
        </section>

        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 px-5 py-4 dark:border-slate-800 sm:px-6">
                <div><h2 class="text-lg font-bold text-slate-950 dark:text-white">Pending company verifications</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Review submitted details and supporting documents.</p></div>
                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-950 dark:text-amber-300"><%= stats.pendingVerifications %> pending</span>
            </div>

            <% if (pendingCompanies && pendingCompanies.length> 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400">
                                <th class="py-3 px-6">Company Name</th>
                                <th class="py-3 px-6">Email</th>
                                <th class="py-3 px-6">CIN</th>
                                <th class="py-3 px-6">Industry</th>
                                <th class="py-3 px-6">Documents</th>
                                <th class="py-3 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm dark:divide-slate-800">
                            <% pendingCompanies.forEach(comp=> { %>
                                <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <td class="px-5 py-4 font-semibold text-slate-900 dark:text-slate-100 sm:px-6">
                                        <%= (comp.companyDetails && comp.companyDetails.companyName) ?
                                            comp.companyDetails.companyName : comp.name %>
                                    </td>
                                    <td class="px-5 py-4 text-slate-600 dark:text-slate-300 sm:px-6">
                                        <%= comp.email %>
                                    </td>
                                    <td class="px-5 py-4 text-slate-600 dark:text-slate-300 sm:px-6">
                                        <% if (comp.companyDetails && comp.companyDetails.cin) { %><span class="rounded bg-slate-100 px-2 py-1 font-mono text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300"><%= comp.companyDetails.cin %></span><% } else { %><span class="text-slate-400">Not provided</span><% } %>
                                    </td>
                                    <td class="px-5 py-4 text-slate-600 dark:text-slate-300 sm:px-6">
                                        <%= (comp.companyDetails && comp.companyDetails.industry) ?
                                            comp.companyDetails.industry : 'N/A' %>
                                    </td>
                                    <td class="px-5 py-4 text-xs text-slate-600 dark:text-slate-300 sm:px-6">
                                        <% const documents = comp.companyDetails && Array.isArray(comp.companyDetails.verificationDocuments) ? comp.companyDetails.verificationDocuments : []; %>
                                        <% if (documents.length) { %>
                                            <div class="flex flex-col gap-1">
                                                <% documents.forEach(document => { %>
                                                    <a href="<%= document.fileUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-indigo-700 hover:underline dark:text-indigo-300"><i class="ph ph-file-text" aria-hidden="true"></i><%= document.fileName %></a>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">No documents</span>
                                        <% } %>
                                    </td>
                                    <td class="px-5 py-4 text-right sm:px-6">
                                        <% if (comp.companyDetails && comp.companyDetails.verificationReason) { %>
                                            <p class="mb-2 max-w-xs text-left text-xs text-amber-700"><%= comp.companyDetails.verificationReason %></p>
                                        <% } %>
                                        <div class="flex flex-wrap items-center justify-end gap-2">
                                        <form action="/admin/approve-company/<%= comp._id %>" method="POST"
                                            class="inline">
                                            <button type="submit"
                                                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">
                                                <i class="ph-bold ph-check" aria-hidden="true"></i>Approve
                                            </button>
                                        </form>
                                        <button type="button" data-reject-action="/admin/reject-company/<%= comp._id %>" data-company-name="<%= (comp.companyDetails && comp.companyDetails.companyName) ? comp.companyDetails.companyName : comp.name %>" class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 px-3 py-2 text-xs font-semibold text-rose-700 transition-colors hover:bg-rose-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600 dark:border-rose-900 dark:text-rose-300 dark:hover:bg-rose-950/50"><i class="ph-bold ph-x" aria-hidden="true"></i>Reject</button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="px-6 py-14 text-center">
                        <i class="ph ph-seal-check text-3xl text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
                        <p class="mt-3 font-semibold text-slate-800 dark:text-slate-100">All caught up</p>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">No pending company verifications.</p>
                    </div>
                    <% } %>
        </section>

        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
            <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800 sm:px-6">
                <h2 class="text-lg font-bold text-slate-950 dark:text-white">Approved companies</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Suspending a company immediately closes its published and paused listings.</p>
            </div>
            <% if (typeof approvedCompanies !== 'undefined' && approvedCompanies && approvedCompanies.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400">
                                <th class="py-3 px-6">Company Name</th>
                                <th class="py-3 px-6">Email</th>
                                <th class="py-3 px-6">Approved</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm dark:divide-slate-800">
                            <% approvedCompanies.forEach(comp => { %>
                                <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <td class="px-5 py-4 font-semibold text-slate-900 dark:text-slate-100 sm:px-6"><%= comp.companyDetails?.companyName || comp.name %></td>
                                    <td class="px-5 py-4 text-slate-600 dark:text-slate-300 sm:px-6"><%= comp.email %></td>
                                    <td class="px-5 py-4 text-slate-600 dark:text-slate-300 sm:px-6"><%= comp.companyDetails?.verificationReviewedAt ? new Date(comp.companyDetails.verificationReviewedAt).toLocaleDateString('en-IN') : 'Legacy approval' %></td>
                                    <td class="px-5 py-4 text-right sm:px-6">
                                        <form action="/admin/suspend-company/<%= comp._id %>" method="POST" class="flex items-center justify-end gap-2" data-confirm="Suspend this company and close all of its listings?" data-confirm-action="Suspend">
                                            <input type="text" name="reason" required maxlength="1000" placeholder="Reason for suspension" class="w-40 rounded-md border border-slate-300 bg-white px-2 py-2 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
                                            <button type="submit" class="rounded-lg bg-rose-700 px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-rose-800">Suspend</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="p-6 text-center text-gray-500">No approved companies yet.</div>
            <% } %>
        </section>

        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
            <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800 sm:px-6">
                <h2 class="text-lg font-bold text-slate-950 dark:text-white">Recent system users</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400">
                            <th class="py-3 px-6">Name</th>
                            <th class="py-3 px-6">Email</th>
                            <th class="py-3 px-6">Role</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm dark:divide-slate-800">
                        <% recentUsers.forEach(u=> { %>
                            <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                <td class="px-5 py-3 font-medium text-slate-900 dark:text-slate-100 sm:px-6">
                                    <%= u.name %>
                                </td>
                                <td class="px-5 py-3 text-slate-600 dark:text-slate-300 sm:px-6">
                                    <%= u.email %>
                                </td>
                                <td class="px-5 py-3 sm:px-6">
                                    <span
                                        class="px-2.5 py-1 rounded-full text-xs font-semibold 
                                        <%= u.role === 'admin' ? 'bg-violet-100 text-violet-700 dark:bg-violet-950 dark:text-violet-300' : (u.role === 'company' ? 'bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300') %>">
                                        <%= u.role %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <dialog id="rejectCompanyDialog" aria-labelledby="rejectCompanyTitle" class="w-[min(100%-2rem,32rem)] rounded-lg border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
            <form id="rejectCompanyForm" method="POST" class="p-6">
                <div class="flex items-start justify-between gap-4">
                    <div><h2 id="rejectCompanyTitle" class="text-lg font-bold">Reject company verification</h2><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Provide a reason for rejecting <span id="rejectCompanyName" class="font-semibold text-slate-700 dark:text-slate-200"></span>.</p></div>
                    <button type="submit" formmethod="dialog" aria-label="Close dialog" class="rounded-md p-1 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white"><i class="ph-bold ph-x text-lg" aria-hidden="true"></i></button>
                </div>
                <label for="rejectCompanyReason" class="mt-5 block text-sm font-semibold">Reason for rejection</label>
                <textarea id="rejectCompanyReason" name="reason" required maxlength="1000" rows="4" class="mt-2 block w-full resize-y rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white" placeholder="Explain why this verification is being rejected."></textarea>
                <div class="mt-6 flex justify-end gap-2">
                    <button type="submit" formmethod="dialog" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Cancel</button>
                    <button type="submit" class="rounded-lg bg-rose-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-rose-800">Confirm rejection</button>
                </div>
            </form>
        </dialog>
        <script>
            (function () {
                var dialog = document.getElementById('rejectCompanyDialog');
                var form = document.getElementById('rejectCompanyForm');
                var reason = document.getElementById('rejectCompanyReason');
                var companyName = document.getElementById('rejectCompanyName');
                if (!dialog || !form || !reason || !companyName) return;

                document.querySelectorAll('[data-reject-action]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        form.action = button.dataset.rejectAction;
                        companyName.textContent = button.dataset.companyName || 'this company';
                        reason.value = '';
                        dialog.showModal();
                        reason.focus();
                    });
                });

                dialog.addEventListener('click', function (event) {
                    if (event.target === dialog) dialog.close();
                });
            })();
        </script>

    </div>
